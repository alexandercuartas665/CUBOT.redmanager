<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CubotRedManager.Application\CubotRedManager.Application.csproj" />
    <ProjectReference Include="..\CubotRedManager.Domain\CubotRedManager.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DataProtection (IDataProtectionProvider) via shared framework, sin el paquete suelto vulnerable. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />
    <!-- Persistencia de llaves DataProtection en Postgres (tabla data_protection_keys).
         Requerido en Railway: el filesystem del contenedor es efimero. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <!-- Referencia explicita para forzar Relational 10.0.9 en el publish: DataProtection.EFCore
         10.0.9 lo exige, pero el provider de Npgsql lo arrastra a una version menor y un restore
         limpio (Railway) lo omitia -> FileNotFoundException en runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- JWT propio del login unificado (mismo paquete que travels). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
