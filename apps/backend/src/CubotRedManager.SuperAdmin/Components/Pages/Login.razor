@page "/login"
@layout CubotRedManager.SuperAdmin.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Redirigiendo al login - Super Admin</PageTitle>

<!-- Login unificado: el formulario real vive en el Web (:5036). El Super Admin (:5037) solo
     redirige al Web pasando el ReturnUrl, y la cookie compartida permite la sesion en ambos hosts. -->
<head>
    <meta http-equiv="refresh" content="0;url=@_redirectUrl" />
</head>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-title">CUBOT<span>.redmanager</span></div>
        <p class="login-sub">Redirigiendo al login unificado...</p>
        <p class="login-note">Si no te redirige automaticamente, <a href="@_redirectUrl">haz clic aqui</a>.</p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }

    private string _redirectUrl = "http://localhost:5036/login";

    protected override void OnInitialized()
    {
        // URLs configurables: en dev caen a localhost; en prod vienen de appsettings.Production
        // (Deployment:WebUrl = red.cubot.com.co, Deployment:SuperAdminUrl = admin.red.cubot.com.co).
        var webUrl = (Config["Deployment:WebUrl"] ?? "http://localhost:5036").TrimEnd('/');
        var selfUrl = (Config["Deployment:SuperAdminUrl"] ?? "http://localhost:5037").TrimEnd('/');
        var ret = string.IsNullOrWhiteSpace(ReturnUrl)
            ? $"{selfUrl}/"
            : ReturnUrl;
        _redirectUrl = $"{webUrl}/login?ReturnUrl={Uri.EscapeDataString(ret)}";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Nav.NavigateTo(_redirectUrl, forceLoad: true);
        }
    }
}
