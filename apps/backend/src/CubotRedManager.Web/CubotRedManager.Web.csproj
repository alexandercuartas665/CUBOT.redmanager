<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CubotRedManager.Application\CubotRedManager.Application.csproj" />
    <ProjectReference Include="..\CubotRedManager.Infrastructure\CubotRedManager.Infrastructure.csproj" />
    <ProjectReference Include="..\CubotRedManager.Shared\CubotRedManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT Bearer para el scheme SuperAdminJwt (Admin Agent API cross-tenant). El JWT en si lo
         emite Infrastructure.Auth.JwtTokenService (System.IdentityModel.Tokens.Jwt); este paquete
         solo aporta el handler ASP.NET Core que valida Authorization: Bearer y expone los claims. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
