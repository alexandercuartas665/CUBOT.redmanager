@* Version del build en curso. Sirve al operador para saber si el pod que ve es el ultimo
   deploy o una cache. En dev muestra "dev"; en Railway muestra el SHA corto del commit. *@
<div class="cubot-version" title="@CubotRedManager.Web.AppVersion.FullSha">
    v.@CubotRedManager.Web.AppVersion.Display
</div>

<style>
    .cubot-version {
        padding: 8px 14px;
        font-size: 10.5px;
        color: var(--muted-foreground);
        font-family: ui-monospace, Consolas, monospace;
        opacity: .55;
        text-align: center;
        letter-spacing: .04em;
    }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private int _inboxUnread = 0;
    private bool _isPlatformOperator;
    private bool _showTenant;
    private string? _userName;
    private string? _agencyName;
    private string _roleLabel = "Sin sesion";
    private string _avatar = "U";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        if (AuthState is null) { return; }

        var state = await AuthState;
        var user = state.User;
        _isPlatformOperator = user.FindFirst("platform_role") is not null;
        var isTenantUser = user.FindFirst("tenant_id") is not null;
        _showTenant = _isPlatformOperator || isTenantUser;

        _userName = user.Identity?.Name;
        _avatar = Initials(_userName);

        if (_isPlatformOperator)
        {
            _roleLabel = "Operador de plataforma";
        }
        else if (isTenantUser)
        {
            _roleLabel = user.FindFirst("tenant_role")?.Value ?? "Agencia";
            _agencyName = user.FindFirst("agency_name")?.Value;
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) { return "U"; }
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
