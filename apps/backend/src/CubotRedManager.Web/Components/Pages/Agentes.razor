    // ===== Export / Import JSON de agentes =====

    private bool _importOpen;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _importFile;
    private string? _importError;
    private string? _importOkMessage;

    private async Task ExportAgentAsync(AiAgentDto agent)
    {
        _busy = true;
        try
        {
            var result = await AgentsSvc.ExportAsync(agent.Id);
            if (result is null) { return; }
            var base64 = Convert.ToBase64String(result.JsonBytes);
            await JS.InvokeVoidAsync("cubotDownloadBase64", result.FileName, base64, "application/json");
        }
        finally { _busy = false; }
    }

    private void OpenImport()
    {
        _importOpen = true;
        _importFile = null;
        _importError = null;
        _importOkMessage = null;
    }

    private void CloseImport()
    {
        _importOpen = false;
        _importFile = null;
        _importError = null;
        _importOkMessage = null;
    }

    private void OnImportFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _importFile = e.File;
        _importError = null;
        _importOkMessage = null;
    }

    private async Task ImportAgentAsync()
    {
        if (_importFile is null) { return; }
        _importError = null;
        _importOkMessage = null;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            // Limite defensivo de 4 MB para el JSON de un agente (es texto).
            await using var stream = _importFile.OpenReadStream(4 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var res = await AgentsSvc.ImportAsync(memory.ToArray(), actor);
            if (!res.Ok)
            {
                _importError = res.Error ?? "No se pudo importar.";
                return;
            }
            _importOkMessage = "Agente importado. Revisalo y activa la produccion cuando estes listo.";
            await ReloadAsync();
        }
        catch (Exception ex) { _importError = ex.Message; }
        finally { _busy = false; }
    }
}
