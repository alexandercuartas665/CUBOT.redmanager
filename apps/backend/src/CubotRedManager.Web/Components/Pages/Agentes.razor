    // Lee un archivo subido desde el navegador y devuelve sus bytes + mime + nombre. NO escribe
    // a disco: el binario se persiste como bytea en ai_agent_resources.file_content. Motivo:
    // el filesystem del contenedor (Railway) es efimero y cualquier archivo escrito bajo
    // wwwroot/uploads se pierde al reciclar el pod.
    private static async Task<(byte[] Bytes, string MimeType, string Name)?> ReadUploadAsync(IBrowserFile file)
    {
        const long max = 25L * 1024 * 1024;
        if (file.Size <= 0 || file.Size > max) { return null; }
        using var ms = new MemoryStream();
        await file.OpenReadStream(max).CopyToAsync(ms);
        var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
        return (ms.ToArray(), mime, file.Name);
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

