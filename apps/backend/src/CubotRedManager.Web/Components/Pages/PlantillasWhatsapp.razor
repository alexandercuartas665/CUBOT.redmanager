@page "/plantillas-whatsapp"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@using CubotRedManager.Web.Components
@inject IWhatsAppTemplateService TemplatesSvc
@inject IWhatsAppLineService LinesSvc
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Plantillas HSM - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/></svg>
            </div>
            <span>Comunicacion e IA</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Plantillas HSM</h1>
        <p class="page-sub" style="margin-bottom:0;">Plantillas aprobadas por Meta que puedes enviar sin ventana de 24h. Se someten a traves de una linea YCloud.</p>
    </div>
    <div style="display:flex;gap:8px;">
        <button class="btn btn-outline-secondary" @onclick="SyncNow" disabled="@_syncing">@(_syncing ? "Sincronizando..." : "Sincronizar estados")</button>
        <button class="btn btn-primary" @onclick="() => OpenEditor(null)">Nueva plantilla</button>
    </div>
</div>

@if (_loading)
{
    <p class="text-muted">Cargando...</p>
}
else if (_templates.Count == 0)
{
    <div class="coming-soon">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/></svg>
        </div>
        <h3>Sin plantillas todavia</h3>
        <p>Crea una plantilla con variables amigables y sometela a revision de Meta.</p>
    </div>
}
else
{
    <div class="tpl-table-wrap">
        <table class="tpl-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Idioma</th>
                    <th>Categoria</th>
                    <th>Estado</th>
                    <th>Linea</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _templates)
                {
                    <tr>
                        <td><strong>@t.Name</strong></td>
                        <td>@t.Language</td>
                        <td>@t.Category</td>
                        <td><span class="tpl-status s-@t.Status.ToLowerInvariant()">@t.Status</span></td>
                        <td>@(_lines.FirstOrDefault(l => l.Id == t.WhatsAppLineId)?.InstanceName ?? "(sin linea)")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditor(t)">Editar</button>
                            @if (t.Status is "Draft" or "Rejected")
                            {
                                <button class="btn btn-sm btn-primary" @onclick="() => Submit(t.Id)" disabled="@_submitting">Someter</button>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(t.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!string.IsNullOrEmpty(_syncMsg))
    {
        <p style="font-size:12.5px;color:var(--muted-foreground);margin-top:12px;">@_syncMsg</p>
    }
}

@if (_editor is not null)
{
    <div class="modal-overlay" @onclick="CloseEditor">
        <div class="modal-dialog wide" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@(_editorIsNew ? "Nueva plantilla" : "Editar plantilla")</h3>
                <button class="modal-close" @onclick="CloseEditor">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row-2">
                    <div class="field">
                        <label class="form-label">Nombre tecnico</label>
                        <input class="form-control" @bind="_editor.Name" placeholder="ej. bienvenida_cliente" />
                        <small class="hint">Solo minusculas, digitos y guion_bajo.</small>
                    </div>
                    <div class="field">
                        <label class="form-label">Idioma</label>
                        <select class="form-select" @bind="_editor.Language">
                            <option value="es">Espanol (es)</option>
                            <option value="es_CO">Espanol Colombia (es_CO)</option>
                            <option value="es_MX">Espanol Mexico (es_MX)</option>
                            <option value="en">Ingles (en)</option>
                            <option value="en_US">Ingles US (en_US)</option>
                        </select>
                    </div>
                </div>
                <div class="row-2">
                    <div class="field">
                        <label class="form-label">Categoria</label>
                        <select class="form-select" @bind="_editor.Category">
                            <option value="UTILITY">UTILITY (notificaciones)</option>
                            <option value="MARKETING">MARKETING (promocional)</option>
                        </select>
                        <small class="hint">Las plantillas AUTHENTICATION (OTP) aun no estan soportadas.</small>
                    </div>
                    <div class="field">
                        <label class="form-label">Linea WhatsApp (para someter)</label>
                        <select class="form-select" @bind="_editor.WhatsAppLineId">
                            <option value="">(elige una linea)</option>
                            @foreach (var l in _lines.Where(x => x.Provider == WhatsAppProvider.YCloud))
                            {
                                <option value="@l.Id">@l.InstanceName (YCloud)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Header <small>(texto opcional)</small></label>
                    <input class="form-control" @bind="_editor.HeaderText" placeholder="ej. Recordatorio importante" />
                </div>

                <div class="field">
                    <label class="form-label">Cuerpo <span class="req">*</span></label>
                    <textarea class="form-control" rows="6" @bind="_editor.BodyText" placeholder="Hola {{contacto}}, gracias por escribir a {{marca}}. Un asesor te contactara pronto."></textarea>
                    <small class="hint">Usa <code>{{contacto}}</code>, <code>{{marca}}</code>, etc. Al someter se compilan a {{1}}, {{2}}.</small>
                    <div class="var-chips">
                        @foreach (var v in _catalog)
                        {
                            <button type="button" class="var-chip" @onclick="() => InsertVar(v.Token)">@v.Label</button>
                        }
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Footer <small>(opcional)</small></label>
                    <input class="form-control" @bind="_editor.FooterText" placeholder="ej. Responde STOP para no recibir mas mensajes" />
                </div>

                @if (!string.IsNullOrEmpty(_editorError))
                {
                    <p style="color:var(--destructive);font-size:.85rem;">@_editorError</p>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseEditor">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveEditor" disabled="@(string.IsNullOrWhiteSpace(_editor.Name) || string.IsNullOrWhiteSpace(_editor.BodyText))">Guardar borrador</button>
            </div>
        </div>
    </div>
}

<style>
    .tpl-table-wrap { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--card); }
    .tpl-table { width: 100%; border-collapse: collapse; }
    .tpl-table th, .tpl-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); text-align: left; font-size: 13.5px; vertical-align: middle; }
    .tpl-table th { background: var(--muted); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .tpl-table tr:last-child td { border-bottom: none; }
    .tpl-table td .btn { margin-right: 4px; }
    .tpl-status { font-size: 10.5px; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: var(--muted); color: var(--muted-foreground); text-transform: uppercase; letter-spacing: .03em; }
    .tpl-status.s-approved { background: oklch(0.62 0.16 155 / 0.15); color: var(--success); }
    .tpl-status.s-submitted { background: oklch(0.65 0.18 90 / 0.15); color: oklch(0.5 0.18 85); }
    .tpl-status.s-rejected { background: oklch(0.6 0.22 22 / 0.12); color: var(--destructive); }
    .modal-dialog.wide { max-width: 720px; }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .field { margin-bottom: 14px; }
    .hint { color: var(--muted-foreground); font-size: 11.5px; }
    .req { color: var(--destructive); }
    .var-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .var-chip { border: 1px solid var(--border); background: var(--muted); color: var(--foreground); font-size: 11.5px; padding: 3px 10px; border-radius: 999px; cursor: pointer; }
    .var-chip:hover { background: var(--primary); color: white; border-color: var(--primary); }
</style>

@code {
    private bool _loading = true;
    private bool _submitting;
    private bool _syncing;
    private string? _syncMsg;
    private Guid _actor;
    private IReadOnlyList<WhatsAppTemplateDto> _templates = [];
    private IReadOnlyList<WhatsAppLineDto> _lines = [];
    private IReadOnlyList<TemplateVariableDef> _catalog = [];

    private EditorState? _editor;
    private bool _editorIsNew;
    private string? _editorError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _actor);
        _catalog = TemplatesSvc.Catalog();
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _templates = await TemplatesSvc.ListAsync();
        _lines = await LinesSvc.ListAsync();
        _loading = false;
    }

    private void OpenEditor(WhatsAppTemplateDto? t)
    {
        _editorError = null;
        if (t is null)
        {
            _editor = new EditorState();
            _editorIsNew = true;
        }
        else
        {
            _editor = new EditorState
            {
                Id = t.Id,
                Name = t.Name,
                Language = t.Language,
                Category = t.Category,
                HeaderText = t.HeaderText ?? "",
                BodyText = t.BodyText,
                FooterText = t.FooterText ?? "",
                WhatsAppLineId = t.WhatsAppLineId?.ToString() ?? ""
            };
            _editorIsNew = false;
        }
    }

    private void CloseEditor()
    {
        _editor = null;
        _editorError = null;
    }

    private void InsertVar(string token)
    {
        if (_editor is null) { return; }
        _editor.BodyText = (_editor.BodyText ?? string.Empty) + "{{" + token + "}}";
    }

    private async Task SaveEditor()
    {
        if (_editor is null) { return; }
        _editorError = null;
        Guid? lineId = Guid.TryParse(_editor.WhatsAppLineId, out var lid) ? lid : null;
        var vars = Array.Empty<WhatsAppTemplateVariable>() as IReadOnlyList<WhatsAppTemplateVariable>;
        var req = new SaveWhatsAppTemplateRequest(
            _editor.Name, _editor.Language, _editor.Category,
            null, _editor.HeaderText.NullIfBlank(),
            _editor.BodyText, _editor.FooterText.NullIfBlank(),
            vars, lineId);

        WhatsAppTemplateDto? saved;
        if (_editorIsNew)
        {
            saved = await TemplatesSvc.CreateDraftAsync(req, _actor);
            if (saved is null) { _editorError = "Ya existe una plantilla con ese nombre + idioma."; return; }
        }
        else
        {
            saved = await TemplatesSvc.UpdateAsync(_editor.Id!.Value, req, _actor);
            if (saved is null) { _editorError = "No se pudo actualizar (duplicado o no existe)."; return; }
        }
        CloseEditor();
        await Reload();
    }

    private async Task Submit(Guid id)
    {
        _submitting = true;
        try
        {
            var res = await TemplatesSvc.SubmitAsync(id, _actor);
            if (!res.Ok) { _syncMsg = $"No se pudo someter: {res.Error}"; }
            else { _syncMsg = $"Plantilla sometida. Estado: {res.Status}"; }
            await Reload();
        }
        finally { _submitting = false; }
    }

    private async Task Delete(Guid id)
    {
        await TemplatesSvc.DeleteAsync(id, _actor);
        await Reload();
    }

    private async Task SyncNow()
    {
        _syncing = true;
        try
        {
            var n = await TemplatesSvc.SyncStatusAsync();
            _syncMsg = n == 0 ? "Sin cambios de estado en el proveedor." : $"Actualizadas {n} plantillas.";
            await Reload();
        }
        finally { _syncing = false; }
    }

    private sealed class EditorState
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = "";
        public string Language { get; set; } = "es";
        public string Category { get; set; } = "UTILITY";
        public string HeaderText { get; set; } = "";
        public string BodyText { get; set; } = "";
        public string FooterText { get; set; } = "";
        public string WhatsAppLineId { get; set; } = "";
    }
}
