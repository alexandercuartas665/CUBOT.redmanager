@page "/cuentas-sociales"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using System.Security.Claims
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@inject ISocialAccountService AccountsSvc
@inject IClientService ClientsSvc
@inject ITikTokConnectionService TikTokSvc
@inject CubotRedManager.Web.Auth.TikTokOAuthStateService OAuthState
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Cuentas sociales - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <span>Clientes y cuentas</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Cuentas sociales</h1>
        <p class="page-sub" style="margin-bottom:0;">Vista cruzada de todas las cuentas conectadas, estado y proximas expiraciones.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenConnect" disabled="@(_clients is null || _clients.Count == 0)">+ Conectar cuenta</button>
</div>

@if (!string.IsNullOrEmpty(_callbackError))
{
    <div class="cs-alert" style="background:oklch(0.9 0.1 25 / 0.15); color: var(--destructive); border-color: oklch(0.7 0.15 25 / 0.5);">
        No se completo la conexion con TikTok: @_callbackError
    </div>
}

@if (_accounts is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    @if (_withProblem > 0)
    {
        <div class="cs-alert cs-alert-danger">
            @_withProblem cuenta(s) marcadas <strong>Conectada</strong> pero cuyo ultimo refresh de token fallo. Aunque el sistema aun no las declara "expiradas", sincronizacion y publicacion pueden fallar. Reconectar para regenerar el token de forma segura.
        </div>
    }
    @if (_expiring > 0)
    {
        <div class="cs-alert">@_expiring cuenta(s) con token por expirar en menos de 7 dias. Reconectar para no interrumpir publicaciones.</div>
    }
    @if (_accounts.Count == 0)
    {
        <div class="coming-soon">
            <div class="coming-soon-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <h3>Sin cuentas conectadas</h3>
            <p>Conecta la primera cuenta social de un cliente. (OAuth oficial en Fase 2; aqui registro de demo.)</p>
        </div>
    }
    else
    {
        <div class="card" style="max-width:1100px;padding:6px 16px;">
            <table class="table table-hover" style="margin:0;">
                <thead><tr><th style="padding-left:14px;">Cliente</th><th>Red</th><th>Cuenta</th><th>Estado</th><th>Expira</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in _accounts)
                    {
                        <tr>
                            <td style="padding-left:14px;font-weight:600;">
                                <a href="/cuentas/@a.Id" style="color:inherit;text-decoration:none;">@a.ClientName</a>
                            </td>
                            <td><span class="cs-net" style="background:@(a.ColorHex)22;color:@a.ColorHex;">@a.NetworkDisplay</span></td>
                            <td>
                                <a href="/cuentas/@a.Id" style="color:inherit;text-decoration:none;">
                                    @(string.IsNullOrWhiteSpace(a.Handle) ? "—" : "@" + a.Handle)
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-@StatusColor(a.Status)">@StatusText(a.Status)</span>
                                @if (a.HasRefreshProblem)
                                {
                                    <span class="badge cs-badge-problem" title="@a.LastSyncError">Con problema (@a.RefreshFailureCount)</span>
                                }
                                @if (a.ExpiringSoon) { <span class="badge bg-warning">por expirar</span> }
                            </td>
                            <td style="font-size:12px;color:var(--muted-foreground);">@(a.ExpiresAt is { } e ? e.LocalDateTime.ToString("dd MMM yyyy") : "—")</td>
                            <td style="text-align:right;padding-right:14px;display:flex;gap:6px;justify-content:flex-end;">
                                <a class="btn btn-sm btn-outline-primary" href="/cuentas/@a.Id" title="Ver detalle">Abrir</a>
                                @if (a.Status == SocialAccountStatus.Connected)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeStatus(a, SocialAccountStatus.Disconnected)">Desconectar</button>
                                }
                                else
                                {
                                    @* Reconectar dispara el OAuth REAL en un modal inline (no deriva). *@
                                    <button class="btn btn-sm btn-primary" @onclick="() => GoReconnectAsync(a)">Reconectar</button>
                                }
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar cuenta (borrado en cascada)" @onclick="() => OpenDeleteConfirm(a)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_connectOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-head">
                <h3>Conectar cuenta social</h3>
                <button class="modal-close" @onclick="() => _connectOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-muted" style="font-size:13px;margin-bottom:14px;">
                    El nombre de la cuenta y los datos se obtienen automaticamente al completar el OAuth oficial.
                    Elige la red social y te llevamos al flujo de autorizacion correspondiente.
                </p>
                <div class="field">
                    <label class="form-label">Red social</label>
                    <select class="form-control" @bind="_cNetwork">
                        @foreach (var n in _networks!)
                        {
                            <option value="@n.Code">@n.DisplayName</option>
                        }
                    </select>
                </div>
                @if (_error is not null) { <div class="text-danger small">@_error</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _connectOpen = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="GoOAuthAsync">Continuar al OAuth</button>
            </div>
        </div>
    </div>
}

@* === Modal Reconectar (renovar OAuth de TikTok para una cuenta existente) === *@
@if (_reconnectAccount is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-head">
                <h3>Reconectar @(string.IsNullOrEmpty(_reconnectAccount.Handle) ? _reconnectAccount.ClientName : "@" + _reconnectAccount.Handle)</h3>
                <button class="modal-close" @onclick="CloseReconnect">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-muted" style="font-size:12.5px;margin-bottom:14px;">
                    Vamos a renovar el token OAuth de esta cuenta con TikTok. Esto sustituye el token actual por uno nuevo, sin perder configuracion ni datos sincronizados.
                </p>

                @if (_reconnectStep == 1)
                {
                    <ol style="font-size:13px;line-height:1.7;padding-left:18px;margin-bottom:14px;">
                        <li>Click en <strong>Autorizar en TikTok</strong>: te llevamos a TikTok.</li>
                        <li>Inicia sesion con la cuenta <strong>@_reconnectAccount.Handle</strong> y acepta los permisos.</li>
                        <li>TikTok te devolvera automaticamente al detalle de la cuenta con el token renovado. No tienes que copiar nada.</li>
                    </ol>
                    <button class="btn btn-primary" @onclick="ReconnectAuthorize" disabled="@_reconnectBusy">
                        @(_reconnectBusy ? "Abriendo..." : "Autorizar en TikTok")
                    </button>
                }

                @if (_reconnectError is not null)
                {
                    <div class="text-danger small" style="margin-top:12px;white-space:pre-wrap;">@_reconnectError</div>
                }
                @if (!string.IsNullOrEmpty(_reconnectTrace))
                {
                    <details style="margin-top:10px;font-size:11px;">
                        <summary style="cursor:pointer;color:var(--muted-foreground);">Traza tecnica</summary>
                        <pre style="background:#0f172a;color:#94a3b8;padding:10px;border-radius:6px;font-size:11px;overflow:auto;max-height:160px;">@_reconnectTrace</pre>
                    </details>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseReconnect">Cancelar</button>
            </div>
        </div>
    </div>
}

@* === Modal confirmacion Eliminar cuenta === *@
@if (_deleteAccount is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:520px;">
            <div class="modal-head">
                <h3>Eliminar cuenta @(string.IsNullOrEmpty(_deleteAccount.Handle) ? _deleteAccount.ClientName : "@" + _deleteAccount.Handle)?</h3>
                <button class="modal-close" @onclick="() => _deleteAccount = null">&times;</button>
            </div>
            <div class="modal-body">
                <p>Vas a borrar permanentemente la conexion de <strong>@(_deleteAccount.NetworkDisplay)</strong> del cliente <strong>@_deleteAccount.ClientName</strong>.</p>
                <p class="text-muted" style="font-size:12.5px;">
                    Esto borra en cascada (todo lo asociado a esta cuenta especifica):
                </p>
                <ul style="font-size:12.5px;color:var(--muted-foreground);">
                    <li>Configuracion de autorespuesta y plantillas</li>
                    <li>Logs del job de autorespuesta</li>
                    <li>Videos sincronizados y sus comentarios en la bandeja</li>
                    <li>Tokens (access y refresh)</li>
                </ul>
                <p class="text-muted" style="font-size:12px;">El cliente, el agente IA y los contenedores de datos del tenant <strong>no</strong> se ven afectados. Si la cuenta es solo de un OAuth roto, puedes reconectarla luego (creara una fila nueva).</p>
                @if (_deleteError is not null) { <div class="text-danger small">@_deleteError</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _deleteAccount = null">Cancelar</button>
                <button class="btn btn-danger" @onclick="DeleteAccountAsync" disabled="@_deleteBusy">@(_deleteBusy ? "Eliminando..." : "Si, eliminar cuenta")</button>
            </div>
        </div>
    </div>
}

<style>
    .cs-net { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 7px; }
    .cs-alert { max-width: 1100px; background: oklch(0.78 0.14 70 / 0.16); color: var(--gold-foreground); border: 1px solid oklch(0.78 0.14 70 / 0.4); border-radius: 10px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
    .cs-alert-danger { background: oklch(0.9 0.1 25 / 0.15); color: var(--destructive); border-color: oklch(0.7 0.15 25 / 0.5); }
    .cs-badge-problem { background: oklch(0.9 0.1 25 / 0.2); color: var(--destructive); border: 1px solid oklch(0.7 0.15 25 / 0.4); font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 999px; margin-left: 4px; cursor: help; }
    .field { margin-bottom: 14px; }
</style>

@code {
    private List<SocialAccountDto>? _accounts;
    private List<ClientDto>? _clients;
    private List<SocialNetworkDto>? _networks;
    private int _expiring;
    private int _withProblem;
    private bool _connectOpen;
    private string? _error;
    private string _cNetwork = "tiktok";
    private Guid _actor;
    private Guid _tenantId;
    private string? _callbackError;

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _actor);
        Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out _tenantId);
        _clients = (await ClientsSvc.ListAsync()).ToList();
        _networks = (await AccountsSvc.ListNetworksAsync()).ToList();

        // Volviendo del callback OAuth: mostramos toast si TikTok rebota. El caso exito redirige
        // al detalle /cuentas/{id}, asi que aqui solo capturamos el error.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("tkerr", out var err) && !string.IsNullOrWhiteSpace(err))
        {
            _callbackError = err.ToString();
        }

        await Reload();
    }

    private async Task Reload()
    {
        _accounts = (await AccountsSvc.ListAsync()).ToList();
        _expiring = _accounts.Count(a => a.ExpiringSoon);
        _withProblem = _accounts.Count(a => a.HasRefreshProblem);
    }

    private void OpenConnect()
    {
        _error = null;
        // Por defecto preseleccionamos TikTok si esta disponible (es la unica con OAuth real hoy).
        _cNetwork = _networks!.FirstOrDefault(n => n.Code == "tiktok")?.Code
                    ?? _networks!.FirstOrDefault()?.Code
                    ?? "tiktok";
        _connectOpen = true;
    }

    /// <summary>
    /// Deriva al flujo OAuth REAL de la red elegida. Solo TikTok lo tiene implementado por ahora;
    /// las otras redes (meta, youtube) muestran un aviso para evitar crear cuentas fantasma con
    /// handle inventado a mano.
    /// </summary>
    private Task GoOAuthAsync()
    {
        var net = (_cNetwork ?? "").ToLowerInvariant();
        if (net == "tiktok")
        {
            _connectOpen = false;
            Nav.NavigateTo("/tiktok/cuentas");
            return Task.CompletedTask;
        }
        var display = _networks!.FirstOrDefault(n => n.Code == _cNetwork)?.DisplayName ?? _cNetwork;
        _error = $"El OAuth oficial de {display} se integrara en una proxima fase. Por ahora solo TikTok esta disponible.";
        return Task.CompletedTask;
    }

    private async Task ChangeStatus(SocialAccountDto a, SocialAccountStatus status)
    {
        await AccountsSvc.ChangeStatusAsync(a.Id, status, _actor);
        await Reload();
    }

    // ===== Reconexion inline (Modulo 2.2 OAuth real, no stub) =====
    // El flujo es redirect firmado -> TikTok -> /oauth/tiktok/callback -> /cuentas/{id}. Aqui solo
    // se muestra el paso 1 (boton "Autorizar en TikTok"); el resultado llega en la nueva pagina.
    private SocialAccountDto? _reconnectAccount;
    private int _reconnectStep;
    private string? _reconnectError;
    // Reservado para mostrar traza tecnica del paso 1 si el usuario abre "Detalles" en el error.
    private string? _reconnectTrace;
    private bool _reconnectBusy;

    /// <summary>
    /// Reconectar = renovar el token OAuth de la cuenta existente. NO solo cambia Status: ejecuta
    /// el flujo real con TikTok y reemplaza access_token + refresh_token cifrados con las llaves
    /// actuales. Si TikTok rebota (app sin configurar, code expirado, etc.), mostramos el error
    /// inline con la traza tecnica.
    /// </summary>
    private Task GoReconnectAsync(SocialAccountDto a)
    {
        _reconnectError = null;
        _reconnectTrace = null;
        _reconnectStep = 1;
        _reconnectBusy = false;

        var net = (a.NetworkCode ?? string.Empty).ToLowerInvariant();
        if (net != "tiktok")
        {
            _error = $"Reconectar {a.NetworkDisplay} estara disponible cuando se integre su OAuth oficial (Modulo 2.2).";
            return Task.CompletedTask;
        }
        _reconnectAccount = a;
        return Task.CompletedTask;
    }

    private void CloseReconnect()
    {
        _reconnectAccount = null;
        _reconnectStep = 0;
        _reconnectError = null;
        _reconnectTrace = null;
    }

    private async Task ReconnectAuthorize()
    {
        if (_reconnectAccount is null) { return; }
        _reconnectBusy = true;
        _reconnectError = null;
        try
        {
            var cfg = await TikTokSvc.GetAppConfigAsync();
            if (cfg is null || !cfg.HasSecret)
            {
                _reconnectError = "La app de TikTok de la plataforma no esta configurada. Contacta al equipo de CUBOT.redmanager.";
                return;
            }
            if (_tenantId == Guid.Empty)
            {
                _reconnectError = "Sesion sin tenant activo. Vuelve a iniciar sesion.";
                return;
            }
            // Firmamos el state con (tenant, cliente, actor). TikTok lo devuelve tal cual al
            // callback y ahi decodificamos sin depender de cookies (por si el usuario autoriza
            // desde otro dispositivo).
            var signedState = OAuthState.Generate(_tenantId, _reconnectAccount.ClientId, _actor);
            var (url, _, err) = await TikTokSvc.BuildAuthorizeUrlAsync(signedState);
            if (err is not null || string.IsNullOrEmpty(url))
            {
                _reconnectError = err ?? "No se pudo construir la URL de autorizacion.";
                return;
            }
            // Redirigimos en la misma pestana. TikTok volvera a /oauth/tiktok/callback y ese
            // endpoint redirige al /cuentas/{id}?connected=1. El operador nunca pega codigos.
            Nav.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex) { _reconnectError = ex.Message; }
        finally { _reconnectBusy = false; }
    }

    // ===== Eliminar cuenta =====
    private SocialAccountDto? _deleteAccount;
    private bool _deleteBusy;
    private string? _deleteError;

    private void OpenDeleteConfirm(SocialAccountDto a)
    {
        _deleteError = null;
        _deleteAccount = a;
    }

    private async Task DeleteAccountAsync()
    {
        if (_deleteAccount is null) { return; }
        _deleteBusy = true;
        _deleteError = null;
        try
        {
            var ok = await AccountsSvc.DeleteAsync(_deleteAccount.Id, _actor);
            if (!ok) { _deleteError = "No se pudo eliminar (ya no existe?)."; return; }
            _deleteAccount = null;
            await Reload();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleteBusy = false; }
    }

    private static string StatusText(SocialAccountStatus s) => s switch
    {
        SocialAccountStatus.Connected => "Conectada",
        SocialAccountStatus.Expired => "Expirada",
        SocialAccountStatus.Revoked => "Revocada",
        _ => "Desconectada"
    };

    private static string StatusColor(SocialAccountStatus s) => s switch
    {
        SocialAccountStatus.Connected => "success",
        SocialAccountStatus.Expired or SocialAccountStatus.Revoked => "danger",
        _ => "secondary"
    };
}
