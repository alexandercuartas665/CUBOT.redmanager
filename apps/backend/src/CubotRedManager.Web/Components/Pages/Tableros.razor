@page "/tableros"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using System.Security.Claims
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@inject ITaskBoardService BoardsSvc
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Tableros de tareas - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            </div>
            <span>Operacion diaria</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Tableros de tareas</h1>
        <p class="page-sub" style="margin-bottom:0;">Kanban del equipo por cliente o campania. Organiza el trabajo del dia a dia.</p>
    </div>
    @if (_board is null)
    {
        <button class="btn btn-primary" @onclick="() => _newBoardOpen = true">+ Nuevo tablero</button>
    }
    else
    {
        <button class="btn btn-outline-secondary" @onclick="BackToList">&larr; Tableros</button>
    }
</div>

@if (_board is not null)
{
    <div class="kb-board-head">
        <h2 class="kb-board-name">@_board.Name</h2>
        <button class="btn btn-sm btn-primary" @onclick="() => OpenCard(_board.Columns.FirstOrDefault()?.Id)">+ Tarjeta</button>
    </div>
    <div class="kb-board">
        @foreach (var col in _board.Columns)
        {
            <div class="kb-col">
                <div class="kb-col-head" style="border-top:3px solid @col.ColorHex;">
                    <span class="kb-col-name">@col.Name</span>
                    <span class="kb-col-count">@col.Cards.Count</span>
                </div>
                <div class="kb-col-body">
                    @foreach (var card in col.Cards)
                    {
                        <div class="kb-card">
                            <div class="kb-card-top">
                                <span class="kb-prio p-@card.Priority.ToString().ToLowerInvariant()">@PrioLabel(card.Priority)</span>
                                @if (card.DueDate is { } d) { <span class="kb-due">@d.ToString("dd MMM")</span> }
                            </div>
                            <div class="kb-card-title">@card.Title</div>
                            @if (!string.IsNullOrWhiteSpace(card.DescriptionMd))
                            {
                                <div class="kb-card-desc">@card.DescriptionMd</div>
                            }
                            <div class="kb-card-move">
                                <select class="form-control-sm" @onchange="e => MoveCard(card.Id, e.Value?.ToString())">
                                    @foreach (var c in _board.Columns)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == col.Id)">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    <button class="kb-add" @onclick="() => OpenCard(col.Id)">+ Agregar</button>
                </div>
            </div>
        }
    </div>
}
else if (_boards is null)
{
    <p class="text-muted">Cargando...</p>
}
else if (_boards.Count == 0)
{
    <div class="coming-soon">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
        </div>
        <h3>Sin tableros todavia</h3>
        <p>Crea el primer tablero Kanban (viene con columnas Por Hacer / En Progreso / En Revision / Completado).</p>
    </div>
}
else
{
    <div class="kb-grid">
        @foreach (var b in _boards)
        {
            <button class="kb-board-card" @onclick="() => OpenBoard(b.Id)">
                <div class="kb-board-card-name">@b.Name</div>
                <div class="kb-board-card-desc">@(string.IsNullOrWhiteSpace(b.Description) ? "Sin descripcion" : b.Description)</div>
                <div class="kb-board-card-meta">@b.ColumnCount columnas &middot; @b.CardCount tarjetas</div>
            </button>
        }
    </div>
}

@if (_newBoardOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-head"><h3>Nuevo tablero</h3><button class="modal-close" @onclick="() => _newBoardOpen = false">&times;</button></div>
            <div class="modal-body">
                <div class="field"><label class="form-label">Nombre</label><input class="form-control" @bind="_nbName" placeholder="ej. Campania Black Friday" /></div>
                <div class="field"><label class="form-label">Descripcion</label><input class="form-control" @bind="_nbDesc" /></div>
                @if (_error is not null) { <div class="text-danger small">@_error</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _newBoardOpen = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="CreateBoard" disabled="@(_busy || string.IsNullOrWhiteSpace(_nbName))">Crear</button>
            </div>
        </div>
    </div>
}

@if (_cardOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-head"><h3>Nueva tarjeta</h3><button class="modal-close" @onclick="() => _cardOpen = false">&times;</button></div>
            <div class="modal-body">
                <div class="field"><label class="form-label">Titulo</label><input class="form-control" @bind="_ncTitle" /></div>
                <div class="field"><label class="form-label">Descripcion</label><textarea class="form-control" rows="2" @bind="_ncDesc"></textarea></div>
                <div class="field-row">
                    <div class="field"><label class="form-label">Columna</label>
                        <select class="form-control" @bind="_ncColumn">
                            @foreach (var c in _board!.Columns) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </div>
                    <div class="field"><label class="form-label">Prioridad</label>
                        <select class="form-control" @bind="_ncPriority">
                            @foreach (var p in Enum.GetValues<TaskPriority>()) { <option value="@p">@PrioLabel(p)</option> }
                        </select>
                    </div>
                </div>
                @if (_error is not null) { <div class="text-danger small">@_error</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _cardOpen = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="CreateCard" disabled="@(_busy || string.IsNullOrWhiteSpace(_ncTitle))">Crear</button>
            </div>
        </div>
    </div>
}

<style>
    .kb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; max-width: 1100px; }
    .kb-board-card { text-align: left; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; box-shadow: var(--shadow-soft); cursor: pointer; }
    .kb-board-card:hover { border-color: var(--primary); }
    .kb-board-card-name { font-weight: 700; font-size: 15px; }
    .kb-board-card-desc { font-size: 12.5px; color: var(--muted-foreground); margin-top: 3px; }
    .kb-board-card-meta { font-size: 11px; color: var(--muted-foreground); margin-top: 10px; }
    .kb-board-head { display: flex; align-items: center; justify-content: space-between; max-width: 1200px; margin-bottom: 14px; }
    .kb-board-name { font-size: 1.1rem; font-weight: 700; }
    .kb-board { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 12px; align-items: flex-start; }
    .kb-col { flex: 0 0 280px; background: var(--muted); border: 1px solid var(--border); border-radius: 1rem; display: flex; flex-direction: column; }
    .kb-col-head { display: flex; align-items: center; justify-content: space-between; padding: 11px 14px; border-bottom: 1px solid var(--border); border-radius: 1rem 1rem 0 0; background: var(--card); }
    .kb-col-name { font-weight: 700; font-size: 0.92rem; }
    .kb-col-count { font-size: 10px; font-weight: 700; padding: 1px 8px; border-radius: 999px; background: var(--primary-soft); color: var(--primary); }
    .kb-col-body { padding: 10px; display: flex; flex-direction: column; gap: 9px; min-height: 60px; }
    .kb-card { background: var(--card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 11px 12px; box-shadow: var(--shadow-soft); }
    .kb-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
    .kb-card-title { font-weight: 600; font-size: 0.9rem; }
    .kb-card-desc { font-size: 11.5px; color: var(--muted-foreground); margin-top: 4px; }
    .kb-card-move { margin-top: 8px; }
    .kb-due { font-size: 11px; color: var(--muted-foreground); }
    .kb-prio { font-size: 9.5px; font-weight: 700; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; }
    .kb-prio.p-low { background: var(--muted); color: var(--muted-foreground); }
    .kb-prio.p-normal { background: var(--primary-soft); color: var(--primary); }
    .kb-prio.p-high { background: oklch(0.78 0.14 70 / 0.18); color: var(--gold-foreground); }
    .kb-prio.p-urgent { background: oklch(0.6 0.22 22 / 0.12); color: var(--destructive); }
    .kb-add { border: 1px dashed var(--border); background: none; border-radius: 8px; padding: 7px; font-size: 12px; color: var(--muted-foreground); cursor: pointer; }
    .kb-add:hover { border-color: var(--primary); color: var(--primary); }
    .form-control-sm { width: 100%; border: 1px solid var(--border); border-radius: 7px; padding: 4px 8px; font-size: 12px; background: var(--card); }
    .field { margin-bottom: 14px; } .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
</style>

@code {
    private List<TaskBoardListItem>? _boards;
    private TaskBoardDetail? _board;
    private bool _newBoardOpen, _cardOpen, _busy;
    private string? _error;
    private string _nbName = "", _nbDesc = "";
    private string _ncTitle = "", _ncDesc = "", _ncColumn = "", _ncPriority = nameof(TaskPriority.Normal);
    private Guid _actor;

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _actor);
        await ReloadList();
    }

    private async Task ReloadList() => _boards = (await BoardsSvc.ListBoardsAsync()).ToList();

    private async Task OpenBoard(Guid id) => _board = await BoardsSvc.GetBoardAsync(id);
    private void BackToList() => _board = null;

    private async Task CreateBoard()
    {
        _error = null; _busy = true;
        try
        {
            var dto = await BoardsSvc.CreateBoardAsync(new CreateTaskBoardRequest(_nbName, _nbDesc), _actor);
            if (dto is null) { _error = "No hay agencia activa."; return; }
            _newBoardOpen = false; _nbName = ""; _nbDesc = "";
            await ReloadList();
            await OpenBoard(dto.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void OpenCard(Guid? columnId)
    {
        if (_board is null || columnId is null) { return; }
        _error = null; _ncTitle = ""; _ncDesc = ""; _ncColumn = columnId.Value.ToString(); _ncPriority = nameof(TaskPriority.Normal);
        _cardOpen = true;
    }

    private async Task CreateCard()
    {
        _error = null; _busy = true;
        try
        {
            if (!Guid.TryParse(_ncColumn, out var colId)) { return; }
            var prio = Enum.Parse<TaskPriority>(_ncPriority);
            await BoardsSvc.AddCardAsync(new CreateTaskCardRequest(_board!.Id, colId, _ncTitle, _ncDesc, prio), _actor);
            _cardOpen = false;
            await OpenBoard(_board!.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task MoveCard(Guid cardId, string? toColumn)
    {
        if (_board is null || !Guid.TryParse(toColumn, out var colId)) { return; }
        await BoardsSvc.MoveCardAsync(cardId, colId, _actor);
        await OpenBoard(_board.Id);
    }

    private static string PrioLabel(TaskPriority p) => p switch
    {
        TaskPriority.Low => "Baja", TaskPriority.High => "Alta", TaskPriority.Urgent => "Urgente", _ => "Normal"
    };
}
