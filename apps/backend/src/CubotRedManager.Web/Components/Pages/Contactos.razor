@page "/contactos"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using System.Globalization
@using System.Text.Json
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@using CubotRedManager.Web.Authorization
@inject IContactService ContactsSvc

<PageTitle>Contactos - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span>CRM</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Directorio de <span>contactos</span></h1>
        <p class="page-sub" style="margin-bottom:0;">Quien es cada cliente, que consume, cada cuanto compra y como prefiere que le hablen.</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn btn-outline-secondary" @onclick="OpenFieldsConfig">Campos del perfil</button>
        <button class="btn btn-primary" @onclick="OpenNewContact">+ Nuevo contacto</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_flash))
{
    <div class="alert @_flashClass" style="margin-top:10px;">@_flash</div>
}

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else
{
    <!-- Embudo de ciclo de vida: cuantos clientes hay en cada etapa (click = filtro) -->
    <div class="ct-stages">
        <button class="ct-stage @(_lifecycle is null ? "on" : "")" @onclick="() => SetLifecycle(null)">
            <span class="n">@_all.Count</span><span class="l">Todos</span>
        </button>
        @foreach (var st in ContactInsights.Stages)
        {
            var count = _all.Count(c => c.Lifecycle == st);
            <button class="ct-stage @(_lifecycle == st ? "on" : "")" @onclick="() => SetLifecycle(st)" title="@StageHint(st)">
                <span class="dot" style="background:@StageColor(st)"></span>
                <span class="n">@count</span><span class="l">@st</span>
            </button>
        }
    </div>

    <div class="ct-grid">
        <!-- LISTA -->
        <div class="card" style="padding:14px;">
            <input class="form-control form-control-sm" placeholder="Buscar por nombre, telefono o email..."
                   value="@_filter" @oninput="OnFilterInput" />
            <div style="display:flex;gap:8px;align-items:center;margin:10px 0;">
                <select class="form-control form-control-sm" value="@(_tag ?? "")" @onchange="OnTagFilter">
                    <option value="">Todas las etiquetas</option>
                    @foreach (var t in _allTags)
                    {
                        <option value="@t">#@t</option>
                    }
                </select>
                <label class="ct-check" title="Incluir archivados">
                    <input type="checkbox" checked="@_includeArchived" @onchange="OnToggleArchived" /> Archivados
                </label>
            </div>

            @if (Visible.Count == 0)
            {
                <p class="text-muted" style="padding:8px 2px;font-size:13px;">No hay contactos en esta vista.</p>
            }
            else
            {
                <div class="ct-list">
                    @foreach (var c in Visible)
                    {
                        <div class="ct-item @(_selectedId == c.Id ? "on" : "")" @onclick="() => SelectAsync(c.Id)">
                            <span class="ct-av">@Initials(c.Name)</span>
                            <div style="flex:1;min-width:0;">
                                <div class="ct-name">
                                    @c.Name
                                    @if (c.Archived) { <span class="badge bg-secondary" style="margin-left:6px;font-size:9px;">archivado</span> }
                                </div>
                                <div class="ct-sub">@(c.Phone + (string.IsNullOrWhiteSpace(c.City) ? "" : $" · {c.City}"))</div>
                                <div class="ct-chips">
                                    <span class="ct-life" style="--c:@StageColor(c.Lifecycle)">@c.Lifecycle</span>
                                    @foreach (var f in _fields.Where(f => f.ShowInList && !f.IsHidden))
                                    {
                                        var shown = DisplayValue(f, c.FieldValues.GetValueOrDefault(f.FieldKey));
                                        if (shown is not null)
                                        {
                                            <span class="ct-chip" title="@f.Label">@shown</span>
                                        }
                                    }
                                    @foreach (var t in c.Tags.Take(3))
                                    {
                                        <span class="ct-tag">#@t</span>
                                    }
                                </div>
                            </div>
                            @if (c.NextExpectedAt is DateTimeOffset nx)
                            {
                                <div style="text-align:right;flex-shrink:0;">
                                    <div class="ct-mini">Recompra</div>
                                    <div style="font-size:11.5px;font-weight:700;color:@NextColor(nx);">@nx.ToLocalTime().ToString("dd MMM")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- FICHA -->
        <div class="card" style="padding:22px;min-width:0;">
            @if (_detail is null)
            {
                <p class="text-muted" style="padding:24px 0;text-align:center;">Selecciona un contacto para ver su ficha.</p>
            }
            else
            {
                var ct = _detail.Contact;
                <div class="ct-head">
                    <span class="ct-av lg">@Initials(ct.Name)</span>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                            <span style="font-size:19px;font-weight:800;">@ct.Name</span>
                            <span class="ct-life" style="--c:@StageColor(ct.Lifecycle)" title="@StageHint(ct.Lifecycle)">@ct.Lifecycle</span>
                        </div>
                        <div class="text-muted" style="font-size:12.5px;">@SubLine(ct)</div>
                        @if (ct.Tags.Count > 0)
                        {
                            <div class="ct-chips" style="margin-top:6px;">
                                @foreach (var t in ct.Tags) { <span class="ct-tag">#@t</span> }
                            </div>
                        }
                    </div>
                    <div style="display:flex;gap:6px;flex-shrink:0;">
                        <a class="btn btn-sm btn-outline-success" href="@WhatsAppLink(ct.Phone)" target="_blank" rel="noopener" title="Abrir WhatsApp">WhatsApp</a>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="OpenEditContact">Editar</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleArchiveAsync">@(ct.Archived ? "Desarchivar" : "Archivar")</button>
                    </div>
                </div>

                <div class="ct-tabs">
                    <button class="@(_tab == "resumen" ? "on" : "")" @onclick='() => _tab = "resumen"'>Resumen</button>
                    <button class="@(_tab == "perfil" ? "on" : "")" @onclick='() => _tab = "perfil"'>Perfil @(_profileDirty ? "•" : "")</button>
                    <button class="@(_tab == "compras" ? "on" : "")" @onclick='() => _tab = "compras"'>Compras (@_detail.Orders.Count)</button>
                </div>

                @if (_tab == "resumen")
                {
                    <div class="ct-metrics">
                        <div class="m"><div class="k">Compras</div><div class="v">@ct.OrderCount</div></div>
                        <div class="m"><div class="k">Valor total</div><div class="v sm">@FormatMoney(ct.LifetimeValue, ct.LifetimeValueCurrency)</div></div>
                        <div class="m"><div class="k">Compra cada</div><div class="v sm">@(ct.CadenceDays is int cd ? $"{cd} dias" : "—")</div></div>
                        <div class="m"><div class="k">Proxima compra</div>
                            <div class="v sm" style="color:@(ct.NextExpectedAt is DateTimeOffset ne ? NextColor(ne) : "var(--muted-foreground)");">
                                @(ct.NextExpectedAt is DateTimeOffset nx2 ? nx2.ToLocalTime().ToString("dd MMM yyyy") : "—")
                            </div>
                        </div>
                    </div>

                    <div class="ct-insight">@Insight(ct)</div>

                    <h4 class="ct-h">Lo que consume</h4>
                    @if (_detail.Products.Count == 0)
                    {
                        <p class="text-muted" style="font-size:13px;">Aun no hay productos registrados. Registra compras con sus productos en la pestana Compras.</p>
                    }
                    else
                    {
                        <div class="ct-products">
                            @foreach (var p in _detail.Products)
                            {
                                <div class="ct-prod">
                                    <div class="nm">@p.Product</div>
                                    <div class="st">@p.TimesBought @(p.TimesBought == 1 ? "compra" : "compras") · @FormatQty(p.TotalQty) und</div>
                                    <div class="st">Ultima: @p.LastBoughtAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    @if (p.AvgDaysBetween is int ad)
                                    {
                                        <div class="st">Cada ~@ad dias</div>
                                    }
                                    @if (p.NextExpectedAt is DateTimeOffset pn)
                                    {
                                        <div class="st" style="font-weight:700;color:@NextColor(pn);">Recompra: @pn.ToLocalTime().ToString("dd MMM")</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <h4 class="ct-h">Datos clave para el mensaje</h4>
                    <div class="ct-facts">
                        @foreach (var key in KeyFacts)
                        {
                            var f = _fields.FirstOrDefault(x => x.FieldKey == key && !x.IsHidden);
                            if (f is null) { continue; }
                            var shown = DisplayValue(f, ct.FieldValues.GetValueOrDefault(key));
                            <div><span class="text-muted">@f.Label:</span> @(shown ?? "—")</div>
                        }
                        <div><span class="text-muted">Cumpleanos:</span> @(ct.BirthDate is DateOnly bd ? bd.ToString("dd MMM", new CultureInfo("es-CO")) : "—")</div>
                        <div><span class="text-muted">Cliente desde:</span> @(ct.FirstOrderAt is DateTimeOffset fo ? fo.ToLocalTime().ToString("dd MMM yyyy") : "—")</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ct.Notes))
                    {
                        <div class="ct-notes"><div class="ct-mini">Notas</div>@ct.Notes</div>
                    }
                }
                else if (_tab == "perfil")
                {
                    <div class="ct-sec">
                        <div class="ct-sec-t">Etiquetas</div>
                        <div class="ct-chips" style="margin-bottom:8px;">
                            @foreach (var t in _profileTags.ToList())
                            {
                                <span class="ct-tag removable">#@t <button @onclick="() => RemoveTag(t)">×</button></span>
                            }
                        </div>
                        <div style="display:flex;gap:6px;max-width:360px;">
                            <input class="form-control form-control-sm" list="ct-tag-list" placeholder="vip, cumple-diciembre, kit-familiar..."
                                   value="@_newTag" @oninput="e => _newTag = e.Value?.ToString() ?? string.Empty" @onkeydown="OnTagKey" />
                            <button class="btn btn-sm btn-outline-primary" @onclick="AddTag">Agregar</button>
                        </div>
                        <datalist id="ct-tag-list">@foreach (var t in _allTags) { <option value="@t"></option> }</datalist>
                    </div>

                    @foreach (var section in Sections)
                    {
                        <div class="ct-sec">
                            <div class="ct-sec-t">@section</div>
                            <div class="ct-form">
                                @foreach (var f in _fields.Where(x => x.Section == section && !x.IsHidden).OrderBy(x => x.SortOrder))
                                {
                                    var key = f.FieldKey;
                                    if (f.FieldType == ContactFieldType.Separator)
                                    {
                                        <div class="ct-sep">@f.Label</div>
                                        continue;
                                    }
                                    <div class="field" style="@(f.Column >= 2 ? "grid-column:1/-1;" : "")">
                                        <label class="form-label">@f.Label</label>
                                        @switch (f.FieldType)
                                        {
                                            case ContactFieldType.TextArea:
                                                <textarea class="form-control" rows="2" value="@Val(key)" @onchange="e => SetVal(key, e.Value?.ToString())"></textarea>
                                                break;
                                            case ContactFieldType.Select:
                                                <select class="form-control" value="@(Val(key) ?? "")" @onchange="e => SetVal(key, e.Value?.ToString())">
                                                    <option value=""></option>
                                                    @foreach (var opt in Opts(f)) { <option value="@opt">@opt</option> }
                                                </select>
                                                break;
                                            case ContactFieldType.MultiSelect:
                                                var picked = Multi(key);
                                                <div class="ct-pick">
                                                    @foreach (var opt in Opts(f))
                                                    {
                                                        var o = opt;
                                                        <button class="@(picked.Contains(o) ? "on" : "")" @onclick="() => ToggleMulti(key, o)">@o</button>
                                                    }
                                                </div>
                                                break;
                                            case ContactFieldType.Boolean:
                                                var b = Val(key);
                                                <div class="ct-pick">
                                                    <button class="@(b == "true" ? "on" : "")" @onclick='() => SetVal(key, b == "true" ? null : "true")'>Si</button>
                                                    <button class="@(b == "false" ? "on" : "")" @onclick='() => SetVal(key, b == "false" ? null : "false")'>No</button>
                                                </div>
                                                break;
                                            case ContactFieldType.Rating:
                                                var r = int.TryParse(Val(key), out var rv) ? rv : 0;
                                                <div class="ct-stars">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        var star = i;
                                                        <button class="@(star <= r ? "on" : "")" @onclick="() => SetVal(key, star == r ? null : star.ToString())">★</button>
                                                    }
                                                </div>
                                                break;
                                            case ContactFieldType.Date:
                                                <input class="form-control" type="date" value="@Val(key)" @onchange="e => SetVal(key, e.Value?.ToString())" />
                                                break;
                                            case ContactFieldType.Number:
                                            case ContactFieldType.Currency:
                                                <input class="form-control" type="number" step="any" value="@Val(key)" @onchange="e => SetVal(key, e.Value?.ToString())" />
                                                break;
                                            case ContactFieldType.Email:
                                                <input class="form-control" type="email" value="@Val(key)" @onchange="e => SetVal(key, e.Value?.ToString())" />
                                                break;
                                            case ContactFieldType.Phone:
                                                <input class="form-control" type="tel" value="@Val(key)" @onchange="e => SetVal(key, e.Value?.ToString())" />
                                                break;
                                            default:
                                                <input class="form-control" value="@Val(key)" @onchange="e => SetVal(key, e.Value?.ToString())" />
                                                break;
                                        }
                                        @if (!string.IsNullOrWhiteSpace(f.Description))
                                        {
                                            <div class="ct-help">@f.Description</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="ct-savebar">
                        <span class="text-muted" style="font-size:12px;">@(_profileDirty ? "Hay cambios sin guardar." : "Perfil al dia.")</span>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetProfile" disabled="@(!_profileDirty)">Descartar</button>
                        <button class="btn btn-primary btn-sm" @onclick="SaveProfileAsync" disabled="@(_busy || !_profileDirty)">Guardar perfil</button>
                    </div>
                }
                else if (_tab == "compras")
                {
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                        <h4 class="ct-h" style="margin:0;">Historial de compras</h4>
                        <button class="btn btn-sm btn-primary" @onclick="OpenNewOrder">+ Registrar compra</button>
                    </div>
                    @if (_detail.Orders.Count == 0)
                    {
                        <p class="text-muted" style="font-size:13px;">Sin compras registradas.</p>
                    }
                    else
                    {
                        <div style="display:flex;flex-direction:column;gap:8px;">
                            @foreach (var o in _detail.Orders)
                            {
                                <div class="ct-order">
                                    <div>
                                        <div style="font-weight:700;font-size:13px;">@o.OrderedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                        <div class="text-muted" style="font-size:10.5px;">@ChannelLabel(o.Channel)</div>
                                    </div>
                                    <div style="font-size:12.5px;min-width:0;">
                                        @FormatItems(o.ItemsJson)
                                        @if (!string.IsNullOrWhiteSpace(o.Notes)) { <div class="text-muted" style="font-size:11px;font-style:italic;">@o.Notes</div> }
                                    </div>
                                    <div style="font-weight:700;font-size:13.5px;white-space:nowrap;">@FormatMoney(o.TotalAmount, o.Currency)</div>
                                    <button class="btn btn-sm btn-outline-danger" style="padding:1px 8px;" @onclick="() => DeleteOrderAsync(o.Id)" title="Eliminar compra">×</button>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>
    </div>
}

<!-- MODAL: contacto -->
@if (_contactModal is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:520px;">
            <div class="modal-head">
                <h3>@(_contactModal.IsEdit ? "Editar contacto" : "Nuevo contacto")</h3>
                <button class="modal-close" @onclick="() => _contactModal = null">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field"><label class="form-label">Nombre *</label><input class="form-control" @bind="_contactModal.Name" /></div>
                <div class="field">
                    <label class="form-label">Telefono (formato internacional, sin +) *</label>
                    <input class="form-control" @bind="_contactModal.Phone" disabled="@_contactModal.IsEdit" placeholder="573001234567" />
                </div>
                <div class="ct-form">
                    <div class="field"><label class="form-label">Email</label><input class="form-control" type="email" @bind="_contactModal.Email" /></div>
                    <div class="field"><label class="form-label">Fecha de nacimiento</label><input class="form-control" type="date" @bind="_contactModal.BirthDate" /></div>
                    <div class="field"><label class="form-label">Pais</label><input class="form-control" @bind="_contactModal.Country" /></div>
                    <div class="field"><label class="form-label">Ciudad</label><input class="form-control" @bind="_contactModal.City" /></div>
                </div>
                <div class="field"><label class="form-label">Notas</label><textarea class="form-control" rows="3" @bind="_contactModal.Notes"></textarea></div>
                @if (!string.IsNullOrEmpty(_contactModal.Error)) { <div class="text-danger small">@_contactModal.Error</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _contactModal = null">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveContactAsync" disabled="@_busy">Guardar</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: compra -->
@if (_orderModal is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:600px;">
            <div class="modal-head">
                <h3>Registrar compra</h3>
                <button class="modal-close" @onclick="() => _orderModal = null">&times;</button>
            </div>
            <div class="modal-body">
                <div class="ct-form">
                    <div class="field"><label class="form-label">Fecha *</label><input class="form-control" type="date" @bind="_orderModal.OrderedAt" /></div>
                    <div class="field">
                        <label class="form-label">Canal</label>
                        <select class="form-control" @bind="_orderModal.Channel">
                            <option value="Manual">Registro manual</option>
                            <option value="LinkPago">Link de pago</option>
                            <option value="Fuxion">Tienda FUXION</option>
                            <option value="Other">Otro</option>
                        </select>
                    </div>
                </div>

                <label class="form-label">Productos</label>
                @foreach (var row in _orderModal.Items)
                {
                    var rr = row;
                    <div class="ct-itemrow">
                        <input class="form-control form-control-sm" list="ct-prod-list" placeholder="Producto (ej. OFF)" @bind="rr.Name" />
                        <input class="form-control form-control-sm" type="number" min="1" step="1" @bind="rr.Qty" title="Cantidad" />
                        <input class="form-control form-control-sm" type="number" step="any" placeholder="Precio unit." @bind="rr.UnitPrice" />
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _orderModal.Items.Remove(rr)" disabled="@(_orderModal.Items.Count == 1)">×</button>
                    </div>
                }
                <datalist id="ct-prod-list">@foreach (var p in KnownProducts) { <option value="@p"></option> }</datalist>
                <button class="btn btn-sm btn-link" style="padding-left:0;" @onclick="() => _orderModal.Items.Add(new ItemRow())">+ Otro producto</button>

                <div class="ct-form" style="margin-top:8px;">
                    <div class="field">
                        <label class="form-label">Total</label>
                        <input class="form-control" type="number" step="any" @bind="_orderModal.TotalAmount" placeholder="@(_orderModal.ItemsTotal is decimal it ? it.ToString("0.##", CultureInfo.InvariantCulture) : "")" />
                        <div class="ct-help">Si lo dejas vacio se usa la suma de los productos.</div>
                    </div>
                    <div class="field"><label class="form-label">Moneda</label><input class="form-control" @bind="_orderModal.Currency" maxlength="8" /></div>
                </div>
                <div class="field"><label class="form-label">Referencia (opcional)</label><input class="form-control" @bind="_orderModal.ExternalRef" placeholder="Numero de pedido FUXION, factura..." /></div>
                <div class="field"><label class="form-label">Notas</label><textarea class="form-control" rows="2" @bind="_orderModal.Notes"></textarea></div>
                @if (!string.IsNullOrEmpty(_orderModal.Error)) { <div class="text-danger small">@_orderModal.Error</div> }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _orderModal = null">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveOrderAsync" disabled="@_busy">Registrar</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: configuracion de campos -->
@if (_cfgOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:860px;">
            <div class="modal-head">
                <h3>Campos del perfil</h3>
                <button class="modal-close" @onclick="() => _cfgOpen = false">&times;</button>
            </div>
            <div class="modal-body" style="display:grid;grid-template-columns:1.2fr 1fr;gap:20px;max-height:72vh;overflow:auto;">
                <div>
                    @foreach (var section in AllSections)
                    {
                        <div class="ct-sec-t" style="margin-top:6px;">@section</div>
                        @foreach (var f in _fields.Where(x => x.Section == section).OrderBy(x => x.SortOrder))
                        {
                            var ff = f;
                            <div class="ct-cfg-row @(f.IsHidden ? "hidden" : "")">
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:600;font-size:13px;">@f.Label</div>
                                    <div class="text-muted" style="font-size:10.5px;">
                                        @TypeLabel(f.FieldType) · @f.FieldKey
                                        @if (f.ShowInList) { <span class="ct-tag" style="margin-left:4px;">tarjeta</span> }
                                        @if (f.IsHidden) { <span class="ct-tag" style="margin-left:4px;">oculto</span> }
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-link" @onclick="() => MoveFieldAsync(ff, -1)" title="Subir">↑</button>
                                <button class="btn btn-sm btn-link" @onclick="() => MoveFieldAsync(ff, 1)" title="Bajar">↓</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditField(ff)">Editar</button>
                            </div>
                        }
                    }
                </div>
                <div class="ct-cfg-form">
                    <div class="ct-sec-t">@(_fieldForm.Id is null ? "Nuevo campo" : "Editar campo")</div>
                    <div class="field"><label class="form-label">Nombre del campo *</label><input class="form-control" @bind="_fieldForm.Label" /></div>
                    <div class="field">
                        <label class="form-label">Seccion *</label>
                        <input class="form-control" list="ct-sec-list" @bind="_fieldForm.Section" />
                        <datalist id="ct-sec-list">@foreach (var s in AllSections) { <option value="@s"></option> }</datalist>
                    </div>
                    <div class="field">
                        <label class="form-label">Tipo</label>
                        <select class="form-control" @bind="_fieldForm.FieldType">
                            @foreach (var t in Enum.GetValues<ContactFieldType>()) { <option value="@t">@TypeLabel(t)</option> }
                        </select>
                    </div>
                    @if (_fieldForm.FieldType is ContactFieldType.Select or ContactFieldType.MultiSelect)
                    {
                        <div class="field"><label class="form-label">Opciones (una por linea)</label><textarea class="form-control" rows="4" @bind="_fieldForm.Options"></textarea></div>
                    }
                    <div class="field"><label class="form-label">Para que sirve</label><textarea class="form-control" rows="2" @bind="_fieldForm.Description" placeholder="Ayuda a quien llena la ficha y al agente IA."></textarea></div>
                    <div class="field">
                        <label class="form-label">Ancho</label>
                        <select class="form-control" @bind="_fieldForm.Column"><option value="1">Media columna</option><option value="2">Ancho completo</option></select>
                    </div>
                    <label class="ct-check"><input type="checkbox" @bind="_fieldForm.ShowInList" /> Mostrar en la tarjeta del directorio</label>
                    <label class="ct-check"><input type="checkbox" @bind="_fieldForm.IsHidden" /> Ocultar en la ficha</label>
                    @if (!string.IsNullOrEmpty(_fieldForm.Error)) { <div class="text-danger small">@_fieldForm.Error</div> }
                    <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
                        <button class="btn btn-primary btn-sm" @onclick="SaveFieldAsync" disabled="@_busy">Guardar campo</button>
                        @if (_fieldForm.Id is not null)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="NewFieldForm">Nuevo</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="DeleteFieldAsync">@(_fieldForm.IsSystem ? "Ocultar" : "Eliminar")</button>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _cfgOpen = false">Cerrar</button>
            </div>
        </div>
    </div>
}

<style>
    .ct-grid { display:grid; grid-template-columns:minmax(300px,400px) 1fr; gap:20px; align-items:start; margin-top:12px; }
    @@media (max-width: 900px) { .ct-grid { grid-template-columns:1fr; } }
    .ct-stages { display:flex; gap:6px; flex-wrap:wrap; margin-top:14px; }
    .ct-stage { display:flex; align-items:center; gap:6px; padding:7px 12px; border:1px solid var(--border); border-radius:999px; background:var(--card); cursor:pointer; font-size:12.5px; }
    .ct-stage.on { border-color:var(--primary); background:var(--primary-soft); }
    .ct-stage .dot { width:8px; height:8px; border-radius:50%; }
    .ct-stage .n { font-weight:800; }
    .ct-stage .l { color:var(--muted-foreground); }
    .ct-check { display:flex; align-items:center; gap:6px; font-size:12.5px; cursor:pointer; white-space:nowrap; margin:4px 0; }
    .ct-check input { accent-color:var(--primary); }
    .ct-list { display:flex; flex-direction:column; gap:4px; max-height:64vh; overflow-y:auto; }
    .ct-item { display:flex; align-items:center; gap:10px; padding:10px; border-radius:10px; cursor:pointer; }
    .ct-item:hover { background:var(--muted); }
    .ct-item.on { background:var(--primary-soft); }
    .ct-av { width:40px; height:40px; border-radius:50%; flex-shrink:0; display:grid; place-items:center; color:#fff; font-weight:800; font-size:13px; background:var(--gradient-violet); }
    .ct-av.lg { width:56px; height:56px; font-size:18px; }
    .ct-name { font-weight:700; font-size:13.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ct-sub { color:var(--muted-foreground); font-size:11px; }
    .ct-mini { color:var(--muted-foreground); font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; }
    .ct-chips { display:flex; flex-wrap:wrap; gap:4px; margin-top:4px; }
    .ct-life { font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px; color:var(--c); background:color-mix(in srgb, var(--c) 14%, transparent); }
    .ct-chip { font-size:10px; padding:2px 7px; border-radius:999px; background:var(--muted); color:var(--foreground); }
    .ct-tag { font-size:10px; padding:2px 7px; border-radius:999px; background:var(--primary-soft); color:var(--primary); font-weight:600; }
    .ct-tag.removable button { border:none; background:none; color:inherit; padding:0 0 0 3px; cursor:pointer; }
    .ct-head { display:flex; align-items:center; gap:14px; padding-bottom:14px; border-bottom:1px solid var(--border); flex-wrap:wrap; }
    .ct-tabs { display:flex; gap:4px; margin:14px 0 18px; border-bottom:1px solid var(--border); }
    .ct-tabs button { border:none; background:none; padding:8px 14px; font-weight:600; font-size:13px; color:var(--muted-foreground); border-bottom:2px solid transparent; cursor:pointer; }
    .ct-tabs button.on { color:var(--primary); border-bottom-color:var(--primary); }
    .ct-metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
    @@media (max-width: 700px) { .ct-metrics { grid-template-columns:repeat(2,1fr); } }
    .ct-metrics .m { padding:10px 12px; border:1px solid var(--border); border-radius:10px; }
    .ct-metrics .k { font-size:10.5px; font-weight:600; color:var(--muted-foreground); text-transform:uppercase; letter-spacing:.05em; }
    .ct-metrics .v { font-size:22px; font-weight:800; color:var(--primary); line-height:1.2; }
    .ct-metrics .v.sm { font-size:15px; }
    .ct-insight { margin:14px 0 4px; padding:10px 12px; border-left:3px solid var(--primary); background:var(--primary-soft); border-radius:6px; font-size:13px; }
    .ct-h { font-size:14px; font-weight:700; margin:20px 0 10px; }
    .ct-products { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:10px; }
    .ct-prod { padding:10px 12px; border:1px solid var(--border); border-radius:10px; }
    .ct-prod .nm { font-weight:800; font-size:14px; margin-bottom:4px; }
    .ct-prod .st { font-size:11.5px; color:var(--muted-foreground); }
    .ct-facts { display:grid; grid-template-columns:1fr 1fr; gap:6px 18px; font-size:13px; }
    .ct-notes { margin-top:16px; padding:12px; border:1px solid var(--border); border-radius:10px; background:var(--muted); font-size:13px; white-space:pre-wrap; }
    .ct-sec { margin-bottom:20px; }
    .ct-sec-t { font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:var(--primary); margin-bottom:10px; }
    .ct-form { display:grid; grid-template-columns:1fr 1fr; gap:4px 14px; }
    @@media (max-width: 700px) { .ct-form, .ct-facts { grid-template-columns:1fr; } }
    .ct-form .field, .modal-body .field { margin-bottom:12px; }
    .ct-sep { grid-column:1/-1; font-weight:700; font-size:12.5px; border-bottom:1px solid var(--border); padding-bottom:4px; margin:6px 0 10px; }
    .ct-help { font-size:11px; color:var(--muted-foreground); margin-top:3px; }
    .ct-pick { display:flex; flex-wrap:wrap; gap:6px; }
    .ct-pick button { border:1px solid var(--border); background:var(--card); border-radius:999px; padding:4px 11px; font-size:12px; cursor:pointer; }
    .ct-pick button.on { background:var(--primary); border-color:var(--primary); color:#fff; }
    .ct-stars button { border:none; background:none; font-size:22px; color:var(--border); cursor:pointer; padding:0 2px; }
    .ct-stars button.on { color:#f59e0b; }
    .ct-savebar { position:sticky; bottom:0; display:flex; gap:8px; justify-content:flex-end; align-items:center; padding:10px 0 0; background:var(--card); border-top:1px solid var(--border); }
    .ct-savebar span { margin-right:auto; }
    .ct-order { padding:12px; border:1px solid var(--border); border-radius:10px; display:grid; grid-template-columns:100px 1fr auto auto; gap:14px; align-items:center; }
    .ct-itemrow { display:grid; grid-template-columns:1fr 70px 120px auto; gap:6px; margin-bottom:6px; }
    .ct-cfg-row { display:flex; align-items:center; gap:4px; padding:7px 8px; border:1px solid var(--border); border-radius:8px; margin-bottom:5px; }
    .ct-cfg-row.hidden { opacity:.55; }
    .ct-cfg-form { border-left:1px solid var(--border); padding-left:18px; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Campos que mas pesan al redactar un mensaje: se muestran en el Resumen.
    private static readonly string[] KeyFacts = { "meta_principal", "canal_preferido", "horario_contacto", "sensibilidad_precio", "acepta_whatsapp", "potencial_red" };

    private bool _loading = true;
    private bool _busy;
    private string _filter = string.Empty;
    private string? _tag;
    private string? _lifecycle;
    private bool _includeArchived;
    private List<ContactDto> _all = new();
    private List<ContactFieldDto> _fields = new();
    private List<string> _allTags = new();
    private Guid? _selectedId;
    private ContactDetailDto? _detail;
    private string _tab = "resumen";
    private string? _flash;
    private string _flashClass = "alert-success";

    private Dictionary<string, string?> _profile = new();
    private List<string> _profileTags = new();
    private bool _profileDirty;
    private string _newTag = string.Empty;

    private ContactFormModel? _contactModal;
    private OrderFormModel? _orderModal;
    private bool _cfgOpen;
    private FieldFormModel _fieldForm = new();

    private List<ContactDto> Visible => _lifecycle is null ? _all : _all.Where(c => c.Lifecycle == _lifecycle).ToList();

    private IEnumerable<string> Sections => _fields.Where(f => !f.IsHidden).Select(f => f.Section).Distinct();
    private IEnumerable<string> AllSections => _fields.Select(f => f.Section).Distinct();

    private IEnumerable<string> KnownProducts => (_detail?.Products.Select(p => p.Product) ?? Enumerable.Empty<string>())
        .Concat(new[] { "OFF", "ON", "PRUNEX1", "FLORA LIV", "BIOPRO FIT", "NOCARB-T", "VITA XTRA T", "ALPHA BALANCE", "REXET", "GANOMAS CAPPUCCINO" })
        .Distinct(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _fields = (await ContactsSvc.ListFieldsAsync(true)).ToList();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = _all.Count == 0;
        try
        {
            _all = (await ContactsSvc.ListAsync(_filter, _includeArchived, 500, null, _tag)).ToList();
            _allTags = (await ContactsSvc.ListTagsAsync()).ToList();
            if (_selectedId is Guid id && _all.Any(c => c.Id == id)) { await LoadDetailAsync(id); }
            else if (_selectedId is not null) { _selectedId = null; _detail = null; }
        }
        finally { _loading = false; }
    }

    private async Task SelectAsync(Guid id)
    {
        if (_profileDirty && _selectedId != id) { Flash("Se descartaron cambios sin guardar del perfil anterior.", false); }
        _selectedId = id;
        await LoadDetailAsync(id);
    }

    private async Task LoadDetailAsync(Guid id)
    {
        _detail = await ContactsSvc.GetAsync(id);
        ResetProfile();
    }

    private async Task OnFilterInput(ChangeEventArgs e) { _filter = e.Value?.ToString() ?? string.Empty; await ReloadAsync(); }
    private async Task OnTagFilter(ChangeEventArgs e) { var v = e.Value?.ToString(); _tag = string.IsNullOrWhiteSpace(v) ? null : v; await ReloadAsync(); }
    private async Task OnToggleArchived(ChangeEventArgs e) { _includeArchived = (bool)e.Value!; await ReloadAsync(); }
    private void SetLifecycle(string? st) => _lifecycle = st;

    // ===== Perfil dinamico =====

    private void ResetProfile()
    {
        _profile = _detail is null ? new() : new Dictionary<string, string?>(_detail.Contact.FieldValues);
        _profileTags = _detail?.Contact.Tags.ToList() ?? new();
        _profileDirty = false;
    }

    private string? Val(string key) => _profile.GetValueOrDefault(key);

    private void SetVal(string key, string? value)
    {
        var v = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        if (Val(key) == v) { return; }
        _profile[key] = v;
        _profileDirty = true;
    }

    private static IEnumerable<string> Opts(ContactFieldDto f) =>
        (f.Options ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private List<string> Multi(string key) => ParseMulti(Val(key));

    private static List<string> ParseMulti(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return new(); }
        try { return JsonSerializer.Deserialize<List<string>>(raw) ?? new(); }
        catch (JsonException) { return raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(); }
    }

    private void ToggleMulti(string key, string option)
    {
        var list = Multi(key);
        if (!list.Remove(option)) { list.Add(option); }
        SetVal(key, list.Count == 0 ? null : JsonSerializer.Serialize(list));
    }

    private void AddTag()
    {
        var t = _newTag.Trim().ToLowerInvariant().Replace(",", " ");
        if (t.Length > 0 && !_profileTags.Contains(t)) { _profileTags.Add(t); _profileDirty = true; }
        _newTag = string.Empty;
    }

    private void OnTagKey(KeyboardEventArgs e) { if (e.Key == "Enter") { AddTag(); } }
    private void RemoveTag(string t) { if (_profileTags.Remove(t)) { _profileDirty = true; } }

    private async Task SaveProfileAsync()
    {
        if (_detail is null) { return; }
        _busy = true;
        try
        {
            // Mandamos todas las llaves conocidas: las vacias como null para que el servicio las borre.
            var payload = new Dictionary<string, string?>(_profile);
            foreach (var key in _detail.Contact.FieldValues.Keys) { payload.TryAdd(key, null); }
            var actor = await ActorAsync();
            await ContactsSvc.UpdateProfileAsync(_detail.Contact.Id, new UpdateContactProfileRequest(payload, _profileTags), actor);
            Flash("Perfil guardado.", true);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    // ===== Contacto =====

    private void OpenNewContact() => _contactModal = new ContactFormModel();

    private void OpenEditContact()
    {
        if (_detail is null) { return; }
        var c = _detail.Contact;
        _contactModal = new ContactFormModel
        {
            IsEdit = true, Id = c.Id, Name = c.Name, Phone = c.Phone, Email = c.Email,
            Country = c.Country, City = c.City, Notes = c.Notes,
            BirthDate = c.BirthDate?.ToDateTime(TimeOnly.MinValue)
        };
    }

    private async Task SaveContactAsync()
    {
        if (_contactModal is null) { return; }
        _contactModal.Error = null;
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var birth = _contactModal.BirthDate is DateTime dt ? DateOnly.FromDateTime(dt) : (DateOnly?)null;
            if (_contactModal.IsEdit && _contactModal.Id is Guid eid)
            {
                var updated = await ContactsSvc.UpdateAsync(eid, new UpdateContactRequest(
                    _contactModal.Name, _contactModal.Email ?? "", _contactModal.Country ?? "", _contactModal.City ?? "",
                    birth, _contactModal.Notes ?? "", null), actor);
                if (updated is null) { _contactModal.Error = "No se pudo actualizar."; return; }
                Flash("Contacto actualizado.", true);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_contactModal.Name) || string.IsNullOrWhiteSpace(_contactModal.Phone))
                {
                    _contactModal.Error = "Nombre y telefono son obligatorios.";
                    return;
                }
                var created = await ContactsSvc.CreateAsync(new CreateContactRequest(
                    _contactModal.Name, _contactModal.Phone, _contactModal.Email, _contactModal.Country,
                    _contactModal.City, birth, Notes: _contactModal.Notes), actor);
                if (created is null) { _contactModal.Error = "Ya existe un contacto con ese telefono."; return; }
                _selectedId = created.Id;
                _tab = "perfil";
                Flash("Contacto creado. Completa su perfil.", true);
            }
            _contactModal = null;
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleArchiveAsync()
    {
        if (_detail is null) { return; }
        var actor = await ActorAsync();
        var archived = !_detail.Contact.Archived;
        await ContactsSvc.UpdateAsync(_detail.Contact.Id, new UpdateContactRequest(Archived: archived), actor);
        Flash(archived ? "Contacto archivado." : "Contacto desarchivado.", true);
        await ReloadAsync();
    }

    // ===== Compras =====

    private void OpenNewOrder()
    {
        if (_detail is null) { return; }
        _orderModal = new OrderFormModel { Currency = _detail.Contact.LifetimeValueCurrency ?? "COP" };
    }

    private async Task SaveOrderAsync()
    {
        if (_orderModal is null || _detail is null) { return; }
        _orderModal.Error = null;
        var items = _orderModal.Items.Where(i => !string.IsNullOrWhiteSpace(i.Name)).ToList();
        if (items.Count == 0 && _orderModal.TotalAmount is null)
        {
            _orderModal.Error = "Agrega al menos un producto o el total de la compra.";
            return;
        }
        _busy = true;
        try
        {
            var itemsJson = items.Count == 0 ? null : JsonSerializer.Serialize(items.Select(i => new
            {
                name = i.Name!.Trim().ToUpperInvariant(),
                qty = i.Qty <= 0 ? 1 : i.Qty,
                unitPrice = i.UnitPrice
            }));
            var actor = await ActorAsync();
            var created = await ContactsSvc.AddOrderAsync(_detail.Contact.Id, new CreateContactOrderRequest(
                new DateTimeOffset(DateTime.SpecifyKind(_orderModal.OrderedAt.Date.AddHours(12), DateTimeKind.Utc)),
                _orderModal.TotalAmount ?? _orderModal.ItemsTotal,
                _orderModal.Currency, itemsJson, _orderModal.Channel, _orderModal.ExternalRef, _orderModal.Notes), actor);
            if (created is null) { _orderModal.Error = "No se pudo registrar la compra."; return; }
            Flash("Compra registrada.", true);
            _orderModal = null;
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteOrderAsync(Guid orderId)
    {
        if (_detail is null) { return; }
        var actor = await ActorAsync();
        var ok = await ContactsSvc.DeleteOrderAsync(_detail.Contact.Id, orderId, actor);
        Flash(ok ? "Compra eliminada." : "No se encontro la compra.", ok);
        await ReloadAsync();
    }

    // ===== Configuracion de campos =====

    private void OpenFieldsConfig()
    {
        _cfgOpen = true;
        NewFieldForm();
    }

    private void NewFieldForm() => _fieldForm = new FieldFormModel { Section = AllSections.FirstOrDefault() ?? "Perfil personal" };

    private void EditField(ContactFieldDto f) => _fieldForm = new FieldFormModel
    {
        Id = f.Id, Label = f.Label, Section = f.Section, FieldType = f.FieldType, Options = f.Options,
        Description = f.Description, Column = f.Column, ShowInList = f.ShowInList, ShowInFilter = f.ShowInFilter,
        IsHidden = f.IsHidden, IsSystem = f.IsSystem
    };

    private async Task SaveFieldAsync()
    {
        _fieldForm.Error = null;
        if (string.IsNullOrWhiteSpace(_fieldForm.Label) || string.IsNullOrWhiteSpace(_fieldForm.Section))
        {
            _fieldForm.Error = "Nombre y seccion son obligatorios.";
            return;
        }
        _busy = true;
        try
        {
            var actor = await ActorAsync();
            var req = new SaveContactFieldRequest(_fieldForm.Section, _fieldForm.Label, _fieldForm.FieldType, _fieldForm.Options,
                _fieldForm.Description, _fieldForm.Column, _fieldForm.ShowInList, _fieldForm.ShowInFilter, _fieldForm.IsHidden);
            var saved = _fieldForm.Id is Guid id
                ? await ContactsSvc.UpdateFieldAsync(id, req, actor)
                : await ContactsSvc.CreateFieldAsync(req, actor);
            if (saved is null) { _fieldForm.Error = "No se pudo guardar."; return; }
            _fields = (await ContactsSvc.ListFieldsAsync(true)).ToList();
            EditField(saved);
            Flash("Campo guardado.", true);
        }
        finally { _busy = false; }
    }

    private async Task DeleteFieldAsync()
    {
        if (_fieldForm.Id is not Guid id) { return; }
        var actor = await ActorAsync();
        await ContactsSvc.DeleteFieldAsync(id, actor);
        _fields = (await ContactsSvc.ListFieldsAsync(true)).ToList();
        NewFieldForm();
    }

    private async Task MoveFieldAsync(ContactFieldDto f, int dir)
    {
        var actor = await ActorAsync();
        if (await ContactsSvc.MoveFieldAsync(f.Id, dir, actor))
        {
            _fields = (await ContactsSvc.ListFieldsAsync(true)).ToList();
        }
    }

    // ===== Helpers =====

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var state = await AuthState;
        return Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private void Flash(string msg, bool success) { _flash = msg; _flashClass = success ? "alert-success" : "alert-warning"; }

    private static string Initials(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) { return "?"; }
        var parts = s.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) { return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant(); }
        return (parts[0][0].ToString() + parts[^1][0]).ToUpperInvariant();
    }

    private static string SubLine(ContactDto c)
    {
        var parts = new List<string> { c.Phone };
        if (!string.IsNullOrWhiteSpace(c.Email)) { parts.Add(c.Email!); }
        var place = string.Join(", ", new[] { c.City, c.Country }.Where(x => !string.IsNullOrWhiteSpace(x)));
        if (place.Length > 0) { parts.Add(place); }
        return string.Join(" · ", parts);
    }

    private static string WhatsAppLink(string phone) => "https://wa.me/" + new string(phone.Where(char.IsDigit).ToArray());

    private static string FormatMoney(decimal? amount, string? currency)
    {
        if (amount is not decimal a || a == 0) { return "—"; }
        return "$" + a.ToString("N0", new CultureInfo("es-CO")) + (string.IsNullOrWhiteSpace(currency) ? "" : $" {currency}");
    }

    private static string FormatQty(decimal q) => q.ToString("0.##", CultureInfo.InvariantCulture);

    private static string NextColor(DateTimeOffset nx)
    {
        var days = (nx - DateTimeOffset.UtcNow).TotalDays;
        if (days < 0) { return "#ef4444"; }
        if (days <= 7) { return "#f59e0b"; }
        return "#16a34a";
    }

    private static string StageColor(string stage) => stage switch
    {
        ContactInsights.Prospecto => "#64748b",
        ContactInsights.Nuevo => "#0ea5e9",
        ContactInsights.Activo => "#16a34a",
        ContactInsights.Fiel => "#8b5cf6",
        ContactInsights.EnRiesgo => "#f59e0b",
        ContactInsights.Dormido => "#ea580c",
        ContactInsights.Perdido => "#dc2626",
        _ => "#64748b"
    };

    private static string StageHint(string stage) => stage switch
    {
        ContactInsights.Prospecto => "Aun no compra. Objetivo: primera compra.",
        ContactInsights.Nuevo => "Una compra reciente. Objetivo: segunda compra (la mas dificil).",
        ContactInsights.Activo => "Recompra dentro de su ritmo.",
        ContactInsights.Fiel => "3 o mas compras y al dia. Candidato a referidos o a la red.",
        ContactInsights.EnRiesgo => "Paso su fecha habitual de recompra. Contactar ya.",
        ContactInsights.Dormido => "Duplico su tiempo normal sin comprar. Campana de reactivacion.",
        ContactInsights.Perdido => "Mas de 6 meses sin comprar.",
        _ => ""
    };

    // Recomendacion accionable segun etapa + perfil (piensa como el equipo comercial).
    private string Insight(ContactDto c)
    {
        var meta = c.FieldValues.GetValueOrDefault("meta_principal");
        var canal = c.FieldValues.GetValueOrDefault("canal_preferido") ?? "WhatsApp";
        var top = _detail?.Products.FirstOrDefault()?.Product;
        var gancho = !string.IsNullOrWhiteSpace(meta) ? $" Habla de su meta: {meta.ToLowerInvariant()}." : "";
        var sinConsent = c.FieldValues.GetValueOrDefault("acepta_whatsapp") != "true" && canal == "WhatsApp"
            ? " Antes de enviar recordatorios automaticos, registra su autorizacion de WhatsApp." : "";
        return c.Lifecycle switch
        {
            ContactInsights.Prospecto => $"Aun no compra. Ofrece un primer producto de entrada por {canal}.{gancho}{sinConsent}",
            ContactInsights.Nuevo => $"Primera compra hecha. Haz seguimiento a los 7-10 dias para saber como le va y asegurar la segunda compra{(top is null ? "" : $" de {top}")}.{gancho}{sinConsent}",
            ContactInsights.Activo => $"Va al dia. Prepara el recordatorio de recompra{(c.NextExpectedAt is DateTimeOffset n ? $" para el {n.ToLocalTime():dd MMM}" : "")} y sugiere un complemento.{gancho}{sinConsent}",
            ContactInsights.Fiel => $"Cliente fiel. Pidele un testimonio o un referido; si muestra interes, invitalo a la red (pipeline Negocios).{sinConsent}",
            ContactInsights.EnRiesgo => $"Ya paso su fecha habitual de recompra. Escribele hoy por {canal}{(top is null ? "" : $" sobre su {top}")}.{gancho}{sinConsent}",
            ContactInsights.Dormido => $"Lleva el doble de su tiempo normal sin comprar. Contacto personal: pregunta como esta antes de ofrecer.{sinConsent}",
            ContactInsights.Perdido => "Mas de 6 meses sin comprar. Incluyelo en una campana de reactivacion con un incentivo.",
            _ => ""
        };
    }

    private static string? DisplayValue(ContactFieldDto f, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) { return null; }
        return f.FieldType switch
        {
            ContactFieldType.MultiSelect => string.Join(", ", ParseMulti(raw)),
            ContactFieldType.Boolean => raw == "true" ? "Si" : "No",
            ContactFieldType.Rating => int.TryParse(raw, out var r) ? new string('★', Math.Clamp(r, 0, 5)) : raw,
            _ => raw
        };
    }

    private static string TypeLabel(ContactFieldType t) => t switch
    {
        ContactFieldType.Text => "Texto corto",
        ContactFieldType.TextArea => "Texto largo",
        ContactFieldType.Number => "Numero",
        ContactFieldType.Currency => "Dinero",
        ContactFieldType.Date => "Fecha",
        ContactFieldType.Phone => "Telefono",
        ContactFieldType.Email => "Email",
        ContactFieldType.Select => "Lista (una opcion)",
        ContactFieldType.MultiSelect => "Lista (varias opciones)",
        ContactFieldType.Boolean => "Si / No",
        ContactFieldType.Rating => "Calificacion (estrellas)",
        ContactFieldType.Separator => "Separador",
        _ => t.ToString()
    };

    private static string ChannelLabel(string ch) => ch switch
    {
        "Manual" => "Registro manual",
        "LinkPago" => "Link de pago",
        "Fuxion" => "Tienda FUXION",
        _ => ch
    };

    private static string FormatItems(string? itemsJson)
    {
        var items = ContactInsights.ParseItems(itemsJson).ToList();
        if (items.Count > 0) { return string.Join(", ", items.Select(i => i.Qty == 1 ? i.Name : $"{i.Name} x{i.Qty:0.##}")); }
        if (string.IsNullOrWhiteSpace(itemsJson)) { return "—"; }
        return itemsJson.Length <= 80 ? itemsJson : itemsJson[..80] + "...";
    }

    private sealed class ContactFormModel
    {
        public bool IsEdit;
        public Guid? Id;
        public string Name = string.Empty;
        public string Phone = string.Empty;
        public string? Email;
        public string? Country;
        public string? City;
        public DateTime? BirthDate;
        public string? Notes;
        public string? Error;
    }

    private sealed class ItemRow
    {
        public string? Name { get; set; }
        public int Qty { get; set; } = 1;
        public decimal? UnitPrice { get; set; }
    }

    private sealed class OrderFormModel
    {
        public DateTime OrderedAt { get; set; } = DateTime.Today;
        public decimal? TotalAmount { get; set; }
        public string? Currency { get; set; } = "COP";
        public string Channel { get; set; } = "Manual";
        public string? ExternalRef { get; set; }
        public string? Notes { get; set; }
        public string? Error { get; set; }
        public List<ItemRow> Items { get; } = new() { new ItemRow() };

        public decimal? ItemsTotal
        {
            get
            {
                var priced = Items.Where(i => !string.IsNullOrWhiteSpace(i.Name) && i.UnitPrice is not null).ToList();
                return priced.Count == 0 ? null : priced.Sum(i => i.UnitPrice!.Value * Math.Max(1, i.Qty));
            }
        }
    }

    private sealed class FieldFormModel
    {
        public Guid? Id { get; set; }
        public string Label { get; set; } = string.Empty;
        public string Section { get; set; } = string.Empty;
        public ContactFieldType FieldType { get; set; } = ContactFieldType.Text;
        public string? Options { get; set; }
        public string? Description { get; set; }
        public int Column { get; set; } = 1;
        public bool ShowInList { get; set; }
        public bool ShowInFilter { get; set; }
        public bool IsHidden { get; set; }
        public bool IsSystem { get; set; }
        public string? Error { get; set; }
    }
