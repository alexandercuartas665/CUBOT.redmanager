@page "/tiktok/autorespuesta-logs"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@inject IAutoReplyConfigService AutoReplySvc
@inject ISocialAccountService AccountsSvc

<PageTitle>Logs Autorespuesta - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg>
            </div>
            <span>TikTok Manager</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Autorespuesta — Logs del job</h1>
        <p class="page-sub" style="margin-bottom:0;">Cada ejecucion del worker queda registrada con duracion, comentarios procesados, respuestas enviadas y errores.</p>
    </div>
</div>

@if (_loading) { <p class="text-muted">Cargando...</p> }
else
{
<div class="lj-filters">
    <div class="field" style="margin:0;">
        <label class="form-label">Cuenta</label>
        <select class="form-control" @bind="_filterAccount" @bind:after="Reload">
            <option value="">Todas las cuentas</option>
            @foreach (var a in _accounts) { <option value="@a.Id">@(string.IsNullOrEmpty(a.Handle) ? a.ClientName : "@" + a.Handle) — @a.ClientName</option> }
        </select>
    </div>
    <div class="field" style="margin:0;">
        <label class="form-label">Estado</label>
        <select class="form-control" @bind="_filterStatus" @bind:after="Reload">
            <option value="">Todos</option>
            <option value="@AutoReplyJobStatus.Ok">Exitosos</option>
            <option value="@AutoReplyJobStatus.Warning">Con advertencias</option>
            <option value="@AutoReplyJobStatus.Error">Con errores</option>
        </select>
    </div>
</div>

@if (_logs.Count == 0)
{
    <div class="coming-soon" style="max-width:760px; margin-top:18px;">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg>
        </div>
        <h3>Aun no hay ejecuciones registradas</h3>
        <p>Activa la autorespuesta de una cuenta y espera a que el worker corra. Cada ejecucion queda aqui con su detalle.</p>
    </div>
}
else
{
<div class="card cx-card" style="margin-top:18px; padding:0;">
    <table class="table table-hover" style="margin:0;">
        <thead>
            <tr>
                <th style="padding-left:14px;">Cuenta</th>
                <th>Estado</th>
                <th>Inicio</th>
                <th>Duracion</th>
                <th>Procesados</th>
                <th>Enviados</th>
                <th>Errores</th>
                <th>Omitidos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in _logs)
            {
                <tr @onclick="() => OpenDetail(l.Id)" role="button">
                    <td style="padding-left:14px;font-weight:600;">@(string.IsNullOrEmpty(l.AccountHandle) ? l.ClientName : "@" + l.AccountHandle)</td>
                    <td><span class="lj-pill lj-@l.Status.ToString().ToLowerInvariant()">@StatusLabel(l.Status)</span></td>
                    <td style="font-size:12px;color:var(--muted-foreground);">@l.StartedAt.LocalDateTime.ToString("dd MMM HH:mm:ss")</td>
                    <td style="font-size:12px;color:var(--muted-foreground);">@((l.DurationMs / 1000.0).ToString("0.0"))s</td>
                    <td>@l.Processed</td>
                    <td style="color:#15803d; font-weight:700;">@l.Replied</td>
                    <td style="@(l.Errors > 0 ? "color:#b91c1c; font-weight:700;" : "color:#94a3b8;")">@l.Errors</td>
                    <td style="color:#94a3b8;">@l.Omitted</td>
                    <td style="text-align:right; padding-right:14px;">
                        <button class="btn btn-sm btn-outline-secondary">Ver detalle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}

@if (_detailOpen && _detail is not null)
{
<div class="modal-overlay" @onclick="() => _detailOpen = false">
    <div class="modal-dialog" style="max-width:760px;" @onclick:stopPropagation>
        <div class="modal-head">
            <h3>Detalle de ejecucion</h3>
            <button class="modal-close" @onclick="() => _detailOpen = false">&times;</button>
        </div>
        <div class="modal-body">
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:10px; margin-bottom:16px;">
                <div class="lj-kpi"><div class="lj-kpi-lbl">Cuenta</div><div class="lj-kpi-val" style="font-size:14px;">@(string.IsNullOrEmpty(_detail.Summary.AccountHandle) ? _detail.Summary.ClientName : "@" + _detail.Summary.AccountHandle)</div></div>
                <div class="lj-kpi"><div class="lj-kpi-lbl">Estado</div><div class="lj-kpi-val"><span class="lj-pill lj-@_detail.Summary.Status.ToString().ToLowerInvariant()">@StatusLabel(_detail.Summary.Status)</span></div></div>
                <div class="lj-kpi"><div class="lj-kpi-lbl">Duracion</div><div class="lj-kpi-val">@((_detail.Summary.DurationMs / 1000.0).ToString("0.0"))s</div></div>
                <div class="lj-kpi"><div class="lj-kpi-lbl">Procesados</div><div class="lj-kpi-val">@_detail.Summary.Processed</div></div>
                <div class="lj-kpi"><div class="lj-kpi-lbl">Enviados</div><div class="lj-kpi-val" style="color:#15803d;">@_detail.Summary.Replied</div></div>
                <div class="lj-kpi"><div class="lj-kpi-lbl">Errores</div><div class="lj-kpi-val" style="color:#b91c1c;">@_detail.Summary.Errors</div></div>
            </div>
            <h6 style="font-size:13px; font-weight:700; margin-bottom:8px;">Trace</h6>
            <pre class="lj-trace">@(string.IsNullOrEmpty(_detail.Trace) ? "(sin detalle)" : _detail.Trace)</pre>
        </div>
        <div class="modal-foot">
            <button class="btn btn-outline-secondary" @onclick="() => _detailOpen = false">Cerrar</button>
        </div>
    </div>
</div>
}
}

<style>
    .lj-filters { display:flex; gap:14px; flex-wrap:wrap; background:#fff; border:1px solid var(--border); border-radius:14px; padding:14px 18px; }
    .lj-filters .field { min-width:200px; flex:1; }
    .lj-pill { font-size:10px; font-weight:700; padding:3px 9px; border-radius:8px; text-transform:uppercase; letter-spacing:.04em; }
    .lj-ok { background:#dcfce7; color:#15803d; }
    .lj-warning { background:#fef3c7; color:#92400e; }
    .lj-error { background:#fee2e2; color:#b91c1c; }
    .lj-kpi { background:#f9fafb; border:1px solid var(--border); border-radius:10px; padding:10px 12px; }
    .lj-kpi-lbl { font-size:10px; color:#6b7280; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
    .lj-kpi-val { font-size:18px; font-weight:700; color:#1f2937; margin-top:2px; }
    .lj-trace { background:#0f172a; color:#cbd5e1; font-size:11.5px; padding:14px 16px; border-radius:10px; max-height:320px; overflow:auto; white-space:pre-wrap; line-height:1.5; margin:0; }
</style>

@code {
    private bool _loading = true;
    private List<AutoReplyJobLogDto> _logs = new();
    private List<SocialAccountDto> _accounts = new();
    private string _filterAccount = "", _filterStatus = "";
    private bool _detailOpen;
    private AutoReplyJobLogDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        _accounts = (await AccountsSvc.ListAsync()).Where(a => a.NetworkCode == "tiktok").ToList();
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        Guid? accId = Guid.TryParse(_filterAccount, out var gid) ? gid : null;
        AutoReplyJobStatus? st = Enum.TryParse<AutoReplyJobStatus>(_filterStatus, out var s) ? s : null;
        _logs = (await AutoReplySvc.ListLogsAsync(accId, st, 200)).ToList();
    }

    private async Task OpenDetail(Guid logId)
    {
        _detail = await AutoReplySvc.GetLogDetailAsync(logId);
        _detailOpen = _detail is not null;
    }

    private static string StatusLabel(AutoReplyJobStatus s) => s switch
    {
        AutoReplyJobStatus.Ok => "OK",
        AutoReplyJobStatus.Warning => "Advertencia",
        _ => "Error"
    };
}
