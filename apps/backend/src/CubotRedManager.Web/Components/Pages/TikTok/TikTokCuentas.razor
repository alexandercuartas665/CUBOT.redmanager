@code {
    private bool _loading = true, _busy, _modalOpen;
    private int _step = 1;
    private Guid _actor;
    private List<ClientDto> _clients = new();
    private List<SocialAccountDto> _accounts = new();
    private string _clientId = "", _selectedNet = "tiktok", _authCode = "", _trace = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _actor);
        _clients = (await ClientsSvc.ListAsync()).ToList();
        await Reload();
        _loading = false;
    }

    private async Task Reload() =>
        _accounts = (await AccountsSvc.ListAsync()).Where(a => a.NetworkCode == "tiktok").ToList();

    private void OpenConnect()
    {
        _error = null; _step = 1; _clientId = ""; _authCode = ""; _trace = ""; _modalOpen = true;
    }

    private void CloseModal() { _modalOpen = false; }

    private async Task GoAuthorize()
    {
        _busy = true; _error = null;
        try
        {
            var cfg = await TikTokSvc.GetAppConfigAsync();
            if (cfg is null || !cfg.HasSecret)
            {
                _error = "Falta configurar la app de TikTok. Pide al admin que lo haga en Conexiones.";
                return;
            }
            var (url, _, err) = await TikTokSvc.BuildAuthorizeUrlAsync();
            if (err is not null) { _error = err; return; }
            await JS.InvokeVoidAsync("open", url, "_blank");
            _step = 2;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ExchangeCode()
    {
        _busy = true; _error = null;
        try
        {
            if (!Guid.TryParse(_clientId, out var clientId)) { _error = "Cliente invalido."; return; }
            var r = await TikTokSvc.ExchangeCodeAsync(clientId, _authCode, _actor);
            _trace = r.Trace;
            if (!r.Success) { _error = r.Error; return; }
            await Reload();
            _step = 3;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Refresh(Guid id)
    {
        await TikTokSvc.RefreshAccountAsync(id, _actor);
        await Reload();
    }

    private async Task RefreshProfile(Guid id)
    {
        var r = await TikTokSvc.RefreshProfileAsync(id, _actor);
        if (!r.Success)
        {
            await JS.InvokeVoidAsync("alert", "No se pudo traer el perfil: " + (r.Error ?? "error desconocido"));
        }
        await Reload();
    }

    private async Task Delete(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Eliminar esta cuenta? Se perderan sus tokens.")) { return; }
        await AccountsSvc.DeleteAsync(id, _actor);
        await Reload();
    }

    private static string FormatFollowers(long? n)
    {
        if (n is null) { return "—"; }
        if (n >= 1_000_000) { return (n.Value / 1_000_000.0).ToString("0.#") + "M"; }
        if (n >= 1_000) { return (n.Value / 1_000.0).ToString("0.#") + "K"; }
        return n.Value.ToString();
    }

    // ===== Modal Autorespuesta (Modulo 2.11) =====
    private sealed class TemplateRow { public Guid? Id; public string Keywords = ""; public string Body = ""; public int SortOrder; }
    private bool _arOpen, _arBusy;
    private string _arTab = "general";
    private SocialAccountDto? _arAccount;
    private AutoReplyConfigDto? _arCfg;
    private bool _arIsActive;
    private AutoReplyMode _arMode = AutoReplyMode.Mixed;
    private int _arMaxReplies = 20, _arDelayMin = 3, _arDelayMax = 10;
    private string _arBlacklist = "", _arCronCustom = "*/30 * * * *", _arDefaultTpl = "";
    private AutoReplyFrequency _arFrequency = AutoReplyFrequency.Every30m;
    private int _arHoursMask = 0x1FFF00;
    private byte _arDaysMask = 0x7F;
    private readonly List<TemplateRow> _arTemplates = new();
    private string _arAgentId = "";
    private List<AutoReplyAgentOptionDto> _arAgentOptions = new();
    private string? _arError;

    private async Task OpenAutoReply(SocialAccountDto a)
    {
        _arAccount = a;
        _arBusy = true; _arError = null; _arTab = "general";
        try
        {
            _arCfg = await AutoReplySvc.GetOrDefaultAsync(a.Id);
            _arIsActive = _arCfg.IsActive;
            _arMode = _arCfg.Mode;
            _arMaxReplies = _arCfg.MaxRepliesPerRun;
            _arDelayMin = _arCfg.DelayMinSeconds;
            _arDelayMax = _arCfg.DelayMaxSeconds;
            _arBlacklist = _arCfg.BlacklistKeywords ?? "";
            _arFrequency = _arCfg.Frequency;
            _arCronCustom = _arCfg.CronCustom ?? "*/30 * * * *";
            _arHoursMask = _arCfg.ActiveHoursMask;
            _arDaysMask = _arCfg.ActiveDaysOfWeekMask;
            _arDefaultTpl = _arCfg.DefaultTemplate ?? "";
            _arAgentId = _arCfg.AiAgentId?.ToString() ?? "";
            _arAgentOptions = (await AutoReplySvc.ListAgentOptionsAsync()).ToList();
            _arTemplates.Clear();
            foreach (var t in _arCfg.Templates) { _arTemplates.Add(new TemplateRow { Id = t.Id, Keywords = t.Keywords, Body = t.Body, SortOrder = t.SortOrder }); }
            _arOpen = true;
        }
        finally { _arBusy = false; }
    }

    private void CloseAutoReply() { _arOpen = false; _arAccount = null; _arCfg = null; _arTemplates.Clear(); }

    private void AddTemplate() => _arTemplates.Add(new TemplateRow { SortOrder = _arTemplates.Count });
    private void RemoveTemplate(int i) { if (i >= 0 && i < _arTemplates.Count) { _arTemplates.RemoveAt(i); } }
    private void ToggleHour(int h) { _arHoursMask ^= (1 << h); }
    private void SetHourRange(int from, int to)
    {
        _arHoursMask = 0;
        if (to <= from) { return; }
        for (var h = from; h < to && h < 24; h++) { _arHoursMask |= (1 << h); }
    }
    private void ToggleDay(int d) { _arDaysMask = (byte)(_arDaysMask ^ (byte)(1 << d)); }
    private void OnFrequencyChanged()
    {
        _arCronCustom = _arFrequency switch
        {
            AutoReplyFrequency.Every15m => "*/15 * * * *",
            AutoReplyFrequency.Every30m => "*/30 * * * *",
            AutoReplyFrequency.Every1h => "0 * * * *",
            AutoReplyFrequency.Every2h => "0 */2 * * *",
            AutoReplyFrequency.Every4h => "0 */4 * * *",
            AutoReplyFrequency.Daily => "0 8 * * *",
            _ => _arCronCustom
        };
    }

    private async Task SaveAutoReplyAsync()
    {
        if (_arAccount is null) { return; }
        _arBusy = true; _arError = null;
        try
        {
            var tpls = _arTemplates.Select((t, i) => new AutoReplyTemplateInput(t.Id, t.Keywords, t.Body, i)).ToList();
            Guid? agentId = Guid.TryParse(_arAgentId, out var gid) ? gid : null;
            var req = new SaveAutoReplyConfigRequest(
                _arAccount.Id, _arIsActive, _arMode, _arMaxReplies, _arDelayMin, _arDelayMax,
                _arBlacklist, _arFrequency, _arCronCustom, _arHoursMask, _arDaysMask, _arDefaultTpl, agentId, tpls);
            var dto = await AutoReplySvc.SaveAsync(req, _actor);
            if (dto is null) { _arError = "No se pudo guardar."; return; }
            CloseAutoReply();
        }
        catch (Exception ex) { _arError = ex.Message; }
        finally { _arBusy = false; }
    }
}
