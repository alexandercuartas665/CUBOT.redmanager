@page "/tiktok/cuentas"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using System.Security.Claims
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@inject ISocialAccountService AccountsSvc
@inject ITikTokConnectionService TikTokSvc
@inject IClientService ClientsSvc
@inject IAutoReplyConfigService AutoReplySvc
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Cuentas TikTok - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </div>
            <span>TikTok Manager</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Gestion de Cuentas</h1>
        <p class="page-sub" style="margin-bottom:0;">Conecta cuentas TikTok de tus clientes via OAuth oficial. La configuracion tecnica de la app esta en <a href="/conexiones">Conexiones</a>.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenConnect" disabled="@(_clients.Count == 0)">+ Conectar Cuenta</button>
</div>

@if (_loading) { <p class="text-muted">Cargando...</p> }
else
{
    @if (_accounts.Count == 0)
    {
        <div class="coming-soon" style="max-width:760px;">
            <div class="coming-soon-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </div>
            <h3>Sin cuentas TikTok conectadas</h3>
            <p>Pulsa "Conectar Cuenta" para autorizar la primera cuenta TikTok de uno de tus clientes.</p>
        </div>
    }
    else
    {
        <div class="tk-cards-grid">
            @foreach (var a in _accounts)
            {
                <div class="tk-card">
                    <div class="tk-card-net">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                    </div>
                    <div class="tk-card-head">
                        <div class="tk-card-avatar">@(string.IsNullOrWhiteSpace(a.Handle) ? "?" : a.Handle![..1].ToUpperInvariant())</div>
                        <div style="flex:1; min-width:0;">
                            <div class="tk-card-name">@(a.DisplayName ?? a.ClientName)</div>
                            <div class="tk-card-handle">@(string.IsNullOrWhiteSpace(a.Handle) ? a.ClientName : "@" + a.Handle)</div>
                        </div>
                        <button class="tk-card-del" title="Eliminar" @onclick="() => Delete(a.Id)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="m19 6-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                        </button>
                    </div>
                    <div class="tk-card-foot">
                        <div>
                            <div class="tk-card-lbl">Seguidores</div>
                            <div class="tk-card-val">@FormatFollowers(a.FollowersCount)</div>
                        </div>
                        <div class="tk-card-status">
                            <span class="tk-dot tk-dot-@(a.Status == SocialAccountStatus.Connected ? "ok" : "off")"></span>
                            @(a.Status == SocialAccountStatus.Connected ? "Conectada" : a.Status == SocialAccountStatus.Expired ? "Token expirado" : "Desconectada")
                        </div>
                    </div>
                    <div style="display:flex; gap:6px; margin-top:10px; flex-wrap:wrap;">
                        <button class="btn btn-sm btn-primary" style="flex:1; min-width:140px;" @onclick="() => OpenAutoReply(a)">⚙ Autorespuesta</button>
                        @if (a.ExpiringSoon)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Refresh(a.Id)">Renovar token</button>
                        }
                        @if (string.IsNullOrWhiteSpace(a.Handle))
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => RefreshProfile(a.Id)">↻ Perfil</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@* Modal Conectar — estilo prototipo *@
@if (_modalOpen)
{
<div class="tk-modal-bd" @onclick="CloseModal">
    <div class="tk-modal" @onclick:stopPropagation>
        <div class="tk-modal-head">
            <h3>Conectar Nueva Cuenta</h3>
            <button class="tk-modal-close" @onclick="CloseModal">&times;</button>
        </div>
        <div class="tk-modal-body">
            @if (_step == 1)
            {
                <p class="tk-modal-help">Selecciona el cliente (marca) y la red social.</p>
                <div class="field">
                    <label class="form-label">Cliente (marca)</label>
                    <select class="form-control" @bind="_clientId">
                        <option value="">Selecciona...</option>
                        @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="tk-net-grid">
                    <button class="tk-net-btn @(_selectedNet == "tiktok" ? "tk-net-sel-tk" : "")" @onclick='() => _selectedNet = "tiktok"'>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                        <span>TikTok</span>
                    </button>
                    <button class="tk-net-btn @(_selectedNet == "meta_instagram" ? "tk-net-sel-ig" : "")" disabled title="Proximamente">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                        <span>Instagram</span>
                    </button>
                    <button class="tk-net-btn @(_selectedNet == "youtube" ? "tk-net-sel-yt" : "")" disabled title="Proximamente">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
                        <span>YouTube</span>
                    </button>
                </div>
                <button class="btn btn-primary tk-modal-cta" @onclick="GoAuthorize" disabled="@(_busy || string.IsNullOrWhiteSpace(_clientId))">Autorizar conexion</button>
                @if (_error is not null) { <div class="text-danger small" style="margin-top:8px;">@_error</div> }
            }
            else if (_step == 2)
            {
                <p class="tk-modal-help">Se abrio TikTok en una pestana nueva. Autoriza y pega aqui el codigo <code>code</code> de la URL de retorno.</p>
                <div class="field">
                    <label class="form-label">Auth Code</label>
                    <input class="form-control" @bind="_authCode" placeholder="Pega el code de la URL de retorno" />
                </div>
                <div style="display:flex; gap:8px; justify-content:flex-end;">
                    <button class="btn btn-outline-secondary" @onclick="() => _step = 1" disabled="@_busy">Atras</button>
                    <button class="btn btn-primary" @onclick="ExchangeCode" disabled="@(_busy || string.IsNullOrWhiteSpace(_authCode))">@(_busy ? "Canjeando..." : "Confirmar conexion")</button>
                </div>
                @if (_error is not null) { <div class="text-danger small" style="margin-top:8px;">@_error</div> }
                @if (!string.IsNullOrEmpty(_trace)) { <pre class="tk-trace">@_trace</pre> }
            }
            else if (_step == 3)
            {
                <div class="tk-success">
                    <div class="tk-success-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <h4>Cuenta conectada</h4>
                    <p>La cuenta de TikTok ya esta operativa. Puedes ver sus comentarios en el <a href="/tiktok/pipeline">Pipeline</a>.</p>
                </div>
                <button class="btn btn-primary tk-modal-cta" @onclick="CloseModal">Listo</button>
            }
        </div>
    </div>
</div>
}

@* === Modal Autorespuesta — config por cuenta TikTok (Modulo 2.11) === *@
@if (_arOpen && _arCfg is not null && _arAccount is not null)
{
<div class="tk-modal-bd" @onclick="CloseAutoReply">
    <div class="tk-ar-modal" @onclick:stopPropagation>
        <div class="tk-modal-head">
            <div>
                <div style="font-size:11px; font-weight:700; color:#7c3aed; letter-spacing:.05em; text-transform:uppercase;">Autorespuesta</div>
                <h3 style="margin:4px 0 0;">@(string.IsNullOrEmpty(_arAccount.Handle) ? _arAccount.ClientName : "@" + _arAccount.Handle)</h3>
                <div class="text-muted" style="font-size:12px;">@_arAccount.ClientName · TikTok</div>
            </div>
            <button class="tk-modal-close" @onclick="CloseAutoReply">&times;</button>
        </div>

        <div class="tk-ar-tabs">
            <button class="tk-ar-tab @(_arTab == "general" ? "tk-ar-tab-on" : "")" @onclick='() => _arTab = "general"'>General</button>
            <button class="tk-ar-tab @(_arTab == "plantillas" ? "tk-ar-tab-on" : "")" @onclick='() => _arTab = "plantillas"'>Plantillas (@_arTemplates.Count)</button>
            <button class="tk-ar-tab @(_arTab == "programacion" ? "tk-ar-tab-on" : "")" @onclick='() => _arTab = "programacion"'>Programacion</button>
        </div>

        <div class="tk-modal-body" style="max-height:60vh; overflow-y:auto;">
            @if (_arTab == "general")
            {
                <div class="tk-ar-field tk-ar-switch-row">
                    <label class="tk-ar-switch">
                        <input type="checkbox" @bind="_arIsActive" />
                        <span class="tk-ar-slider"></span>
                    </label>
                    <div>
                        <div style="font-weight:700;">@(_arIsActive ? "Autorespuesta ACTIVA" : "Autorespuesta INACTIVA")</div>
                        <div class="text-muted" style="font-size:12px;">Activa para que el job procese esta cuenta.</div>
                    </div>
                </div>

                <div class="tk-ar-grid">
                    <div class="field">
                        <label class="form-label">Modo de respuesta</label>
                        <select class="form-control" @bind="_arMode">
                            <option value="@AutoReplyMode.Template">Solo plantillas por palabra clave</option>
                            <option value="@AutoReplyMode.Ai">Solo IA (Bandeja IA)</option>
                            <option value="@AutoReplyMode.Mixed">Mixto: plantilla si matchea, IA si no</option>
                        </select>
                        <small class="text-muted">Mixto recomendado: rapido + cobertura.</small>
                    </div>
                    <div class="field">
                        <label class="form-label">Max respuestas por ejecucion</label>
                        <input type="number" min="1" max="200" class="form-control" @bind="_arMaxReplies" />
                        <small class="text-muted">Anti-spam TikTok. Recomendado: 20-30.</small>
                    </div>
                    <div class="field">
                        <label class="form-label">Delay entre respuestas: min (s)</label>
                        <input type="number" min="2" class="form-control" @bind="_arDelayMin" />
                        <small class="text-muted">Minimo 2s (anti-bot).</small>
                    </div>
                    <div class="field">
                        <label class="form-label">Delay max (s)</label>
                        <input type="number" min="2" class="form-control" @bind="_arDelayMax" />
                        <small class="text-muted">Cada respuesta espera un aleatorio entre min y max.</small>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Blacklist — palabras que escalan a humano (una por linea)</label>
                    <textarea class="form-control" rows="3" @bind="_arBlacklist" placeholder="precio&#10;reembolso&#10;queja&#10;demanda"></textarea>
                    <small class="text-muted">Comentarios con estas palabras NO reciben respuesta automatica y se marcan en la bandeja.</small>
                </div>

                <div class="tk-ar-warn">
                    <b>Guardrail:</b> el motor jamas responde a comentarios con palabras prohibidas. Esos casos se marcan para revision humana.
                </div>
            }
            else if (_arTab == "plantillas")
            {
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                    <div>
                        <div style="font-weight:700;">Plantillas por palabra clave</div>
                        <small class="text-muted">La primera plantilla cuya keyword matchea gana.</small>
                    </div>
                    <button class="btn btn-sm btn-primary" @onclick="AddTemplate">+ Plantilla</button>
                </div>
                @if (_arTemplates.Count == 0)
                {
                    <div class="text-muted" style="font-size:13px; text-align:center; padding:30px 0;">Aun no hay plantillas. Agrega la primera.</div>
                }
                @foreach (var (t, i) in _arTemplates.Select((t, i) => (t, i)))
                {
                    <div class="tk-ar-tpl">
                        <input class="tk-ar-tpl-kw" placeholder="palabra,clave,otra" @bind="t.Keywords" />
                        <textarea class="tk-ar-tpl-body" rows="2" placeholder="Respuesta cuando alguna keyword matchea" @bind="t.Body"></textarea>
                        <button class="tk-ar-tpl-del" @onclick="() => RemoveTemplate(i)">&times;</button>
                    </div>
                }

                <hr style="margin:18px 0; border:0; border-top:1px solid #f3f4f6;" />
                <div class="field">
                    <label class="form-label">Plantilla por defecto</label>
                    <textarea class="form-control" rows="2" @bind="_arDefaultTpl" placeholder="Gracias por tu comentario! Te respondemos por DM."></textarea>
                    <small class="text-muted">Se usa cuando ninguna keyword matchea y el modo es Solo plantillas.</small>
                </div>

                <hr style="margin:18px 0; border:0; border-top:1px solid #f3f4f6;" />
                <div class="field">
                    <label class="form-label">Agente IA (lista de agentes activos)</label>
                    <select class="form-control" @bind="_arAgentId">
                        <option value="">(Auto: usa el primer agente IA activo del tenant)</option>
                        @foreach (var ag in _arAgentOptions.Where(a => a.IsActive))
                        {
                            <option value="@ag.Id">@ag.Name — @ag.Provider</option>
                        }
                        @if (_arAgentOptions.Any(a => !a.IsActive))
                        {
                            <optgroup label="Inactivos (no procesan)">
                                @foreach (var ag in _arAgentOptions.Where(a => !a.IsActive))
                                {
                                    <option value="@ag.Id" disabled>@ag.Name — @ag.Provider (apagado)</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <small class="text-muted">
                        Modo <strong>Mixto</strong>: si una plantilla matchea, la pasamos a este agente como sugerencia para que genere una variacion (no copia literal).
                        Modo <strong>Solo IA</strong>: el agente recibe solo el comentario.
                        Modo <strong>Solo plantillas</strong>: ignora al agente.
                    </small>
                </div>
            }
            else if (_arTab == "programacion")
            {
                <div class="tk-ar-grid">
                    <div class="field">
                        <label class="form-label">Frecuencia del job</label>
                        <select class="form-control" @bind="_arFrequency" @bind:after="OnFrequencyChanged">
                            <option value="@AutoReplyFrequency.Every15m">Cada 15 minutos</option>
                            <option value="@AutoReplyFrequency.Every30m">Cada 30 minutos</option>
                            <option value="@AutoReplyFrequency.Every1h">Cada 1 hora</option>
                            <option value="@AutoReplyFrequency.Every2h">Cada 2 horas</option>
                            <option value="@AutoReplyFrequency.Every4h">Cada 4 horas</option>
                            <option value="@AutoReplyFrequency.Daily">Una vez al dia</option>
                            <option value="@AutoReplyFrequency.Custom">Personalizado (cron)</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="form-label">Cron equivalente</label>
                        <input class="form-control" style="font-family:ui-monospace,Consolas,monospace; background:#1e293b; color:#10b981;" @bind="_arCronCustom" disabled="@(_arFrequency != AutoReplyFrequency.Custom)" />
                        <small class="text-muted">Editable solo si frecuencia = Personalizado.</small>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Horario activo (hora local). Click para activar/desactivar cada hora.</label>
                    <div class="tk-ar-hours">
                        @for (var h = 0; h < 24; h++)
                        {
                            var hour = h;
                            var on = (_arHoursMask & (1 << hour)) != 0;
                            <button type="button" class="tk-ar-hour @(on ? "tk-ar-hour-on" : "")" @onclick="() => ToggleHour(hour)">@hour.ToString("00")</button>
                        }
                    </div>
                    <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetHourRange(8, 20)">8am - 8pm</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetHourRange(9, 18)">Horario laboral</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetHourRange(0, 24)">24/7</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetHourRange(0, 0)">Limpiar</button>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Dias activos</label>
                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                        @for (var d = 0; d < 7; d++)
                        {
                            var day = d;
                            var dayLabel = new[] { "Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom" }[day];
                            var on = (_arDaysMask & (1 << day)) != 0;
                            <button type="button" class="tk-ar-day @(on ? "tk-ar-day-on" : "")" @onclick="() => ToggleDay(day)">@dayLabel</button>
                        }
                    </div>
                </div>
            }

            @if (_arError is not null) { <div class="text-danger small" style="margin-top:8px;">@_arError</div> }
        </div>

        <div class="tk-ar-foot">
            <button class="btn btn-outline-secondary" @onclick="CloseAutoReply">Cancelar</button>
            <button class="btn btn-primary" @onclick="SaveAutoReplyAsync" disabled="@_arBusy">@(_arBusy ? "Guardando..." : "Guardar configuracion")</button>
        </div>
    </div>
</div>
}

<style>
    .tk-cards-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap:18px; }
    .tk-card { background:#fff; border:1px solid var(--border); border-radius:14px; padding:20px 22px; position:relative; overflow:hidden; }
    .tk-card-net { position:absolute; top:8px; right:8px; opacity:.08; width:64px; height:64px; }
    .tk-card-net svg { width:100%; height:100%; }
    .tk-card-head { display:flex; gap:14px; align-items:flex-start; margin-bottom:14px; position:relative; z-index:1; }
    .tk-card-avatar { width:56px; height:56px; border-radius:50%; background:linear-gradient(135deg,#111827,#374151); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:20px; flex-shrink:0; }
    .tk-card-name { font-weight:700; color:#111827; font-size:16px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .tk-card-handle { color:#6b7280; font-size:13px; }
    .tk-card-del { background:#fff; border:none; padding:6px; border-radius:8px; color:#9ca3af; cursor:pointer; }
    .tk-card-del:hover { color:#dc2626; background:#fef2f2; }
    .tk-card-del svg { width:18px; height:18px; }
    .tk-card-foot { display:flex; justify-content:space-between; align-items:center; padding-top:14px; border-top:1px solid #f3f4f6; position:relative; z-index:1; }
    .tk-card-lbl { font-size:11px; color:#6b7280; text-transform:uppercase; font-weight:700; letter-spacing:.04em; }
    .tk-card-val { font-weight:700; color:#111827; font-size:16px; }
    .tk-card-status { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:500; color:#374151; }
    .tk-dot { width:10px; height:10px; border-radius:50%; }
    .tk-dot-ok { background:#22c55e; }
    .tk-dot-off { background:#ef4444; }

    .tk-modal-bd { position:fixed; inset:0; background:rgba(0,0,0,.55); backdrop-filter: blur(2px); z-index:50; display:flex; align-items:center; justify-content:center; padding:20px; }
    .tk-modal { background:#fff; border-radius:18px; width:100%; max-width:460px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.3); }
    .tk-modal-head { display:flex; justify-content:space-between; align-items:center; padding:18px 22px; border-bottom:1px solid #f3f4f6; }
    .tk-modal-head h3 { margin:0; font-size:18px; font-weight:700; }
    .tk-modal-close { background:none; border:none; font-size:28px; color:#9ca3af; cursor:pointer; line-height:1; padding:0 4px; }
    .tk-modal-body { padding:22px; }
    .tk-modal-help { color:#6b7280; font-size:13px; margin:0 0 16px; }
    .tk-net-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap:10px; margin: 14px 0 20px; }
    .tk-net-btn { background:#fff; border:2px solid #f3f4f6; padding:18px 8px; border-radius:14px; display:flex; flex-direction:column; align-items:center; gap:8px; cursor:pointer; transition:all .15s; font-weight:600; font-size:12px; color:#374151; }
    .tk-net-btn svg { width:28px; height:28px; }
    .tk-net-btn:disabled { opacity:.5; cursor:not-allowed; }
    .tk-net-sel-tk { border-color:#111827; background:#f9fafb; }
    .tk-net-sel-ig { border-color:#ec4899; background:#fdf2f8; color:#be185d; }
    .tk-net-sel-yt { border-color:#dc2626; background:#fef2f2; color:#b91c1c; }
    .tk-modal-cta { width:100%; padding:12px; font-weight:600; }
    .tk-trace { background:#0f172a; color:#cbd5e1; font-size:11px; padding:10px 12px; border-radius:8px; max-height:140px; overflow:auto; margin:12px 0 0; white-space:pre-wrap; }
    .tk-success { text-align:center; padding:10px 0 20px; }
    .tk-success-ic { width:64px; height:64px; border-radius:50%; background:#dcfce7; color:#15803d; display:flex; align-items:center; justify-content:center; margin:0 auto 14px; }
    .tk-success-ic svg { width:34px; height:34px; }
    .tk-success h4 { margin:0 0 6px; font-size:18px; font-weight:700; }
    .tk-success p { margin:0; color:#6b7280; font-size:13px; }
    .field { margin-bottom: 14px; }

    /* Autorespuesta modal */
    .tk-ar-modal { background:#fff; border-radius:18px; width:100%; max-width:720px; box-shadow:0 20px 60px rgba(0,0,0,.3); display:flex; flex-direction:column; max-height:90vh; }
    .tk-ar-tabs { display:flex; gap:8px; padding:0 22px; border-bottom:1px solid #f3f4f6; flex-wrap:wrap; }
