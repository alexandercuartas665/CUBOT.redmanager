@page "/login"
@layout CubotRedManager.Web.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]
@inject CubotRedManager.Application.Admin.IPlatformBrandingService BrandingSvc
@inject CubotRedManager.Application.Admin.IGoogleAuthConfigService GoogleCfg

<PageTitle>Ingresar - @_brand.PlatformName</PageTitle>

<div class="auth-shell @(StartSignup ? "is-signup" : "")">

    <!-- Panel izquierdo: marca + bienvenida -->
    <aside class="auth-aside">
        <div class="auth-aside-deco auth-deco-tr"></div>
        <div class="auth-aside-deco auth-deco-bl"></div>

        <div class="auth-brand">
            @if (!string.IsNullOrWhiteSpace(_brand.LoginLogoUrl))
            {
                <img class="auth-brand-logo-img" src="@_brand.LoginLogoUrl" alt="@_brand.PlatformName" />
            }
            else
            {
                <div class="auth-brand-logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
                </div>
            }
            <span class="auth-brand-name">@_brand.PlatformName</span>
        </div>

        <div class="auth-aside-body">
            <h2>@(_brand.LoginHeadline ?? "Rapido, facil y seguro")</h2>
            <p>@(_brand.LoginSubtext ?? "Gestiona Meta, TikTok y YouTube de tus clientes con agentes de IA.")</p>
            <div class="auth-dots"><span></span><span></span><span></span></div>
        </div>
    </aside>

    <!-- Panel derecho: formularios -->
    <main class="auth-main">
        <div class="auth-form-wrap">

            <!-- INICIAR SESION -->
            <section class="auth-pane auth-pane-login">
                <div class="auth-head">
                    <h1>Iniciar sesion</h1>
                    <p>Bienvenido de nuevo. Ingresa a tu panel.</p>
                </div>

                @if (Error == 1)
                {
                    <div class="auth-alert auth-alert-error">Credenciales invalidas o cuenta sin acceso.</div>
                }
                @if (Reset == 1)
                {
                    <div class="auth-alert auth-alert-ok">Tu contrasena se actualizo. Ya puedes iniciar sesion.</div>
                }
                @if (!string.IsNullOrWhiteSpace(GError))
                {
                    <div class="auth-alert auth-alert-error">@GError</div>
                }

                @if (_googleEnabled)
                {
                    <div class="auth-providers">
                        <a class="auth-provider" href="/connect/google">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                            </svg>
                            <span>Continuar con Google</span>
                        </a>
                    </div>
                    <div class="auth-divider"><span>o con tu correo</span></div>
                }

                <form method="post" action="/auth/login" class="auth-form">
                    @if (!string.IsNullOrEmpty(ReturnUrl))
                    {
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    }
                    <div class="auth-field">
                        <label for="login-email">Correo electronico</label>
                        <input id="login-email" name="email" type="email" required placeholder="tu.correo@ejemplo.com" />
                    </div>
                    <div class="auth-field">
                        <div class="auth-label-row">
                            <label for="login-password">Contrasena</label>
                            <a class="auth-forgot" href="/recuperar">Olvidaste tu contrasena?</a>
                        </div>
                        <div class="auth-input-icon">
                            <input id="login-password" name="password" type="password" required placeholder="Tu contrasena" />
                            <button type="button" class="auth-eye" onclick="cubotAuth.toggle('login-password', this)">MOSTRAR</button>
                        </div>
                    </div>
                    <button class="auth-submit" type="submit">
                        <span>Ingresar</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                </form>

                <p class="auth-switch">
                    No tienes una cuenta?
                    <button type="button" onclick="cubotAuth.show('signup')">Crea una aqui</button>
                </p>
            </section>

            <!-- CREAR CUENTA (autogestion) -->
            <section class="auth-pane auth-pane-signup">
                <div class="auth-head">
                    <h1>Crear una cuenta</h1>
                    <p>Registra tu agencia y empieza a operar en minutos.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(RegError))
                {
                    <div class="auth-alert auth-alert-error">@RegError</div>
                }

                <div class="auth-alert auth-alert-error">
                    El auto-registro aun no esta habilitado en CUBOT.redmanager. Solicita una invitacion al equipo de plataforma.
                </div>

                <p class="auth-switch">
                    Ya tienes una cuenta?
                    <button type="button" onclick="cubotAuth.show('login')">Iniciar sesion</button>
                </p>
            </section>

        </div>

        <footer class="auth-footer">&copy; @DateTime.UtcNow.Year @_brand.PlatformName. Todos los derechos reservados.</footer>
    </main>
</div>

<script>
    window.cubotAuth = {
        show: function (mode) {
            var shell = document.querySelector('.auth-shell');
            if (!shell) return;
            shell.classList.toggle('is-signup', mode === 'signup');
        },
        toggle: function (id, btn) {
            var input = document.getElementById(id);
            if (!input) return;
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'OCULTAR' : 'MOSTRAR';
        }
    };
</script>

@code {
    [SupplyParameterFromQuery] public int? Error { get; set; }
    [SupplyParameterFromQuery] public int? Reset { get; set; }
    [SupplyParameterFromQuery] public string? RegError { get; set; }
    [SupplyParameterFromQuery(Name = "gerror")] public string? GError { get; set; }
    [SupplyParameterFromQuery] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }

    private CubotRedManager.Application.Admin.PlatformBrandingDto _brand = CubotRedManager.Application.Admin.PlatformBrandingDto.Default;
    private bool _googleEnabled;

    private bool StartSignup => string.Equals(Mode, "signup", StringComparison.OrdinalIgnoreCase)
        || !string.IsNullOrWhiteSpace(RegError);

    protected override async Task OnInitializedAsync()
    {
        _brand = await BrandingSvc.GetAsync();
        _googleEnabled = (await GoogleCfg.GetAsync())?.IsEnabled == true;
    }
}
