@page "/conexiones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject NavigationManager Nav

@* Ruta legacy. La config de la app TikTok paso a ser de plataforma (SuperAdmin) —
   ver ADR / task #84. Aqui redirigimos a la nueva ubicacion para no romper bookmarks. *@
@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo("/admin/plataforma/tiktok-app", replace: true);
    }
}
