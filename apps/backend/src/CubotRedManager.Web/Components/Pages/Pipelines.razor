    }

    private sealed class EditableStage
    {
        public Guid Id { get; }
        public Guid PipelineId { get; }
        public string Name { get; }
        public int SortOrder { get; }
        public bool IsClosedWon { get; set; }
        public bool IsClosedLost { get; set; }
        public string NameEdit { get; set; }
