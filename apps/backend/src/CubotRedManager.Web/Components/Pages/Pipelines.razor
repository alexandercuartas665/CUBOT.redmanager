@code {
    private List<EditablePipeline> _pipelines = new();
    private Guid? _currentPipelineId;
    private EditablePipeline? _currentPipeline;
    private List<EditableStage> _stages = new();
    private List<EditableField> _fields = new();
    private List<LeadDto> _leads = new();
    private List<TenantUserDto> _team = new();
    private List<LeadNoteDto> _notes = new();
    private List<LeadFileDto> _files = new();
    private List<LeadActivityDto> _activities = new();
    private List<ArchivedLeadDto> _history = new();

    private bool _loading = true, _busy, _canManage, _canPurge, _leadSaved;
    private bool _newLeadOpen, _leadOpen, _historyOpen, _configOpen, _filtersOpen;
    private Guid _actor;
    private Guid _tenantId;
    private int _conversion;
    private string _search = "", _sortBy = "time", _tab = "datos", _boardView = "kanban";
    private string _newNote = "", _newNoteColor = "yellow";
    private bool _newPipelineOpen;
    private string _newPipelineName = "", _newStageName = "";
    private bool _newStageWon, _newStageLost;
    private Guid? _dragLeadId, _dragOverStageId;
    private readonly HashSet<Guid> _filterAsesores = new();
    private readonly HashSet<Guid> _filterStages = new();
    private bool _filterSinAsesor;

    private readonly Dictionary<Guid, string> _newFieldLabels = new();
    private readonly Dictionary<Guid, PipelineFieldType> _newFieldTypes = new();

    private NewLeadForm _newLead = new();
    private EditLeadForm? _editLead;
    private LeadDto? _archiveLead;
    private string _archiveReason = "", _archiveNote = "";
    private string? _newLeadError;
    private readonly Dictionary<string, string?> _fieldValues = new();

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _actor);
        Guid.TryParse(st.User.FindFirst("tenant_id")?.Value, out _tenantId);
        var role = st.User.FindFirst("tenant_role")?.Value;
        _canManage = role is "Owner" or "Admin";
        _canPurge = role is "Owner" or "Admin";
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _loading = true;
        var raw = await PipelineSvc.ListPipelinesAsync();
        _pipelines = raw.Select(p => new EditablePipeline(p.Id, p.Name, p.SortOrder, p.IsSystem, p.StageCount, p.LeadCount)).ToList();
        // Al entrar a /pipelines NO autoseleccionamos un embudo: mostramos la grilla de cards para
        // que cada embudo se sienta independiente. El usuario abre el que quiere operar.
        if (_currentPipelineId is Guid id && _pipelines.Any(p => p.Id == id))
        {
            await SelectPipelineInternalAsync(id);
        }
        else
        {
            _currentPipelineId = null;
            _currentPipeline = null;
            _stages = new();
            _fields = new();
            _leads = new();
        }
        _team = (await UsersSvc.ListAsync()).ToList();
        _loading = false;
    }

    private async Task OpenConfigForAsync(Guid pipelineId)
    {
        await SelectPipelineInternalAsync(pipelineId);
        _currentPipelineId = pipelineId;
        OpenConfig();
    }

    private void BackToIndex()
    {
        _currentPipelineId = null;
        _currentPipeline = null;
        _stages = new();
        _fields = new();
        _leads = new();
        _filterAsesores.Clear();
        _filterStages.Clear();
        _filterSinAsesor = false;
        _search = "";
    }

    private async Task SeedDefaultsAsync()
    {
        _busy = true;
        await PipelineSvc.EnsureDefaultsAsync(_actor);
        _busy = false;
        await LoadAllAsync();
    }

    private async Task SelectPipeline(Guid pipelineId)
    {
        _currentPipelineId = pipelineId;
        await SelectPipelineInternalAsync(pipelineId);
    }

    private async Task SelectPipelineInternalAsync(Guid pipelineId)
    {
        _currentPipeline = _pipelines.FirstOrDefault(p => p.Id == pipelineId);
        _stages = (await PipelineSvc.ListStagesAsync(pipelineId)).Select(s => new EditableStage(s.Id, s.PipelineId, s.Name, s.SortOrder, s.IsClosedWon, s.IsClosedLost)).ToList();
        _fields = (await PipelineSvc.ListFieldsAsync(pipelineId)).Select(f => new EditableField(f)).ToList();
        _leads = (await LeadsSvc.ListAsync(pipelineId)).ToList();
        RecalcKpis();
    }

    private void RecalcKpis()
    {
        var closedWon = _leads.Count(l => l.Status == LeadStatus.Won);
        var closedLost = _leads.Count(l => l.Status == LeadStatus.Lost);
        var total = closedWon + closedLost;
        _conversion = total == 0 ? 0 : (int)Math.Round(100.0 * closedWon / total);
    }

    // ===== Filtros =====

    private bool FiltersActive => _filterAsesores.Count > 0 || _filterStages.Count > 0 || _filterSinAsesor;
    private int ActiveFilterCount => _filterAsesores.Count + _filterStages.Count + (_filterSinAsesor ? 1 : 0);

    private void ToggleAsesor(Guid id) { if (!_filterAsesores.Add(id)) _filterAsesores.Remove(id); }
    private void ToggleStage(Guid id) { if (!_filterStages.Add(id)) _filterStages.Remove(id); }
    private void ClearFilters() { _filterAsesores.Clear(); _filterStages.Clear(); _filterSinAsesor = false; _search = ""; }

    /// <summary>Todos los leads del embudo actual filtrados globalmente (busqueda + asesor + stage + sin asesor + sort).
    /// A diferencia de FilteredLeadsFor(stageId), esta vista es plana para la tabla.</summary>
    private List<LeadDto> AllFilteredLeads()
    {
        var q = _leads.AsEnumerable();
        if (_filterStages.Count > 0) { q = q.Where(l => _filterStages.Contains(l.StageId)); }
        if (_filterAsesores.Count > 0) { q = q.Where(l => l.AssignedToTenantUserId is Guid aid && _filterAsesores.Contains(aid)); }
        if (_filterSinAsesor) { q = q.Where(l => l.AssignedToTenantUserId is null); }
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(l => l.ContactName.ToLowerInvariant().Contains(s) || (l.ContactPhone ?? "").ToLowerInvariant().Contains(s));
        }
        q = _sortBy switch
        {
            "recent" => q.OrderByDescending(l => l.CreatedAt),
            "name" => q.OrderBy(l => l.ContactName),
            _ => q.OrderByDescending(l => l.StageChangedAt)
        };
        return q.ToList();
    }

    private static string StatusLabel(LeadStatus s) => s switch
    {
        LeadStatus.Won => "Ganado",
        LeadStatus.Lost => "Perdido",
        _ => "Abierto"
    };

    private List<LeadDto> FilteredLeadsFor(Guid stageId)
    {
        var q = _leads.Where(l => l.StageId == stageId);
        if (_filterStages.Count > 0 && !_filterStages.Contains(stageId)) { return new(); }
        if (_filterAsesores.Count > 0) { q = q.Where(l => l.AssignedToTenantUserId is Guid aid && _filterAsesores.Contains(aid)); }
        if (_filterSinAsesor) { q = q.Where(l => l.AssignedToTenantUserId is null); }
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(l => l.ContactName.ToLowerInvariant().Contains(s) || (l.ContactPhone ?? "").ToLowerInvariant().Contains(s));
        }
        q = _sortBy switch
        {
            "recent" => q.OrderByDescending(l => l.CreatedAt),
            "name" => q.OrderBy(l => l.ContactName),
            _ => q.OrderByDescending(l => l.StageChangedAt)
        };
        return q.ToList();
    }

    // ===== Kanban drag-drop =====

    private async Task OnDropAsync(Guid stageId)
    {
        _dragOverStageId = null;
        if (_dragLeadId is not Guid lid) { return; }
        var lead = _leads.FirstOrDefault(l => l.Id == lid);
        if (lead is null || lead.StageId == stageId) { _dragLeadId = null; return; }

        _busy = true;
        var updated = await LeadsSvc.MoveAsync(lid, new MoveLeadRequest(stageId), _actor);
        _busy = false;
        _dragLeadId = null;
        if (updated is not null) { await SelectPipelineInternalAsync(_currentPipelineId!.Value); }
    }

    // ===== KPIs helpers =====

    private int CountOpen() => _leads.Count(l => l.Status == LeadStatus.Open);
    private int CountWon() => _leads.Count(l => l.Status == LeadStatus.Won);
    private string PipelineValue()
    {
        var openWithValue = _leads.Where(l => l.Status == LeadStatus.Open && l.EstimatedValue.HasValue).ToList();
        if (openWithValue.Count == 0) { return "—"; }
        var byCur = openWithValue.GroupBy(l => l.Currency ?? "COP").FirstOrDefault();
        if (byCur is null) { return "—"; }
        var total = byCur.Sum(l => l.EstimatedValue ?? 0);
        return FormatMoney(total, byCur.Key);
    }

    // ===== Nuevo lead =====

    private void OpenNewLead(Guid? stageId)
    {
        _newLead = new NewLeadForm { StageId = stageId ?? _stages.FirstOrDefault()?.Id ?? Guid.Empty };
        _newLeadError = null;
        _newLeadOpen = true;
    }

    private async Task SaveNewLeadAsync()
    {
        if (_currentPipelineId is null) { return; }
        _busy = true;
        var req = new CreateLeadRequest(
            _currentPipelineId.Value,
            _newLead.ContactName.Trim(),
            _newLead.ContactPhone?.Trim(),
            _newLead.Topic?.Trim(),
            _newLead.EstimatedValue,
            _newLead.Currency?.Trim(),
            _newLead.StageId == Guid.Empty ? null : _newLead.StageId);
        var created = await LeadsSvc.CreateAsync(req, _actor);
        _busy = false;
        if (created is null) { _newLeadError = "No se pudo crear (revisa pipeline/stage)."; return; }
        _newLeadOpen = false;
        await SelectPipelineInternalAsync(_currentPipelineId.Value);
    }

    // ===== Detalle lead =====

    private async Task OpenLeadAsync(Guid leadId)
    {
        var detail = await LeadsSvc.GetAsync(leadId);
        if (detail is null) { return; }
        _editLead = EditLeadForm.From(detail.Lead);
        _fieldValues.Clear();
        foreach (var kv in detail.Lead.FieldValues) { _fieldValues[kv.Key] = kv.Value; }
        // Pre-cargar keys de los fields de la etapa actual (para que @bind no se queje por key faltante).
        foreach (var f in FieldsForStage(_editLead.StageId))
        {
            _fieldValues.TryAdd(f.FieldKey, null);
        }
        _activities = detail.Activities.ToList();
        _notes = (await LeadsSvc.ListNotesAsync(leadId)).ToList();
        _files = (await LeadsSvc.ListFilesAsync(leadId)).ToList();
        _leadSaved = false;
        _tab = "datos";
        _leadOpen = true;
    }

    private void CloseLead() { _leadOpen = false; _editLead = null; }

    private bool _editStageIsLost => _editLead is not null && _stages.FirstOrDefault(s => s.Id == _editLead.StageId)?.IsClosedLost == true;

    private List<PipelineFieldDto> StageFieldsForEditLead => _editLead is null ? new() : FieldsForStage(_editLead.StageId);

    private void OpenArchiveFromDetail()
    {
        if (_editLead is null) { return; }
        _archiveLead = _leads.FirstOrDefault(l => l.Id == _editLead.Id);
        _archiveReason = string.Empty;
        _archiveNote = string.Empty;
    }

    private async Task SaveLeadAsync()
    {
        if (_editLead is null) { return; }
        _busy = true;
        // Update datos basicos + field values
        var updated = await LeadsSvc.UpdateAsync(_editLead.Id, new UpdateLeadRequest(
            _editLead.ContactName.Trim(),
            _editLead.ContactPhone?.Trim(),
            _editLead.Topic?.Trim(),
            _editLead.EstimatedValue,
            _editLead.Currency?.Trim(),
            new Dictionary<string, string?>(_fieldValues)), _actor);

        // Si cambio de stage, hacer el move (con lossReason si aplica).
        var original = _leads.FirstOrDefault(l => l.Id == _editLead.Id);
        if (updated is not null && original is not null && original.StageId != _editLead.StageId)
        {
            await LeadsSvc.MoveAsync(_editLead.Id, new MoveLeadRequest(_editLead.StageId, _editLead.LossReason), _actor);
        }

        // Si cambio asignacion
        if (updated is not null && original?.AssignedToTenantUserId != _editLead.AssignedToTenantUserId)
        {
            await LeadsSvc.AssignAsync(_editLead.Id, _editLead.AssignedToTenantUserId, _actor);
        }
        _busy = false;
        _leadSaved = true;
        await SelectPipelineInternalAsync(_currentPipelineId!.Value);
    }

    private async Task AddNoteAsync()
    {
        if (_editLead is null || string.IsNullOrWhiteSpace(_newNote)) { return; }
        _busy = true;
        var n = await LeadsSvc.AddNoteAsync(_editLead.Id, _newNote, _newNoteColor, _actor);
        _busy = false;
        if (n is not null) { _notes.Insert(0, n); }
        _newNote = "";
    }

    private async Task DeleteNoteAsync(Guid noteId)
    {
        if (await LeadsSvc.DeleteNoteAsync(noteId))
        {
            _notes = _notes.Where(n => n.Id != noteId).ToList();
        }
    }

    private async Task OnLeadFileSelected(InputFileChangeEventArgs e)
    {
        if (_editLead is null) { return; }
        var file = e.File;
        if (file.Size > 20L * 1024 * 1024) { return; } // 20MB cap defensivo
        _busy = true;
        using var ms = new MemoryStream();
        await using var stream = file.OpenReadStream(20L * 1024 * 1024);
        await stream.CopyToAsync(ms);
        var saved = await LeadsSvc.AddFileAsync(_editLead.Id, file.Name, ms.ToArray(), file.ContentType, _actor);
        _busy = false;
        if (saved is not null) { _files.Insert(0, saved); }
    }

    private async Task DeleteFileAsync(Guid fileId)
    {
        if (await LeadsSvc.DeleteFileAsync(fileId))
        {
            _files = _files.Where(f => f.Id != fileId).ToList();
        }
    }

    // ===== Archivar / historial =====

    private async Task ConfirmArchiveAsync()
    {
        if (_archiveLead is null) { return; }
        _busy = true;
        await LeadsSvc.ArchiveAsync(_archiveLead.Id, _archiveReason, _archiveNote, _actor);
        _busy = false;
        _archiveLead = null;
        _leadOpen = false; _editLead = null;
        await SelectPipelineInternalAsync(_currentPipelineId!.Value);
    }

    private async Task OpenHistoryAsync()
    {
        _history = (await LeadsSvc.ListArchivedAsync(_currentPipelineId)).ToList();
        _historyOpen = true;
    }

    private async Task RestoreAsync(Guid leadId)
    {
        _busy = true;
        await LeadsSvc.UnarchiveAsync(leadId, _actor);
        _busy = false;
        _history = (await LeadsSvc.ListArchivedAsync(_currentPipelineId)).ToList();
        await SelectPipelineInternalAsync(_currentPipelineId!.Value);
    }

    private async Task PurgeHistoryAsync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "ATENCION: esto borra permanentemente todos los leads del historial. ¿Continuar?");
        if (!ok) { return; }
        _busy = true;
        await LeadsSvc.PurgeArchivedHistoryAsync();
        _busy = false;
        _history = (await LeadsSvc.ListArchivedAsync(_currentPipelineId)).ToList();
    }

    // ===== Configurar embudos =====

    private void OpenConfig()
    {
        foreach (var p in _pipelines) { p.NameEdit = p.Name; }
        foreach (var s in _stages) { s.NameEdit = s.Name; }
        foreach (var f in _fields) { f.LabelEdit = f.Label; }
        _configOpen = true;
    }

    private async Task CreatePipelineAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPipelineName)) { return; }
        _busy = true;
        var created = await PipelineSvc.CreatePipelineAsync(new CreatePipelineRequest(_newPipelineName.Trim()), _actor);
        _busy = false;
        _newPipelineName = "";
        _newPipelineOpen = false;
        if (created is not null) { await LoadAllAsync(); }
    }

    private async Task RenamePipelineAsync(EditablePipeline p)
    {
        if (string.IsNullOrWhiteSpace(p.NameEdit) || p.NameEdit == p.Name) { return; }
        _busy = true;
        await PipelineSvc.UpdatePipelineAsync(p.Id, new UpdatePipelineRequest(p.NameEdit), _actor);
        _busy = false;
        await LoadAllAsync();
    }

    private async Task DeletePipelineAsync(Guid pipelineId)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "¿Eliminar este embudo? Solo se puede si no tiene leads.");
        if (!ok) { return; }
        _busy = true;
        await PipelineSvc.DeletePipelineAsync(pipelineId, _actor);
        _busy = false;
        if (_currentPipelineId == pipelineId) { _currentPipelineId = null; }
        await LoadAllAsync();
    }

    private async Task CreateStageAsync()
    {
        if (_currentPipeline is null) { return; }
        _busy = true;
        await PipelineSvc.CreateStageAsync(new CreatePipelineStageRequest(
            _currentPipeline.Id, _newStageName.Trim(), 0, _newStageWon, _newStageLost), _actor);
        _busy = false;
        _newStageName = ""; _newStageWon = false; _newStageLost = false;
        await SelectPipelineInternalAsync(_currentPipeline.Id);
        OpenConfig(); // recarga labels editables
    }

    private async Task UpdateStageAsync(EditableStage s)
    {
        _busy = true;
        await PipelineSvc.UpdateStageAsync(s.Id, new UpdatePipelineStageRequest(s.NameEdit, s.IsClosedWon, s.IsClosedLost), _actor);
        _busy = false;
        await SelectPipelineInternalAsync(_currentPipeline!.Id);
        OpenConfig();
    }

    private async Task DeleteStageAsync(Guid stageId)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "¿Eliminar esta etapa? Solo si no tiene leads.");
        if (!ok) { return; }
        _busy = true;
        await PipelineSvc.DeleteStageAsync(stageId, _actor);
        _busy = false;
        await SelectPipelineInternalAsync(_currentPipeline!.Id);
        OpenConfig();
    }

    private async Task CreateFieldAsync(Guid stageId)
    {
        _newFieldLabels.TryGetValue(stageId, out var label);
        _newFieldTypes.TryGetValue(stageId, out var type);
        if (string.IsNullOrWhiteSpace(label)) { return; }
        _busy = true;
        await PipelineSvc.CreateFieldAsync(new CreatePipelineFieldRequest(stageId, label.Trim(), type), _actor);
        _busy = false;
        _newFieldLabels[stageId] = "";
        await SelectPipelineInternalAsync(_currentPipeline!.Id);
        OpenConfig();
    }

    private async Task UpdateFieldAsync(EditableField f)
    {
        _busy = true;
        await PipelineSvc.UpdateFieldAsync(f.Id, new UpdatePipelineFieldRequest(
            f.LabelEdit, f.FieldType, f.Column, f.Options, f.Description,
            f.AllowMultiple, f.RepeatWithFieldKey, f.MultiWithDetail, f.TotalSourceKeys, f.ShowInFilter), _actor);
        _busy = false;
        await SelectPipelineInternalAsync(_currentPipeline!.Id);
        OpenConfig();
    }

    private async Task DeleteFieldAsync(Guid fieldId)
    {
        _busy = true;
        await PipelineSvc.DeleteFieldAsync(fieldId, _actor);
        _busy = false;
        await SelectPipelineInternalAsync(_currentPipeline!.Id);
        OpenConfig();
    }

    // ===== Helpers =====

    private List<PipelineFieldDto> FieldsForStage(Guid stageId) =>
        _fields.Where(f => f.StageId == stageId).Select(f => f.ToDto()).ToList();

    private bool IsStale(LeadDto l) => l.Status == LeadStatus.Open && (DateTimeOffset.UtcNow - l.StageChangedAt).TotalDays >= 2;

    private string TimeInStageLabel(LeadDto l)
    {
        var span = DateTimeOffset.UtcNow - l.StageChangedAt;
        if (span.TotalDays >= 1) { return $"{(int)span.TotalDays}d"; }
        if (span.TotalHours >= 1) { return $"{(int)span.TotalHours}h"; }
        return $"{(int)span.TotalMinutes}m";
    }

    private static string FormatMoney(decimal v, string? currency) => $"{v:N0} {currency ?? "COP"}";

    private static string FormatBytes(long b)
    {
        if (b < 1024) { return b + " B"; }
        if (b < 1024 * 1024) { return (b / 1024.0).ToString("0.#") + " KB"; }
        return (b / 1024.0 / 1024.0).ToString("0.#") + " MB";
    }

    private string TeamLabel(TenantUserDto u) => string.IsNullOrWhiteSpace(u.Email) ? "sin email" : u.Email;

    private string FirstName(string full)
    {
        if (string.IsNullOrWhiteSpace(full)) { return "?"; }
        var idx = full.IndexOf(' ');
        return idx > 0 ? full[..idx] : full;
    }

    private static string NoteColorCss(string c) => c switch
    {
        "green" => "#dcfce7",
        "blue" => "#dbeafe",
        "pink" => "#fce7f3",
        "purple" => "#e9d5ff",
        "gray" => "#e5e7eb",
        _ => "#fef3c7"
    };

