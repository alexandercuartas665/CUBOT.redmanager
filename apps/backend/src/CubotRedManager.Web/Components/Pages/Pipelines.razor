    .pl-card-pipe-sys { font-size:11px; color:var(--muted-foreground); display:block; margin-top:2px; }
    .pl-card-pipe-stats { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:10px 0; border-top:1px dashed var(--border); border-bottom:1px dashed var(--border); }
    .pl-card-pipe-stat { text-align:center; }
    .pl-card-pipe-stat .num { font-size:22px; font-weight:700; color:var(--foreground); line-height:1; }
    .pl-card-pipe-stat .lbl { font-size:10px; color:var(--muted-foreground); text-transform:uppercase; letter-spacing:.04em; margin-top:4px; }
    .pl-card-pipe-foot { display:flex; gap:6px; justify-content:space-between; align-items:center; }

    .pl-toolbar { display:flex; gap:8px; margin-bottom:12px; align-items:center; flex-wrap:wrap; }
    .pl-search { position:relative; display:flex; align-items:center; flex:1; max-width:340px; background:var(--card); border:1px solid var(--border); border-radius:8px; padding:0 10px; }
    .pl-search svg { width:14px; height:14px; opacity:0.5; }
    .pl-search input { border:none; outline:none; background:transparent; padding:8px 6px; font-size:13px; flex:1; }
    .pl-sort { display:flex; align-items:center; gap:6px; font-size:12px; }
