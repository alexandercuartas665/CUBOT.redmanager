    private sealed class EditableField
    {
        public Guid Id { get; }
        public Guid StageId { get; }
        public string FieldKey { get; }
        public string Label { get; }
        public string LabelEdit { get; set; }
        public PipelineFieldType FieldType { get; set; }
        public int Column { get; set; }
        public int SortOrder { get; }
        public string? Options { get; set; }
        public string? Description { get; set; }
        public bool AllowMultiple { get; set; }
        public string? RepeatWithFieldKey { get; set; }
        public bool MultiWithDetail { get; set; }
        public string? TotalSourceKeys { get; set; }
        public bool ShowInFilter { get; set; }

        public EditableField(PipelineFieldDto f)
        {
            Id = f.Id; StageId = f.StageId; FieldKey = f.FieldKey; Label = f.Label; LabelEdit = f.Label;
            FieldType = f.FieldType; Column = f.Column; SortOrder = f.SortOrder; Options = f.Options;
            Description = f.Description; AllowMultiple = f.AllowMultiple; RepeatWithFieldKey = f.RepeatWithFieldKey;
            MultiWithDetail = f.MultiWithDetail; TotalSourceKeys = f.TotalSourceKeys; ShowInFilter = f.ShowInFilter;
        }

        public PipelineFieldDto ToDto() => new(Id, StageId, FieldKey, Label, FieldType, Column, SortOrder, Options,
            Description, AllowMultiple, RepeatWithFieldKey, MultiWithDetail, TotalSourceKeys, ShowInFilter);
    }
