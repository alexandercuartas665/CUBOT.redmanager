    .pl-fchip.on { background:var(--primary-soft); color:var(--primary); border-color:var(--primary); }
    .pl-link { background:none; border:none; color:var(--primary); cursor:pointer; font-size:12px; }

    /* Toggle de vista Kanban/Lista */
