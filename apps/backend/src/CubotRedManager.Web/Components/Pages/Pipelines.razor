@page "/pipelines"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using System.Text.Json
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@using CubotRedManager.Web.Authorization
@inject IPipelineService PipelineSvc
@inject ILeadService LeadsSvc
@inject ITenantUserService UsersSvc
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Pipelines - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M8 7v7"/><path d="M12 7v4"/><path d="M16 7v9"/></svg>
            </div>
            <span>Operacion diaria</span>
        </div>
        @if (_currentPipeline is null)
        {
            <h1 class="page-title" style="margin-top:12px;">Pipelines <span>comerciales</span></h1>
            <p class="page-sub" style="margin-bottom:0;">Cada embudo es independiente: sus etapas, campos, leads e historial no se mezclan con los demas. Elige uno para operar.</p>
        }
        else
        {
            <div style="display:flex;align-items:center;gap:10px;margin-top:12px;">
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToIndex" title="Volver a la lista de embudos">&larr; Embudos</button>
                <h1 class="page-title" style="margin:0;">@_currentPipeline.Name</h1>
                @if (_currentPipeline.IsSystem) { <span class="badge bg-light text-muted" title="Embudo del sistema">sistema</span> }
            </div>
            <p class="page-sub" style="margin-bottom:0;">Tablero Kanban de este embudo. Sus etapas, campos y leads son independientes de los otros.</p>
        }
    </div>
    <div style="display:flex;gap:8px;">
        @if (_currentPipeline is null)
        {
            @if (_canManage && _pipelines.Count > 0)
            {
                <button class="btn btn-primary" @onclick="() => _newPipelineOpen = true">+ Nuevo embudo</button>
            }
        }
        else
        {
            @if (_canManage)
            {
                <button class="btn btn-outline-secondary" @onclick="OpenConfig">Configurar embudo</button>
            }
            <button class="btn btn-outline-secondary" @onclick="OpenHistoryAsync">Historial</button>
            <button class="btn btn-primary" @onclick="() => OpenNewLead(null)" disabled="@(_stages.Count == 0)">+ Nuevo lead</button>
        }
    </div>
</div>

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else if (_pipelines.Count == 0)
{
    <div class="pl-empty">
        <p><strong>Aun no hay embudos en esta agencia.</strong></p>
        <p class="text-muted" style="font-size:13px;">Vamos a crearte los embudos "Productos" y "Negocios" por defecto.</p>
        <button class="btn btn-primary" @onclick="SeedDefaultsAsync" disabled="@_busy">Crear embudos por defecto</button>
    </div>
}
else if (_currentPipeline is null)
{
    @* ===== INDEX: cada embudo como tarjeta independiente ===== *@
    <div class="pl-cards">
        @foreach (var p in _pipelines)
        {
            <div class="pl-card-pipe" @onclick="() => SelectPipeline(p.Id)">
                <div class="pl-card-pipe-head">
                    <div class="pl-card-pipe-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M8 7v7"/><path d="M12 7v4"/><path d="M16 7v9"/></svg>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div class="pl-card-pipe-name">@p.Name</div>
                        @if (p.IsSystem) { <span class="pl-card-pipe-sys">embudo del sistema</span> }
                        else { <span class="pl-card-pipe-sys" style="color:var(--primary);">embudo personalizado</span> }
                    </div>
                </div>
                <div class="pl-card-pipe-stats">
                    <div class="pl-card-pipe-stat"><div class="num">@p.LeadCount</div><div class="lbl">leads activos</div></div>
                    <div class="pl-card-pipe-stat"><div class="num">@p.StageCount</div><div class="lbl">etapas</div></div>
                </div>
                <div class="pl-card-pipe-foot">
                    <button class="btn btn-primary btn-sm" @onclick:stopPropagation="true" @onclick="() => SelectPipeline(p.Id)">Abrir embudo &rarr;</button>
                    @if (_canManage)
                    {
                        <button class="btn btn-outline-secondary btn-sm" title="Configurar etapas y campos de este embudo"
                                @onclick:stopPropagation="true" @onclick="() => OpenConfigForAsync(p.Id)">&#9881; Configurar</button>
                    }
                    @if (!p.IsSystem && _canManage)
                    {
                        <button class="btn btn-outline-danger btn-sm" title="Eliminar embudo (solo si no tiene leads)"
                                @onclick:stopPropagation="true" @onclick="() => DeletePipelineAsync(p.Id)">Borrar</button>
                    }
                </div>
            </div>
        }
    </div>
}
else if (_stages.Count == 0)
{
    <p class="text-muted">Este embudo todavia no tiene etapas. @(_canManage ? "Usa el boton Configurar embudo para agregarlas." : "Pide al administrador que configure etapas.")</p>
}
else
{
    @* ===== KPIs ===== *@
    <div class="kpi-grid" style="margin:14px 0 22px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));max-width:840px;">
        <div class="kpi-card">
            <div class="kpi-label">Total leads</div>
            <div class="kpi-value">@_leads.Count</div>
            <div class="kpi-hint">@CountOpen() abiertos en el embudo</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Tasa de conversion</div>
            <div class="kpi-value">@_conversion%</div>
            <div class="kpi-hint">@CountWon() ganados de @_leads.Count</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Valor del embudo</div>
            <div class="kpi-value">@PipelineValue()</div>
            <div class="kpi-hint">Suma de leads abiertos</div>
        </div>
    </div>

    @* ===== Toolbar: busqueda + ordenamiento + filtros + toggle de vista ===== *@
    <div class="pl-toolbar">
        <div class="pl-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input placeholder="Buscar cliente o telefono..." @bind="_search" @bind:event="oninput" />
        </div>
        <div class="pl-sort">
            <span class="pl-sort-lbl">Ordenar:</span>
            <select @bind="_sortBy">
                <option value="time">Tiempo en etapa</option>
                <option value="recent">Mas recientes primero</option>
                <option value="name">Nombre (A-Z)</option>
            </select>
        </div>
        <div class="pl-filt-anchor">
            <button class="btn btn-outline-secondary @(FiltersActive ? "pl-filt-on" : "")" @onclick="() => _filtersOpen = !_filtersOpen">
                Filtros@(FiltersActive ? $" ({ActiveFilterCount})" : "")
            </button>
        </div>
        <div class="pl-view" role="group" aria-label="Modo de vista">
            <button class="pl-view-btn @(_boardView == "kanban" ? "on" : "")" @onclick='() => _boardView = "kanban"' title="Vista Kanban">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3"/><rect width="7" height="7" x="14" y="3"/><rect width="7" height="7" x="3" y="14"/><rect width="7" height="7" x="14" y="14"/></svg>
                Kanban
            </button>
            <button class="pl-view-btn @(_boardView == "list" ? "on" : "")" @onclick='() => _boardView = "list"' title="Vista Lista">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
                Lista
            </button>
        </div>
    </div>
    @if (_filtersOpen)
    {
        <div class="pl-filters">
            <div class="pl-filt-group">
                <div class="pl-filt-lbl">Asesor</div>
                <div class="pl-chips">
                    @foreach (var u in _team)
                    {
                        <button class="pl-fchip @(_filterAsesores.Contains(u.Id) ? "on" : "")" @onclick="() => ToggleAsesor(u.Id)">@FirstName(TeamLabel(u))</button>
                    }
                    <button class="pl-fchip @(_filterSinAsesor ? "on" : "")" @onclick="() => _filterSinAsesor = !_filterSinAsesor">Sin asesor</button>
                </div>
            </div>
            <div class="pl-filt-group">
                <div class="pl-filt-lbl">Etapa</div>
                <div class="pl-chips">
                    @foreach (var s in _stages)
                    {
                        <button class="pl-fchip @(_filterStages.Contains(s.Id) ? "on" : "")" @onclick="() => ToggleStage(s.Id)">@s.Name</button>
                    }
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;">
                <button class="pl-link" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        </div>
    }

    @* ===== Vista Lista (tabla) ===== *@
    @if (_boardView == "list")
    {
        var listLeads = AllFilteredLeads();
        <div class="pl-list">
            <table class="data-table pl-list-table">
                <thead>
                    <tr>
                        <th class="pl-col-lg">Cliente</th>
                        <th class="pl-col-md">Etapa</th>
                        <th class="pl-col-md">Tema</th>
                        <th class="pl-col-sm">Valor</th>
                        <th class="pl-col-md">Asesor</th>
                        <th class="pl-col-sm">Tiempo</th>
                        <th class="pl-col-sm">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in listLeads)
                    {
                        var stage = _stages.FirstOrDefault(s => s.Id == lead.StageId);
                        <tr style="cursor:pointer;" @onclick="() => OpenLeadAsync(lead.Id)">
                            <td>
                                <div style="font-weight:600;">@lead.ContactName</div>
                                @if (!string.IsNullOrWhiteSpace(lead.ContactPhone))
                                { <div class="text-muted" style="font-size:11px;">@lead.ContactPhone</div> }
                            </td>
                            <td>@(stage?.Name ?? "—")</td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(lead.Topic) ? "—" : lead.Topic)</td>
                            <td>@(lead.EstimatedValue is decimal v ? FormatMoney(v, lead.Currency) : "—")</td>
                            <td>@(lead.AssignedToTenantUserId is Guid aid && _team.FirstOrDefault(u => u.Id == aid) is var tm && tm is not null ? FirstName(TeamLabel(tm)) : "—")</td>
                            <td class="text-muted">@TimeInStageLabel(lead)</td>
                            <td>
                                <span class="pl-chip @(lead.Status == LeadStatus.Won ? "pl-chip-won" : lead.Status == LeadStatus.Lost ? "pl-chip-lost" : "")">
                                    @StatusLabel(lead.Status)
                                </span>
                            </td>
                        </tr>
                    }
                    @if (listLeads.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted" style="text-align:center;padding:30px;">Sin leads que coincidan con los filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
    @* ===== Kanban board ===== *@
    <div class="pl-board">
        @foreach (var stage in _stages)
        {
            var stageLeads = FilteredLeadsFor(stage.Id);
            <div class="pl-col @(_dragOverStageId == stage.Id ? "pl-col-dragover" : "")"
                 @ondragover:preventDefault="true"
                 @ondragenter="() => _dragOverStageId = stage.Id"
                 @ondragleave="() => _dragOverStageId = null"
                 @ondrop="() => OnDropAsync(stage.Id)">
                <div class="pl-col-head">
                    <span class="pl-col-name">@stage.Name</span>
                    <span class="pl-col-cnt">@stageLeads.Count</span>
                </div>
                @if (stage.IsClosedWon) { <div class="pl-col-tag pl-col-won">Ganado</div> }
                else if (stage.IsClosedLost) { <div class="pl-col-tag pl-col-lost">Perdido</div> }
                <div class="pl-col-body">
                    @foreach (var lead in stageLeads)
                    {
                        var stale = IsStale(lead);
                        <div class="pl-card @(stale ? "pl-card-stale" : "")" draggable="true"
                             @ondragstart="() => _dragLeadId = lead.Id"
                             @ondragend="() => _dragLeadId = null"
                             @onclick="() => OpenLeadAsync(lead.Id)">
                            <div class="pl-card-name">@lead.ContactName</div>
                            @if (!string.IsNullOrWhiteSpace(lead.ContactPhone))
                            {
                                <div class="pl-card-phone">@lead.ContactPhone</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(lead.Topic))
                            {
                                <div class="pl-card-topic">@lead.Topic</div>
                            }
                            <div class="pl-card-foot">
                                @if (lead.EstimatedValue is decimal v)
                                {
                                    <span class="pl-card-val">@FormatMoney(v, lead.Currency)</span>
                                }
                                <span class="pl-card-time">@TimeInStageLabel(lead)</span>
                            </div>
                            @if (lead.AssignedToTenantUserId is Guid uid && _team.FirstOrDefault(u => u.Id == uid) is var teamMember && teamMember is not null)
                            {
                                <div class="pl-card-asesor">@FirstName(TeamLabel(teamMember))</div>
                            }
                        </div>
                    }
                    @if (stageLeads.Count == 0)
                    {
                        <div class="pl-col-empty">Sin leads</div>
                    }
                </div>
                <button class="pl-col-add" @onclick="() => OpenNewLead(stage.Id)">+ Nuevo lead aqui</button>
            </div>
        }
    </div>
    }
}

@* ===== Modal: nuevo lead ===== *@
@if (_newLeadOpen && _currentPipeline is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:560px;">
            <div class="modal-head">
                <h3>Nuevo lead · @_currentPipeline.Name</h3>
                <button class="modal-close" @onclick="() => _newLeadOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field"><label class="form-label">Nombre del contacto *</label>
                    <input class="form-control" @bind="_newLead.ContactName" />
                </div>
                <div class="field"><label class="form-label">Telefono</label>
                    <input class="form-control" @bind="_newLead.ContactPhone" placeholder="573001234567" />
                </div>
                <div class="field"><label class="form-label">Tema / producto de interes</label>
                    <input class="form-control" @bind="_newLead.Topic" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 120px;gap:10px;">
                    <div class="field"><label class="form-label">Valor estimado</label>
                        <input class="form-control" type="number" step="0.01" @bind="_newLead.EstimatedValue" />
                    </div>
                    <div class="field"><label class="form-label">Moneda</label>
                        <input class="form-control" @bind="_newLead.Currency" placeholder="COP" />
                    </div>
                </div>
                <div class="field"><label class="form-label">Etapa inicial</label>
                    <select class="form-control" @bind="_newLead.StageId">
                        @foreach (var s in _stages)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(_newLeadError))
                {
                    <div class="text-danger small">@_newLeadError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _newLeadOpen = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveNewLeadAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newLead.ContactName))">Crear</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: detalle del lead con tabs ===== *@
@if (_leadOpen && _editLead is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:800px;">
            <div class="modal-head">
                <h3>@_editLead.ContactName</h3>
                <div style="display:flex;gap:8px;align-items:center;">
                    @if (_leadSaved) { <span class="text-muted" style="font-size:11px;">Guardado</span> }
                    <button class="modal-close" @onclick="CloseLead">&times;</button>
                </div>
            </div>
            <div class="pl-tabs">
                <button class="pl-tab @(_tab == "datos" ? "on" : "")" @onclick='() => _tab = "datos"'>Datos</button>
                <button class="pl-tab @(_tab == "chat" ? "on" : "")" @onclick='() => _tab = "chat"'>Chat</button>
                <button class="pl-tab @(_tab == "notas" ? "on" : "")" @onclick='() => _tab = "notas"'>Notas (@_notes.Count)</button>
                <button class="pl-tab @(_tab == "archivos" ? "on" : "")" @onclick='() => _tab = "archivos"'>Archivos (@_files.Count)</button>
                <button class="pl-tab @(_tab == "actividad" ? "on" : "")" @onclick='() => _tab = "actividad"'>Actividad (@_activities.Count)</button>
            </div>
            <div class="modal-body">
                @if (_tab == "datos")
                {
                    <div class="field"><label class="form-label">Nombre *</label>
                        <input class="form-control" @bind="_editLead.ContactName" />
                    </div>
                    <div class="field"><label class="form-label">Telefono</label>
                        <input class="form-control" @bind="_editLead.ContactPhone" />
                    </div>
                    <div class="field"><label class="form-label">Tema / producto</label>
                        <input class="form-control" @bind="_editLead.Topic" />
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 120px;gap:10px;">
                        <div class="field"><label class="form-label">Valor estimado</label>
                            <input class="form-control" type="number" step="0.01" @bind="_editLead.EstimatedValue" />
                        </div>
                        <div class="field"><label class="form-label">Moneda</label>
                            <input class="form-control" @bind="_editLead.Currency" />
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        <div class="field"><label class="form-label">Etapa</label>
                            <select class="form-control" @bind="_editLead.StageId">
                                @foreach (var s in _stages)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field"><label class="form-label">Asesor</label>
                            <select class="form-control" @bind="_editLead.AssignedToTenantUserId">
                                <option value="">Sin asignar</option>
                                @foreach (var u in _team)
                                {
                                    <option value="@u.Id">@TeamLabel(u)</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (_editStageIsLost)
                    {
                        <div class="field"><label class="form-label">Motivo de perdida</label>
                            <input class="form-control" @bind="_editLead.LossReason" />
                        </div>
                    }

                    @* Campos configurables de la etapa actual *@
                    @if (StageFieldsForEditLead.Count > 0)
                    {
                        <hr style="margin:16px 0 10px;" />
                        <h5 style="font-size:13px;color:var(--muted-foreground);margin:0 0 10px;">Campos de la etapa</h5>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                            @foreach (var f in StageFieldsForEditLead.OrderBy(x => x.SortOrder))
                            {
                                var colSpan = f.Column >= 2 ? "grid-column:1/-1;" : "";
                                var inputType = f.FieldType switch
                                {
                                    PipelineFieldType.Date => "text",
                                    PipelineFieldType.Number => "text",
                                    PipelineFieldType.Currency => "text",
                                    _ => "text"
                                };
                                var placeholder = f.FieldType == PipelineFieldType.Date ? "YYYY-MM-DD" : "";
                                <div class="field" style="@colSpan">
                                    <label class="form-label">@f.Label</label>
                                    @if (f.FieldType == PipelineFieldType.TextArea)
                                    {
                                        <textarea class="form-control" rows="3" @bind="_fieldValues[f.FieldKey]"></textarea>
                                    }
                                    else if (f.FieldType == PipelineFieldType.Select)
                                    {
                                        <select class="form-control" @bind="_fieldValues[f.FieldKey]">
                                            <option value=""></option>
                                            @foreach (var opt in (f.Options ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                    }
                                    else if (f.FieldType == PipelineFieldType.Separator)
                                    {
                                        <div class="pl-sep">@f.Label</div>
                                    }
                                    else
                                    {
                                        <input class="form-control" type="@inputType" placeholder="@placeholder" @bind="_fieldValues[f.FieldKey]" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(f.Description))
                                    {
                                        <div class="text-muted" style="font-size:11px;margin-top:4px;">@f.Description</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else if (_tab == "chat")
                {
                    <div style="margin:-20px;">
                        <ChatPanel LeadId="@_editLead.Id"
                                   ContactPhone="@_editLead.ContactPhone"
                                   ContactName="@_editLead.ContactName"
                                   TenantId="@_tenantId" />
                    </div>
                }
                else if (_tab == "notas")
                {
                    <div class="field">
                        <label class="form-label">Nueva nota</label>
                        <textarea class="form-control" rows="2" @bind="_newNote" placeholder="Observacion de seguimiento..."></textarea>
                        <div style="display:flex;gap:6px;margin-top:6px;align-items:center;">
                            <span class="text-muted" style="font-size:11px;">Color:</span>
                            @foreach (var color in new[] { "yellow", "green", "blue", "pink", "purple", "gray" })
                            {
                                <button class="pl-color-dot @(_newNoteColor == color ? "on" : "")"
                                        style="background:@NoteColorCss(color)"
                                        @onclick="() => _newNoteColor = color"
                                        title="@color"></button>
                            }
                            <button class="btn btn-sm btn-primary" style="margin-left:auto;" @onclick="AddNoteAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newNote))">Agregar</button>
                        </div>
                    </div>
                    <div style="margin-top:12px;">
                        @foreach (var n in _notes)
                        {
                            <div class="pl-note" style="background:@NoteColorCss(n.Color);">
                                <div class="pl-note-body">@n.Content</div>
                                <div class="pl-note-foot">
                                    <span>@(n.ActorName ?? "—") · @n.CreatedAt.LocalDateTime.ToString("dd MMM HH:mm")</span>
                                    <button class="pl-link" @onclick="() => DeleteNoteAsync(n.Id)">Borrar</button>
                                </div>
                            </div>
                        }
                        @if (_notes.Count == 0) { <div class="text-muted" style="font-size:12px;">Sin notas todavia.</div> }
                    </div>
                }
                else if (_tab == "archivos")
                {
                    <div class="field">
                        <label class="form-label">Adjuntar archivo</label>
                        <InputFile OnChange="OnLeadFileSelected" class="form-control" />
                    </div>
                    <div style="margin-top:10px;">
                        @foreach (var f in _files)
                        {
                            <div class="pl-file">
                                <a href="@f.Url" target="_blank">@f.FileName</a>
                                <span class="text-muted" style="font-size:11px;">@FormatBytes(f.SizeBytes) · @(f.ActorName ?? "—") · @f.CreatedAt.LocalDateTime.ToString("dd MMM HH:mm")</span>
                                <button class="pl-link" @onclick="() => DeleteFileAsync(f.Id)">Borrar</button>
                            </div>
                        }
                        @if (_files.Count == 0) { <div class="text-muted" style="font-size:12px;">Sin archivos todavia.</div> }
                    </div>
                }
                else if (_tab == "actividad")
                {
                    <div class="pl-timeline">
                        @foreach (var a in _activities)
                        {
                            <div class="pl-tl-row">
                                <div class="pl-tl-dot"></div>
                                <div style="flex:1;">
                                    <div class="pl-tl-type">@a.ActivityType</div>
                                    <div class="pl-tl-desc">@a.Description</div>
                                    <div class="pl-tl-meta">@(a.ActorName ?? "sistema") · @a.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                        @if (_activities.Count == 0) { <div class="text-muted" style="font-size:12px;">Sin actividad registrada.</div> }
                    </div>
                }
            </div>
            <div class="modal-foot" style="justify-content:space-between;">
                <button class="btn btn-outline-danger" @onclick="OpenArchiveFromDetail">Llevar a historial</button>
                <div style="display:flex;gap:6px;">
                    <button class="btn btn-outline-secondary" @onclick="CloseLead">Cerrar</button>
                    <button class="btn btn-primary" @onclick="SaveLeadAsync" disabled="@_busy">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Modal: archivar ===== *@
@if (_archiveLead is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:460px;">
            <div class="modal-head"><h3>Llevar a historial</h3>
                <button class="modal-close" @onclick="() => _archiveLead = null">&times;</button>
            </div>
            <div class="modal-body">
                <p style="font-size:13px;">Vas a mover <strong>@_archiveLead.ContactName</strong> al historial. Deja de contar en el embudo pero queda consultable.</p>
                <div class="field"><label class="form-label">Motivo</label>
                    <select class="form-control" @bind="_archiveReason">
                        <option value="">Selecciona...</option>
                        <option value="Ya compro">Ya compro</option>
                        <option value="No interesado">No interesado</option>
                        <option value="Duplicado">Duplicado</option>
                        <option value="Spam">Spam / contacto erroneo</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="field"><label class="form-label">Observacion (opcional)</label>
                    <textarea class="form-control" rows="2" @bind="_archiveNote"></textarea>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _archiveLead = null">Cancelar</button>
                <button class="btn btn-primary" @onclick="ConfirmArchiveAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_archiveReason))">Confirmar</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: historial ===== *@
@if (_historyOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:900px;">
            <div class="modal-head"><h3>Historial del embudo</h3>
                <button class="modal-close" @onclick="() => _historyOpen = false">&times;</button>
            </div>
            <div class="modal-body" style="max-height:60vh;overflow:auto;">
                @if (_history.Count == 0)
                {
                    <p class="text-muted">No hay leads en el historial.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead><tr><th>Contacto</th><th>Tema</th><th>Valor</th><th>Motivo</th><th>Archivado</th><th>Por</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var h in _history)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:600;">@h.ContactName</div>
                                        <div class="text-muted" style="font-size:11px;">@h.ContactPhone</div>
                                    </td>
                                    <td>@h.Topic</td>
                                    <td>@(h.EstimatedValue is decimal v ? FormatMoney(v, h.Currency) : "—")</td>
                                    <td>
                                        <div>@h.ArchiveReason</div>
                                        @if (!string.IsNullOrWhiteSpace(h.ArchiveNote))
                                        { <div class="text-muted" style="font-size:11px;">@h.ArchiveNote</div> }
                                    </td>
                                    <td style="font-size:12px;">@h.ArchivedAt?.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                    <td style="font-size:12px;">@h.ArchivedByName</td>
                                    <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => RestoreAsync(h.Id)">Restaurar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-foot" style="justify-content:space-between;">
                @if (_canPurge && _history.Count > 0)
                {
                    <button class="btn btn-outline-danger" @onclick="PurgeHistoryAsync" disabled="@_busy">Vaciar historial (destructivo)</button>
                }
                else { <span></span> }
                <button class="btn btn-outline-secondary" @onclick="() => _historyOpen = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: configurar embudo (pipelines + stages + fields) ===== *@
@if (_configOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:900px;">
            <div class="modal-head"><h3>Configurar embudos</h3>
                <button class="modal-close" @onclick="() => _configOpen = false">&times;</button>
            </div>
            <div class="modal-body" style="max-height:70vh;overflow:auto;">
                @* === Pipelines === *@
                <h4 style="margin-top:0;">Embudos</h4>
                <div style="display:flex;gap:8px;margin-bottom:12px;">
                    <input class="form-control" placeholder="Nombre del nuevo embudo..." @bind="_newPipelineName" style="flex:1;" />
                    <button class="btn btn-primary" @onclick="CreatePipelineAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newPipelineName))">+ Agregar</button>
                </div>
                <div class="pl-cfg-list">
                    @foreach (var p in _pipelines)
                    {
                        <div class="pl-cfg-item">
                            <input class="form-control pl-cfg-name" @bind="p.NameEdit" />
                            @if (p.IsSystem) { <span class="text-muted" style="font-size:11px;">(sistema)</span> }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => RenamePipelineAsync(p)">Guardar</button>
                            @if (!p.IsSystem)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePipelineAsync(p.Id)" title="Solo si no tiene leads">Borrar</button>
                            }
                        </div>
                    }
                </div>

                @* === Stages del pipeline actual === *@
                <hr style="margin:16px 0;" />
                <h4>Etapas de <em>@_currentPipeline?.Name</em></h4>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 100px;gap:8px;align-items:center;margin-bottom:12px;">
                    <input class="form-control" placeholder="Nombre de etapa..." @bind="_newStageName" />
                    <label style="display:flex;gap:4px;font-size:12px;"><input type="checkbox" @bind="_newStageWon" /> Ganado</label>
                    <label style="display:flex;gap:4px;font-size:12px;"><input type="checkbox" @bind="_newStageLost" /> Perdido</label>
                    <button class="btn btn-primary" @onclick="CreateStageAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newStageName) || _currentPipeline is null)">+ Agregar</button>
                </div>
                <div class="pl-cfg-list">
                    @foreach (var s in _stages)
                    {
                        <div class="pl-cfg-item" style="flex-wrap:wrap;">
                            <input class="form-control pl-cfg-name" @bind="s.NameEdit" />
                            <label style="display:flex;gap:4px;font-size:12px;"><input type="checkbox" @bind="s.IsClosedWon" /> Ganado</label>
                            <label style="display:flex;gap:4px;font-size:12px;"><input type="checkbox" @bind="s.IsClosedLost" /> Perdido</label>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateStageAsync(s)">Guardar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteStageAsync(s.Id)" title="Solo si no tiene leads">Borrar</button>
                            @{
                                var stageFields = _fields.Where(f => f.StageId == s.Id).OrderBy(f => f.SortOrder).ToList();
                            }
                            <div style="width:100%;margin-top:6px;margin-left:12px;padding-left:12px;border-left:2px solid var(--border);">
                                <div style="font-size:11px;color:var(--muted-foreground);margin-bottom:6px;">Campos (@stageFields.Count)</div>
                                @foreach (var f in stageFields)
                                {
                                    <div style="display:grid;grid-template-columns:1fr 120px 80px auto;gap:6px;margin-bottom:4px;align-items:center;">
                                        <input class="form-control" style="font-size:12px;" @bind="f.LabelEdit" />
                                        <select class="form-control" style="font-size:11px;" @bind="f.FieldType">
                                            @foreach (var ft in Enum.GetValues<PipelineFieldType>())
                                            { <option value="@ft">@ft</option> }
                                        </select>
                                        <select class="form-control" style="font-size:11px;" @bind="f.Column">
                                            <option value="1">Col 1</option>
                                            <option value="2">Ancha</option>
                                        </select>
                                        <div style="display:flex;gap:4px;">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateFieldAsync(f)">💾</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFieldAsync(f.Id)">🗑</button>
                                        </div>
                                    </div>
                                    @if (f.FieldType == PipelineFieldType.Select)
                                    {
                                        <input class="form-control" style="font-size:11px;margin-bottom:6px;margin-left:0;" @bind="f.Options" placeholder="Opciones (una por linea, usa \n)" />
                                    }
                                }
                                <div style="display:grid;grid-template-columns:1fr 100px auto;gap:6px;margin-top:6px;">
                                    <input class="form-control" style="font-size:11px;" placeholder="Nuevo campo (etiqueta)..." @bind="_newFieldLabels[s.Id]" />
                                    <select class="form-control" style="font-size:11px;" @bind="_newFieldTypes[s.Id]">
                                        @foreach (var ft in Enum.GetValues<PipelineFieldType>())
                                        { <option value="@ft">@ft</option> }
                                    </select>
                                    <button class="btn btn-sm btn-primary" @onclick="() => CreateFieldAsync(s.Id)" disabled="@_busy">+ Campo</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _configOpen = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ===== Modal: nuevo embudo (desde el index) ===== *@
@if (_newPipelineOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:460px;">
            <div class="modal-head"><h3>Nuevo embudo</h3>
                <button class="modal-close" @onclick="() => { _newPipelineOpen = false; _newPipelineName = string.Empty; }">&times;</button>
            </div>
            <div class="modal-body">
                <p style="font-size:13px;color:var(--muted-foreground);margin-top:0;">Cada embudo tiene sus propias etapas, campos y leads. Despues de crearlo podras configurarlo desde su propio tablero.</p>
                <div class="field"><label class="form-label">Nombre del embudo *</label>
                    <input class="form-control" @bind="_newPipelineName" placeholder="Ej: Ventas corporativas" autofocus />
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => { _newPipelineOpen = false; _newPipelineName = string.Empty; }">Cancelar</button>
                <button class="btn btn-primary" @onclick="CreatePipelineAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newPipelineName))">Crear embudo</button>
            </div>
        </div>
    </div>
}

<style>
    .pl-empty { padding:40px 20px; text-align:center; background:var(--muted); border-radius:10px; margin:20px 0; }

    /* Grid de embudos: cada uno vive en su propia tarjeta, independiente. */
    .pl-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px; margin:16px 0 24px; }
    .pl-card-pipe { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:16px; cursor:pointer; transition:border-color .15s, box-shadow .15s, transform .15s; display:flex; flex-direction:column; gap:12px; }
    .pl-card-pipe:hover { border-color:var(--primary); box-shadow:0 4px 16px rgba(160,61,201,0.08); transform:translateY(-2px); }
    .pl-card-pipe-head { display:flex; align-items:center; gap:10px; }
    .pl-card-pipe-icon { width:40px; height:40px; border-radius:10px; background:linear-gradient(135deg, oklch(0.62 0.19 310 / 0.12), oklch(0.6 0.22 345 / 0.12)); display:flex; align-items:center; justify-content:center; color:var(--primary); flex-shrink:0; }
    .pl-card-pipe-icon svg { width:22px; height:22px; }
