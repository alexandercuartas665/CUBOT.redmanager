    .pl-filters { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:14px; margin-bottom:12px; }
    .pl-filt-group { margin-bottom:10px; }
    .pl-filt-lbl { font-size:11px; color:var(--muted-foreground); margin-bottom:4px; }
    .pl-chips { display:flex; gap:6px; flex-wrap:wrap; }
