@page "/dashboard"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@inject IClientService ClientsSvc
@inject ISocialAccountService AccountsSvc
@inject IPublicationService PubsSvc
@inject IInboxService InboxSvc

<PageTitle>Dashboard - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <span>Operacion diaria</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Dashboard</h1>
        <p class="page-sub" style="margin-bottom:0;">Salud operativa de la agencia: clientes, cuentas conectadas, publicaciones y bandeja.</p>
    </div>
</div>

@if (_loading)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div></div>
            <div class="kpi-label">Clientes activos</div>
            <div class="kpi-value">@_activeClients</div>
            <div class="kpi-hint">de @_totalClients marcas</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div></div>
            <div class="kpi-label">Cuentas conectadas</div>
            <div class="kpi-value">@_connected</div>
            <div class="kpi-hint">@_expiring por expirar</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg></div></div>
            <div class="kpi-label">Publicaciones programadas</div>
            <div class="kpi-value">@_scheduled</div>
            <div class="kpi-hint">@_published publicadas</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></div></div>
            <div class="kpi-label">Mensajes sin responder</div>
            <div class="kpi-value">@_unread</div>
            <div class="kpi-hint">en la bandeja unificada</div>
        </div>
    </div>

    <div class="dash-cols">
        <div class="dash-card">
            <div class="dash-title">Cuentas por red</div>
            @if (_byNetwork.Count == 0)
            {
                <div class="text-muted" style="font-size:13px;">Sin cuentas conectadas.</div>
            }
            else
            {
                @foreach (var n in _byNetwork)
                {
                    <div class="dash-row"><span>@n.Key</span><strong>@n.Value</strong></div>
                }
            }
        </div>
        <div class="dash-card">
            <div class="dash-title">Publicaciones por estado</div>
            @foreach (var s in Enum.GetValues<PublicationStatus>())
            {
                <div class="dash-row"><span>@PubLabel(s)</span><strong>@(_pubByStatus.TryGetValue(s, out var v) ? v : 0)</strong></div>
            }
        </div>
    </div>
}

<style>
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; max-width: 1040px; }
    .kpi-card { background: var(--card); border: 1px solid var(--border); border-radius: 1.25rem; padding: 18px 20px; box-shadow: var(--shadow-soft); }
    .kpi-top { display: flex; align-items: flex-start; justify-content: space-between; }
    .kpi-icon { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; }
    .kpi-icon svg { width: 18px; height: 18px; }
    .kpi-icon.tone-primary { background: var(--primary-soft); color: var(--primary); }
    .kpi-icon.tone-gold { background: oklch(0.78 0.14 70 / 0.16); color: var(--gold-foreground); }
    .kpi-icon.tone-success { background: oklch(0.62 0.16 155 / 0.15); color: var(--success); }
    .kpi-icon.tone-danger { background: oklch(0.6 0.22 22 / 0.10); color: var(--destructive); }
    .kpi-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); font-weight: 700; margin-top: 14px; }
    .kpi-value { font-size: 2rem; font-weight: 800; line-height: 1.1; }
    .kpi-hint { font-size: 11px; color: var(--muted-foreground); }
    .dash-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; max-width: 1040px; margin-top: 22px; }
    .dash-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; box-shadow: var(--shadow-soft); }
    .dash-title { font-weight: 700; font-size: 14px; margin-bottom: 10px; }
    .dash-row { display: flex; align-items: center; justify-content: space-between; font-size: 13px; padding: 5px 0; border-bottom: 1px solid var(--border); }
    .dash-row:last-child { border-bottom: none; }
    .dash-row span { color: var(--muted-foreground); }
</style>

@code {
    private bool _loading = true;
    private int _totalClients, _activeClients, _connected, _expiring, _scheduled, _published, _unread;
    private Dictionary<string, int> _byNetwork = new();
    private Dictionary<PublicationStatus, int> _pubByStatus = new();

    protected override async Task OnInitializedAsync()
    {
        var clients = await ClientsSvc.ListAsync();
        _totalClients = clients.Count;
        _activeClients = clients.Count(c => c.IsActive);

        var accounts = await AccountsSvc.ListAsync();
        _connected = accounts.Count(a => a.Status == SocialAccountStatus.Connected);
        _expiring = accounts.Count(a => a.ExpiringSoon);
        _byNetwork = accounts.Where(a => a.Status == SocialAccountStatus.Connected)
            .GroupBy(a => a.NetworkDisplay).ToDictionary(g => g.Key, g => g.Count());

        var pubs = await PubsSvc.ListAsync();
        _scheduled = pubs.Count(p => p.Status == PublicationStatus.Scheduled);
        _published = pubs.Count(p => p.Status == PublicationStatus.Published);
        _pubByStatus = pubs.GroupBy(p => p.Status).ToDictionary(g => g.Key, g => g.Count());

        _unread = await InboxSvc.UnreadCountAsync();
        _loading = false;
    }

    private static string PubLabel(PublicationStatus s) => s switch
    {
        PublicationStatus.Draft => "Borrador",
        PublicationStatus.Approved => "Aprobada",
        PublicationStatus.Scheduled => "Programada",
        PublicationStatus.Published => "Publicada",
        _ => "Fallida"
    };
}
