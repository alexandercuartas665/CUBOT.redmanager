@page "/clientes"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using System.Security.Claims
@using CubotRedManager.Application.Tenancy
@inject IClientService ClientsSvc
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Clientes (Marcas) - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span>Clientes y cuentas</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Clientes (Marcas)</h1>
        <p class="page-sub" style="margin-bottom:0;">Cartera de marcas que la agencia gestiona. Contacto, industria, marca blanca y operadores asignados.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreate">+ Nuevo cliente</button>
</div>

@if (_clients is null)
{
    <p class="text-muted">Cargando...</p>
}
else if (_clients.Count == 0)
{
    <div class="coming-soon">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <h3>Sin clientes todavia</h3>
        <p>Crea la primera marca que gestiona esta agencia.</p>
    </div>
}
else
{
    <div class="cl-grid">
        @foreach (var c in _clients)
        {
            <div class="cl-card @(c.IsActive ? "" : "off")">
                <div class="cl-top">
                    <div class="cl-logo">@Initials(c.Name)</div>
                    <div style="flex:1;min-width:0;">
                        <div class="cl-name">@c.Name</div>
                        <div class="cl-ind">@(string.IsNullOrWhiteSpace(c.Industry) ? "Sin industria" : c.Industry)</div>
                    </div>
                    @if (!c.IsActive)
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </div>
                <div class="cl-rows">
                    <div><span>Contacto</span><strong>@(c.ContactName ?? "—")</strong></div>
                    <div><span>Correo</span><strong>@(c.ContactEmail ?? "—")</strong></div>
                    <div><span>Operadores</span><strong>@c.AssignedOperatorCount</strong></div>
                </div>
                <div class="cl-actions">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(c)">Editar</button>
                    @if (c.IsActive)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetActive(c, false)">Desactivar</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => SetActive(c, true)">Activar</button>
                    }
                </div>
            </div>
        }
    </div>
}

@if (_modalOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog">
            <div class="modal-head">
                <h3>@(_editingId is null ? "Nuevo cliente" : "Editar cliente")</h3>
                <button class="modal-close" @onclick="() => _modalOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field"><label class="form-label">Nombre de la marca</label><input class="form-control" @bind="_f.Name" /></div>
                <div class="field-row">
                    <div class="field"><label class="form-label">Contacto</label><input class="form-control" @bind="_f.ContactName" /></div>
                    <div class="field"><label class="form-label">Industria</label><input class="form-control" @bind="_f.Industry" /></div>
                </div>
                <div class="field-row">
                    <div class="field"><label class="form-label">Correo</label><input class="form-control" @bind="_f.ContactEmail" /></div>
                    <div class="field"><label class="form-label">Telefono</label><input class="form-control" @bind="_f.ContactPhone" /></div>
                </div>
                <div class="field"><label class="form-label">Zona horaria</label><input class="form-control" @bind="_f.TimeZone" placeholder="ej. America/Bogota" /></div>
                <div class="field"><label class="form-label">Manual de marca (tono)</label><textarea class="form-control" rows="2" @bind="_f.BrandToneNotes" placeholder="Voz, do/don't, prohibiciones..."></textarea></div>
                <div class="field"><label class="form-label">Notas</label><textarea class="form-control" rows="2" @bind="_f.Notes"></textarea></div>
                @if (_error is not null)
                {
                    <div class="text-danger small">@_error</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _modalOpen = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_f.Name))">@(_editingId is null ? "Crear" : "Guardar")</button>
            </div>
        </div>
    </div>
}

<style>
    .cl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; max-width: 1100px; }
    .cl-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; box-shadow: var(--shadow-soft); display: flex; flex-direction: column; }
    .cl-card.off { opacity: .65; }
    .cl-top { display: flex; align-items: center; gap: 12px; }
    .cl-logo { width: 42px; height: 42px; flex: none; border-radius: 11px; background: var(--gradient-violet); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
    .cl-name { font-weight: 700; font-size: 15px; }
    .cl-ind { font-size: 12px; color: var(--muted-foreground); }
    .cl-rows { margin-top: 12px; display: flex; flex-direction: column; gap: 5px; }
    .cl-rows > div { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12.5px; }
    .cl-rows span { color: var(--muted-foreground); }
    .cl-actions { margin-top: 14px; display: flex; gap: 8px; }
    .field { margin-bottom: 14px; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
</style>

@code {
    private List<ClientDto>? _clients;
    private bool _modalOpen;
    private Guid? _editingId;
    private bool _busy;
    private string? _error;
    private Guid _actor;
    private readonly Form _f = new();

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _actor);
        await Reload();
    }

    private async Task Reload() => _clients = (await ClientsSvc.ListAsync()).ToList();

    private void OpenCreate() { _editingId = null; _error = null; _f.Reset(); _modalOpen = true; }

    private void OpenEdit(ClientDto c)
    {
        _editingId = c.Id; _error = null;
        _f.Name = c.Name; _f.ContactName = c.ContactName; _f.ContactEmail = c.ContactEmail; _f.ContactPhone = c.ContactPhone;
        _f.Industry = c.Industry; _f.TimeZone = c.TimeZone; _f.BrandToneNotes = c.BrandToneNotes; _f.Notes = c.Notes;
        _f.BrandLogoUrl = c.BrandLogoUrl; _f.BrandColorsJson = c.BrandColorsJson;
        _modalOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null; _busy = true;
        try
        {
            if (_editingId is Guid id)
            {
                await ClientsSvc.UpdateAsync(id, new UpdateClientRequest(_f.Name, _f.ContactName, _f.ContactEmail, _f.ContactPhone,
                    _f.Industry, _f.TimeZone, _f.BrandLogoUrl, _f.BrandColorsJson, _f.BrandToneNotes, _f.Notes), _actor);
            }
            else
            {
                var dto = await ClientsSvc.CreateAsync(new CreateClientRequest(_f.Name, _f.ContactName, _f.ContactEmail, _f.ContactPhone,
                    _f.Industry, _f.TimeZone, _f.BrandToneNotes, _f.Notes), _actor);
                if (dto is null) { _error = "No hay agencia activa."; return; }
            }
            _modalOpen = false;
            await Reload();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetActive(ClientDto c, bool active)
    {
        await ClientsSvc.SetActiveAsync(c.Id, active, _actor);
        await Reload();
    }

    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private sealed class Form
    {
        public string Name { get; set; } = "";
        public string? ContactName { get; set; }
        public string? ContactEmail { get; set; }
        public string? ContactPhone { get; set; }
        public string? Industry { get; set; }
        public string? TimeZone { get; set; }
        public string? BrandToneNotes { get; set; }
        public string? Notes { get; set; }
        public string? BrandLogoUrl { get; set; }
        public string? BrandColorsJson { get; set; }
        public void Reset() { Name = ""; ContactName = ContactEmail = ContactPhone = Industry = TimeZone = BrandToneNotes = Notes = BrandLogoUrl = BrandColorsJson = null; }
    }
}
