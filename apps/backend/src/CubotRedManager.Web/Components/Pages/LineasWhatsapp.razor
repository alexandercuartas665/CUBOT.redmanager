@page "/lineas-whatsapp"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@implements IDisposable
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@using CubotRedManager.Web.Components
@inject IWhatsAppLineService LinesSvc
@inject IWhatsAppConnectorService Connector
@inject IWebhookAdminService WebhookSvc
@inject IYCloudApiClient YCloud
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Lineas WhatsApp - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
            </div>
            <span>Comunicacion e IA</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Lineas WhatsApp</h1>
        <p class="page-sub" style="margin-bottom:0;">Lineas WhatsApp de la agencia. Soporta Evolution (QR), Meta Cloud API oficial y YCloud (BSP con coexistencia).</p>
    </div>
    <button class="btn btn-primary" @onclick="() => _showCreate = true"
            disabled="@(_server is { MasterReady: false, UseMasterServer: true })"
            title="@(_server is { MasterReady: false, UseMasterServer: true } ? "El servidor maestro Evolution aun no esta configurado por el operador. Elige 'Mi propio servidor' o pide al operador que lo configure." : null)">Nueva linea</button>
</div>

@if (_loading)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    @* ===== Acordeon "Avanzado" que agrupa configuracion de Servidor + Webhook ===== *@
    <details class="cfg-accordion" style="max-width:1040px;margin-bottom:22px;">
        <summary class="cfg-accordion-summary">
            <svg class="cfg-accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;"><polyline points="9 18 15 12 9 6"/></svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Avanzado</span>
            <span class="text-muted" style="font-size:11.5px;font-weight:400;">Servidor y webhook de Evolution API</span>
        </summary>

        @* ===== Servidor Evolution (plataforma / propio) ===== *@
        <div class="card" style="max-width:1040px;padding:20px 22px;margin:16px 0;">
            <div style="font-weight:700;margin-bottom:4px;">Servidor de WhatsApp</div>
            <div class="text-muted" style="font-size:12px;margin-bottom:14px;">Usa el servidor de la plataforma o conecta tu propio servidor Evolution API.</div>

            <div style="display:flex;flex-direction:column;gap:8px;max-width:620px;">
                <label class="cfg-row" style="cursor:pointer;gap:10px;">
                    <input type="radio" name="srv" checked="@_useMaster" @onchange="@(() => _useMaster = true)" />
                    <div class="grow">
                        <div style="font-weight:600;font-size:13px;">Servidor de la plataforma (CUBOT)</div>
                        <div class="text-muted" style="font-size:11px;">
                            @if (_server?.MasterReady == true) { <text>Listo: @_server.MasterBaseUrl</text> }
                            else { <text>El operador aun no ha configurado el servidor maestro.</text> }
                        </div>
                    </div>
                </label>
                <label class="cfg-row" style="cursor:pointer;gap:10px;">
                    <input type="radio" name="srv" checked="@(!_useMaster)" @onchange="@(() => _useMaster = false)" />
                    <div class="grow">
                        <div style="font-weight:600;font-size:13px;">Mi propio servidor Evolution</div>
                        <div class="text-muted" style="font-size:11px;">Configura la URL y la API key de tu servidor.</div>
                    </div>
                </label>
            </div>

            @if (!_useMaster)
            {
                <div class="field-row" style="max-width:620px;margin-top:12px;">
                    <div class="field">
                        <label class="form-label">URL del servidor</label>
                        <input class="form-control" @bind="_ownUrl" placeholder="https://mi-evolution.com" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label class="form-label">API key</label>
                        <input class="form-control" type="password" @bind="_ownToken" autocomplete="new-password" placeholder="@(_server?.HasOwnToken == true ? "Dejar vacio para conservar" : "")" />
                    </div>
                </div>
            }

            @if (_serverMsg is not null)
            {
                <div class="@(_serverOk ? "text-success" : "text-danger")" style="font-size:12px;margin-top:10px;">@_serverMsg</div>
            }
            <button class="btn btn-outline-secondary" style="margin-top:12px;" @onclick="SaveServerAsync" disabled="@_busy">Guardar servidor</button>
        </div>

        @* ===== Webhook entrante (mensajes en caliente) ===== *@
        @if (_webhook is not null)
        {
            <div class="card" style="max-width:1040px;padding:20px 22px;margin:16px 0;">
                <div style="font-weight:700;margin-bottom:4px;">Mensajes entrantes (webhook)</div>
                <div class="text-muted" style="font-size:12px;margin-bottom:14px;">Para recibir respuestas de los clientes en vivo. En desarrollo se levanta un tunel; en produccion se usa la URL de tu dominio.</div>

                <div style="display:flex;flex-direction:column;gap:8px;max-width:620px;">
                    <label class="cfg-row" style="cursor:pointer;gap:10px;">
                        <input type="radio" name="whmode" checked="@(_whMode == "Development")" @onchange="@(() => _whMode = "Development")" />
                        <div class="grow">
                            <div style="font-weight:600;font-size:13px;">Modo desarrollo (tunel)</div>
                            <div class="text-muted" style="font-size:11px;">La app levanta un tunel cloudflared y expone el webhook temporalmente.</div>
                        </div>
                    </label>
                    <label class="cfg-row" style="cursor:pointer;gap:10px;">
                        <input type="radio" name="whmode" checked="@(_whMode == "Production")" @onchange="@(() => _whMode = "Production")" />
                        <div class="grow">
                            <div style="font-weight:600;font-size:13px;">Produccion (URL fija)</div>
                            <div class="text-muted" style="font-size:11px;">Usa la URL publica de tu dominio (ej. https://app.cubot.com.co).</div>
                        </div>
                    </label>
                </div>

                <div class="field-row" style="max-width:620px;margin-top:12px;">
                    @if (_whMode == "Production")
                    {
                        <div class="field">
                            <label class="form-label">URL publica</label>
                            <input class="form-control" @bind="_whPublicUrl" placeholder="https://app.cubot.com.co" autocomplete="off" />
                        </div>
                    }
                    <div class="field">
                        <label class="form-label">Token del webhook</label>
                        <input class="form-control" @bind="_whToken" placeholder="Se genera si lo dejas vacio" autocomplete="off" />
                    </div>
                </div>

                <div style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap;">
                    <button class="btn btn-outline-secondary" @onclick="SaveWebhookAsync" disabled="@_busy">Guardar webhook</button>
                    @if (_whMode == "Development")
                    {
                        @if (_webhook.TunnelRunning)
                        {
                            <button class="btn btn-outline-danger" @onclick="StopTunnelAsync" disabled="@_busy">Detener tunel</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="StartTunnelAsync" disabled="@_busy">Iniciar tunel</button>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(_webhook.EffectiveUrl))
                    {
                        <span class="badge bg-success">Escuchando</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Sin URL activa</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_webhook.EffectiveUrl))
                {
                    <div class="text-muted" style="font-size:11px;margin-top:8px;word-break:break-all;">Webhook activo: @_webhook.EffectiveUrl</div>
                }
                @if (_whMsg is not null)
                {
                    <div class="@(_whOk ? "text-success" : "text-danger")" style="font-size:12px;margin-top:8px;">@_whMsg</div>
                }
            </div>
        }
    </details>

    @* ===== KPIs — Lineas totales / Conectadas / Pendientes ===== *@
    <div class="kpi-grid" style="margin-bottom:22px;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));max-width:820px;">
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg></div></div>
            <div class="kpi-label">Lineas</div>
            <div class="kpi-value">@_lines.Count</div>
            <div class="kpi-hint">Total registradas</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg></div></div>
            <div class="kpi-label">Conectadas</div>
            <div class="kpi-value">@_lines.Count(l => l.Status == WhatsAppLineStatus.Connected)</div>
            <div class="kpi-hint">En linea</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-top"><div class="kpi-icon tone-gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div></div>
            <div class="kpi-label">Pendientes</div>
            <div class="kpi-value">@_lines.Count(l => l.Status is WhatsAppLineStatus.Connecting or WhatsAppLineStatus.Created)</div>
            <div class="kpi-hint">Por conectar</div>
        </div>
    </div>
}

@if (_loading)
{
}
else if (_lines.Count == 0)
{
    <div class="coming-soon">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>
        </div>
        <h3>Sin lineas todavia</h3>
        <p>Crea la primera linea de WhatsApp para esta agencia. Recomendamos YCloud para evitar bloqueos.</p>
    </div>
}
else
{
    <div class="line-grid">
        @foreach (var l in _lines)
        {
            <div class="line-card">
                <div class="line-top">
                    <div>
                        <span class="line-name">@l.InstanceName</span>
                        <span class="line-provider p-@l.Provider.ToString().ToLowerInvariant()">@ProviderLabel(l.Provider)</span>
                    </div>
                    <span class="line-badge s-@l.Status.ToString().ToLowerInvariant()">@StatusLabel(l.Status)</span>
                </div>
                <div class="line-phone">
                    @if (l.Provider == WhatsAppProvider.YCloud && !string.IsNullOrEmpty(l.YCloudPhoneNumberId))
                    {
                        <span>@l.YCloudPhoneNumberId</span>
                    }
                    else if (l.Provider == WhatsAppProvider.Cloud && !string.IsNullOrEmpty(l.CloudPhoneNumberId))
                    {
                        <span>PhoneNumberId: @l.CloudPhoneNumberId</span>
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(l.PhoneNumber) ? "Sin numero" : l.PhoneNumber)</span>
                    }
                </div>
                @if (l.Provider == WhatsAppProvider.YCloud && !string.IsNullOrEmpty(l.YCloudWabaId))
                {
                    <div class="line-meta">WABA: @l.YCloudWabaId</div>
                }
                @if (l.LastConnectedAt is DateTimeOffset lc)
                {
                    <div class="line-meta">Ultima conexion: @lc.LocalDateTime.ToString("dd MMM HH:mm")</div>
                }
                <div class="line-actions">
                    @if (l.Status == WhatsAppLineStatus.Connected)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => OpenTest(l)" disabled="@_busy">Probar envio</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => RefreshAsync(l.Id)" disabled="@_busy">Actualizar</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Disconnect(l)" disabled="@_busy">Desconectar</button>
                    }
                    else if (l.Provider == WhatsAppProvider.Evolution)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => ConnectEvolution(l)" disabled="@_busy">Conectar (QR)</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => RefreshAsync(l.Id)" disabled="@_busy">Actualizar</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => ChangeStatus(l, WhatsAppLineStatus.Connected)" disabled="@_busy">Marcar conectada</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => RefreshAsync(l.Id)" disabled="@_busy">Actualizar</button>
                    }
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(l)" disabled="@_busy">Eliminar</button>
                </div>
            </div>
        }
    </div>
}

@if (_qrLine is not null)
{
    <div class="modal-overlay" @onclick="CloseQrModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Conectar @_qrLine.InstanceName por QR</h3>
                <button class="modal-close" @onclick="CloseQrModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="qr-wrap">
                    @if (_qrLine.Status == WhatsAppLineStatus.Connected)
                    {
                        <div style="font-size:48px;color:var(--success);">OK</div>
                        <div class="qr-hint"><strong>Linea conectada.</strong> Puedes cerrar este modal.</div>
                    }
                    else if (_qrBusy && string.IsNullOrEmpty(_qrBase64))
                    {
                        <div class="qr-hint" style="padding:32px 0;">Preparando la instancia en Evolution...</div>
                    }
                    else if (!string.IsNullOrEmpty(_qrBase64))
                    {
                        <img class="qr-img" src="@QrSrc(_qrBase64)" alt="QR de conexion" />
                        <div class="qr-hint">
                            Abre <strong>WhatsApp</strong> en tu celular &rarr; <strong>Dispositivos vinculados</strong> &rarr;
                            <strong>Vincular un dispositivo</strong> y escanea este codigo. El estado se
                            verifica automaticamente cada 3 segundos.
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_qrError))
                    {
                        <div class="check-msg err">@_qrError</div>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseQrModal">Cerrar</button>
                <button class="btn btn-outline-primary" @onclick="RefreshQrLine" disabled="@_qrBusy">
                    @(_qrBusy ? "Verificando..." : "Verificar estado")
                </button>
                <button class="btn btn-primary" @onclick="() => OpenQrForAsync(_qrLine!)" disabled="@_qrBusy">Regenerar QR</button>
            </div>
        </div>
    </div>
}

@if (_testOpen)
{
    <div class="modal-overlay" @onclick="() => _testOpen = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Probar envio &mdash; @_testLineName</h3>
                <button class="modal-close" @onclick="() => _testOpen = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Numero destino <small>(formato internacional sin +)</small></label>
                    <input class="form-control" @bind="_testPhone" autocomplete="off" placeholder="573001234567" />
                </div>
                <div class="field">
                    <label class="form-label">Mensaje</label>
                    <textarea class="form-control" rows="3" @bind="_testText"></textarea>
                </div>
                @if (_testMsg is not null)
                {
                    <div class="@(_testOk ? "text-success" : "text-danger")" style="font-size:0.85rem;">@_testMsg</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _testOpen = false">Cerrar</button>
                <button class="btn btn-primary" @onclick="SendTestAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_testPhone))">Enviar</button>
            </div>
        </div>
    </div>
}

@if (_deleteLineId is not null)
{
    <div class="modal-overlay" @onclick="() => { _deleteLineId = null; _err = null; }">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Eliminar linea</h3>
                <button class="modal-close" @onclick="() => { _deleteLineId = null; _err = null; }">&times;</button>
            </div>
            <div class="modal-body">
                <p>Vas a eliminar la linea <strong>@_deleteLineName</strong>. Se cerrara su sesion en WhatsApp y se quitara de la lista. Esta accion no se puede deshacer.</p>
                @if (!string.IsNullOrEmpty(_err))
                {
                    <div class="check-msg err">@_err</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => { _deleteLineId = null; _err = null; }">Cancelar</button>
                <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_busy">@(_busy ? "Eliminando..." : "Eliminar")</button>
            </div>
        </div>
    </div>
}

@if (_showCreate)
{
    <div class="modal-overlay" @onclick="() => _showCreate = false">
        <div class="modal-dialog wide" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Nueva linea WhatsApp</h3>
                <button class="modal-close" @onclick="() => _showCreate = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Proveedor</label>
                    <div class="provider-choice">
                        <label class="prov-opt @(_newProvider == WhatsAppProvider.YCloud ? "on" : "")">
                            <input type="radio" name="prov" checked="@(_newProvider == WhatsAppProvider.YCloud)" @onchange="() => _newProvider = WhatsAppProvider.YCloud" />
                            <div>
                                <strong>YCloud <span class="badge-reco">recomendado</span></strong>
                                <small>BSP oficial con coexistencia. WhatsApp Business App + API en el mismo numero.</small>
                            </div>
                        </label>
                        <label class="prov-opt @(_newProvider == WhatsAppProvider.Cloud ? "on" : "")">
                            <input type="radio" name="prov" checked="@(_newProvider == WhatsAppProvider.Cloud)" @onchange="() => _newProvider = WhatsAppProvider.Cloud" />
                            <div>
                                <strong>Meta Cloud API</strong>
                                <small>API oficial de Meta (developers.facebook.com). Rompe la app oficial en el celular.</small>
                            </div>
                        </label>
                        <label class="prov-opt @(_newProvider == WhatsAppProvider.Evolution ? "on" : "")">
                            <input type="radio" name="prov" checked="@(_newProvider == WhatsAppProvider.Evolution)" @onchange="() => _newProvider = WhatsAppProvider.Evolution" />
                            <div>
                                <strong>Evolution (QR)</strong>
                                <small>Conexion no oficial via QR. Riesgo de bloqueo por Meta.</small>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Nombre de la linea</label>
                    <input class="form-control" @bind="_newName" placeholder="ej. ventas-marca-x" />
                </div>

                @if (_newProvider == WhatsAppProvider.Evolution)
                {
                    <div class="field">
                        <label class="form-label">Numero (opcional)</label>
                        <input class="form-control" @bind="_newPhone" placeholder="ej. +57..." />
                    </div>
                }

                @if (_newProvider == WhatsAppProvider.Cloud)
                {
                    <div class="field">
                        <label class="form-label">Phone Number ID (Meta)</label>
                        <input class="form-control" @bind="_cloudPhoneId" placeholder="ej. 106540...." />
                    </div>
                    <div class="field">
                        <label class="form-label">WhatsApp Business Account ID</label>
                        <input class="form-control" @bind="_cloudWabaId" placeholder="ej. 175201...." />
                    </div>
                    <div class="field">
                        <label class="form-label">Access token</label>
                        <input class="form-control" type="password" @bind="_cloudToken" placeholder="System user o long-lived token" />
                    </div>
                    <div class="field">
                        <label class="form-label">Verify token del webhook</label>
                        <input class="form-control" @bind="_cloudVerify" placeholder="El mismo que registras en developers.facebook.com" />
                    </div>
                }

                @if (_newProvider == WhatsAppProvider.YCloud)
                {
                    <div class="field">
                        <label class="form-label">API Key de YCloud</label>
                        <input class="form-control" type="password" @bind="_ycKey" placeholder="X-API-Key desde tu panel de YCloud" />
                    </div>
                    <div class="field">
                        <label class="form-label">Numero / sender <small>(formato internacional sin +)</small></label>
                        <input class="form-control" @bind="_ycPhone" placeholder="ej. 573001234567" />
                    </div>
                    <div class="field">
                        <label class="form-label">WABA ID <small>(opcional; se detecta al verificar)</small></label>
                        <input class="form-control" @bind="_ycWaba" placeholder="opcional" />
                    </div>
                    <div class="field">
                        <label class="form-label">Secreto del webhook <small>(opcional)</small></label>
                        <input class="form-control" type="password" @bind="_ycHookSecret" />
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="CheckYCloud" disabled="@(_checking || string.IsNullOrWhiteSpace(_ycKey))">
                        @(_checking ? "Verificando..." : "Verificar credenciales")
                    </button>
                    @if (!string.IsNullOrEmpty(_checkMsg))
                    {
                        <div class="check-msg @(_checkOk ? "ok" : "err")" style="margin-top:8px;">@_checkMsg</div>
                    }
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p style="color:var(--destructive);font-size:.85rem;">@_error</p>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _showCreate = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="Create" disabled="@(string.IsNullOrWhiteSpace(_newName))">Crear</button>
            </div>
        </div>
    </div>
}

<style>
    .line-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; max-width: 1080px; }
    .line-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; box-shadow: var(--shadow-soft); }
    .line-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .line-name { font-weight: 700; font-size: 15px; margin-right: 8px; }
    .line-provider { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px; background: var(--muted); color: var(--muted-foreground); text-transform: uppercase; letter-spacing: .03em; }
    .line-provider.p-ycloud { background: oklch(0.62 0.16 155 / 0.15); color: var(--success); }
    .line-provider.p-cloud { background: oklch(0.55 0.2 245 / 0.15); color: oklch(0.55 0.2 245); }
    .line-provider.p-evolution { background: var(--muted); color: var(--muted-foreground); }
    .line-phone { font-size: 12.5px; color: var(--muted-foreground); margin-top: 6px; }
    .line-meta { font-size: 11.5px; color: var(--muted-foreground); margin-top: 2px; font-family: ui-monospace, monospace; }
    .line-actions { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
    .line-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; padding: 3px 9px; border-radius: 999px; background: var(--muted); color: var(--muted-foreground); }
    .line-badge.s-connected { background: oklch(0.62 0.16 155 / 0.15); color: var(--success); }
    .line-badge.s-failed, .line-badge.s-disconnected { background: oklch(0.6 0.22 22 / 0.12); color: var(--destructive); }
    .field { margin-bottom: 14px; }
    .modal-dialog.wide { max-width: 620px; }
    .provider-choice { display: flex; flex-direction: column; gap: 8px; }
    .prov-opt { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 10px; cursor: pointer; transition: all .15s; }
    .prov-opt.on { border-color: var(--primary); background: oklch(0.72 0.15 285 / 0.06); }
    .prov-opt input { margin-top: 3px; }
    .prov-opt strong { display: block; font-size: 14px; }
    .prov-opt small { display: block; color: var(--muted-foreground); font-size: 12px; margin-top: 2px; }
    .badge-reco { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 6px; background: var(--primary); color: white; margin-left: 6px; }
    .check-msg.ok { color: var(--success); font-size: 12.5px; }
    .check-msg.err { color: var(--destructive); font-size: 12.5px; }
    .qr-wrap { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 8px 0; }
    .qr-img { width: 260px; height: 260px; border: 1px solid var(--border); border-radius: 10px; padding: 8px; background: #fff; }
    .qr-hint { color: var(--muted-foreground); font-size: 12.5px; text-align: center; max-width: 360px; }
    .text-success { color: var(--success); }
    .text-danger { color: var(--destructive); }
    /* Acordeon "Avanzado" (Servidor + Webhook Evolution). Portado desde travels. */
    .cfg-accordion { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 6px 14px; }
    .cfg-accordion-summary { display: flex; align-items: center; gap: 10px; cursor: pointer; padding: 8px 4px; font-weight: 600; font-size: 13.5px; list-style: none; }
    .cfg-accordion-summary::-webkit-details-marker { display: none; }
    .cfg-accordion-chevron { transition: transform .18s ease; color: var(--muted-foreground); }
    .cfg-accordion[open] > .cfg-accordion-summary .cfg-accordion-chevron { transform: rotate(90deg); }
    .cfg-row { display: flex; align-items: flex-start; padding: 6px 8px; border-radius: 8px; }
    .cfg-row:hover { background: var(--muted); }
    .cfg-row .grow { flex: 1; }
    .field-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
</style>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _showCreate;
    private string _newName = "";
    private string _newPhone = "";
    private WhatsAppProvider _newProvider = WhatsAppProvider.YCloud;
    // Cloud
    private string _cloudPhoneId = "";
    private string _cloudWabaId = "";
    private string _cloudToken = "";
    private string _cloudVerify = "";
    // YCloud
    private string _ycKey = "";
    private string _ycPhone = "";
    private string _ycWaba = "";
    private string _ycHookSecret = "";
    private bool _checking;
    private bool _checkOk;
    private string _checkMsg = "";
    // General
    private string? _error;
    private string? _err;
    private Guid _actor;
    private List<WhatsAppLineDto> _lines = new();

    // Modal de QR (Evolution) + polling automatico
    private WhatsAppLineDto? _qrLine;
    private string? _qrBase64;
    private string? _qrError;
    private bool _qrBusy;
    private Timer? _pollTimer;

    // Modal "Probar envio"
    private bool _testOpen;
    private Guid _testLineId;
    private string? _testLineName;
    private string? _testPhone;
    private string _testText = "Hola! Mensaje de prueba desde CUBOT.redmanager.";
    private string? _testMsg;
    private bool _testOk;

    // Modal "Eliminar linea"
    private Guid? _deleteLineId;
    private string? _deleteLineName;

    // Acordeon "Servidor de WhatsApp": eleccion master vs propio Evolution.
    private EvolutionServerSettingDto? _server;
    private bool _useMaster = true;
    private string? _ownUrl;
    private string? _ownToken;
    private string? _serverMsg;
    private bool _serverOk;

    // Card "Webhook entrante": modo dev/prod, URL publica, token, tunel.
    private WebhookConfigDto? _webhook;
    private string _whMode = "Development";
    private string? _whPublicUrl;
    private string? _whToken;
    private string? _whMsg;
    private bool _whOk;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _actor);
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _lines = (await LinesSvc.ListAsync()).ToList();
        // Cargar config del servidor Evolution del tenant para el acordeon "Avanzado".
        _server = await Connector.GetServerAsync();
        _useMaster = _server.UseMasterServer;
        _ownUrl = _server.OwnBaseUrl;
        // Cargar config del webhook (modo dev/prod, URL activa, token).
        _webhook = await WebhookSvc.GetAsync();
        _whMode = _webhook.Mode;
        _whPublicUrl = _webhook.PublicUrl;
        _whToken = _webhook.Token;
        _loading = false;
    }

    private async Task SaveWebhookAsync()
    {
        _whMsg = null;
        _busy = true;
        try
        {
            _webhook = await WebhookSvc.SaveAsync(_whMode, _whPublicUrl, _whToken, _actor);
            _whToken = _webhook.Token;
            _whOk = true;
            _whMsg = "Webhook guardado y aplicado a las lineas conectadas.";
        }
        catch (Exception ex)
        {
            _whOk = false;
            _whMsg = $"Error: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task StartTunnelAsync()
    {
        _whMsg = null;
        _busy = true;
        try
        {
            _webhook = await WebhookSvc.StartTunnelAsync(_actor);
            _whOk = _webhook.TunnelRunning;
            _whMsg = _webhook.TunnelRunning
                ? $"Tunel activo: {_webhook.EffectiveUrl}"
                : "No se pudo iniciar el tunel. Verifica que cloudflared este instalado en el host.";
        }
        catch (Exception ex)
        {
            _whOk = false;
            _whMsg = $"Error: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task StopTunnelAsync()
    {
        _whMsg = null;
        _busy = true;
        try
        {
            _webhook = await WebhookSvc.StopTunnelAsync(_actor);
            _whOk = true;
            _whMsg = "Tunel detenido.";
        }
        catch (Exception ex)
        {
            _whOk = false;
            _whMsg = $"Error: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task SaveServerAsync()
    {
        _serverMsg = null;
        _busy = true;
        try
        {
            var res = await Connector.SetServerAsync(new SetEvolutionServerRequest(_useMaster, _ownUrl, _ownToken), _actor);
            if (res is null) { _serverMsg = "No se pudo guardar."; _serverOk = false; return; }
            _server = res;
            // Nunca dejamos el token en el input despues de guardar. Si el usuario quiere cambiarlo
            // otra vez tiene que reingresarlo; asi evitamos exponerlo en el DOM inspeccionable.
            _ownToken = null;
            _serverOk = true;
            _serverMsg = "Servidor guardado.";
        }
        catch (Exception ex)
        {
            _serverOk = false;
            _serverMsg = $"Error: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task CheckYCloud()
    {
        _checking = true; _checkMsg = "";
        try
        {
            var res = await YCloud.CheckAsync(_ycKey.Trim(), string.IsNullOrWhiteSpace(_ycPhone) ? null : _ycPhone.Trim(), default);
            _checkOk = res.IsValid;
            if (res.IsValid)
            {
                _checkMsg = $"OK. Numero: {res.VerifiedPhone ?? "(sin numero registrado)"}. WABA: {res.WabaId ?? "(no detectada)"}";
                if (string.IsNullOrWhiteSpace(_ycPhone) && !string.IsNullOrWhiteSpace(res.VerifiedPhone)) { _ycPhone = res.VerifiedPhone!.Replace("+", ""); }
                if (string.IsNullOrWhiteSpace(_ycWaba) && !string.IsNullOrWhiteSpace(res.WabaId)) { _ycWaba = res.WabaId!; }
            }
            else
            {
                _checkMsg = $"Error: {res.Error}";
            }
        }
        finally { _checking = false; }
    }

    private async Task Create()
    {
        _error = null;
        try
        {
            var req = new CreateWhatsAppLineRequest(
                InstanceName: _newName,
                PhoneNumber: string.IsNullOrWhiteSpace(_newPhone) ? null : _newPhone,
                Provider: _newProvider,
                CloudPhoneNumberId: _newProvider == WhatsAppProvider.Cloud ? _cloudPhoneId.NullIfBlank() : null,
                CloudBusinessAccountId: _newProvider == WhatsAppProvider.Cloud ? _cloudWabaId.NullIfBlank() : null,
                CloudAccessToken: _newProvider == WhatsAppProvider.Cloud ? _cloudToken.NullIfBlank() : null,
                CloudWebhookVerifyToken: _newProvider == WhatsAppProvider.Cloud ? _cloudVerify.NullIfBlank() : null,
                YCloudApiKey: _newProvider == WhatsAppProvider.YCloud ? _ycKey.NullIfBlank() : null,
                YCloudPhoneNumberId: _newProvider == WhatsAppProvider.YCloud ? _ycPhone.NullIfBlank() : null,
                YCloudWabaId: _newProvider == WhatsAppProvider.YCloud ? _ycWaba.NullIfBlank() : null,
                YCloudWebhookSecret: _newProvider == WhatsAppProvider.YCloud ? _ycHookSecret.NullIfBlank() : null);
            var dto = await LinesSvc.CreateAsync(req, _actor);
            if (dto is null) { _error = "No hay agencia activa."; return; }
            ResetForm();
            _showCreate = false;
            await Reload();
            // Para Evolution, tras persistir la fila, crear la instancia en el servidor y traer el
            // QR para que el operador lo escanee desde el celular. Sin esto, la linea quedaba
            // "Created" y nunca se conectaba.
            if (dto.Provider == WhatsAppProvider.Evolution)
            {
                await OpenQrForAsync(dto);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ConnectEvolution(WhatsAppLineDto line) => await OpenQrForAsync(line);

    private async Task OpenQrForAsync(WhatsAppLineDto line)
    {
        _qrLine = line;
        _qrError = null;
        _qrBase64 = null;
        _qrBusy = true;
        StateHasChanged();
        try
        {
            var res = await Connector.ConnectLineAsync(line.Id, _actor);
            if (!res.Ok)
            {
                _qrError = res.Error ?? "No se pudo conectar con Evolution.";
            }
            else
            {
                _qrBase64 = res.QrBase64;
                if (string.IsNullOrEmpty(_qrBase64))
                {
                    _qrError = "Evolution acepto la instancia pero no devolvio QR. Espera unos segundos.";
                }
            }
        }
        catch (Exception ex) { _qrError = ex.Message; }
        finally { _qrBusy = false; }
        await Reload();
        // Arranca polling automatico cada 3s hasta que la linea quede Connected o el usuario
        // cierre el modal. Sin esto el operador tenia que pulsar "Verificar estado" a mano.
        StartPolling();
    }

    private void StartPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = new Timer(async _ => await PollAsync(), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task PollAsync()
    {
        if (_qrLine is null) { return; }
        var updated = await Connector.RefreshAsync(_qrLine.Id, _actor);
        if (updated is null) { return; }
        _qrLine = updated;
        var i = _lines.FindIndex(l => l.Id == updated.Id);
        if (i >= 0) { _lines[i] = updated; }
        if (updated.Status == WhatsAppLineStatus.Connected)
        {
            _qrError = null;
            _qrBase64 = null;
            _pollTimer?.Dispose();
            _pollTimer = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshQrLine()
    {
        if (_qrLine is null) { return; }
        _qrBusy = true;
        try
        {
            var dto = await Connector.RefreshAsync(_qrLine.Id, _actor);
            if (dto is not null) { _qrLine = dto; }
            if (dto?.Status == WhatsAppLineStatus.Connected)
            {
                _qrError = null;
                _qrBase64 = null;
                _pollTimer?.Dispose();
                _pollTimer = null;
            }
        }
        finally { _qrBusy = false; }
        await Reload();
    }

    private void CloseQrModal()
    {
        _qrLine = null;
        _qrBase64 = null;
        _qrError = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task RefreshAsync(Guid lineId)
    {
        _busy = true;
        try
        {
            var updated = await Connector.RefreshAsync(lineId, _actor);
            if (updated is not null)
            {
                var i = _lines.FindIndex(l => l.Id == updated.Id);
                if (i >= 0) { _lines[i] = updated; }
            }
        }
        finally { _busy = false; }
    }

    private async Task Disconnect(WhatsAppLineDto line)
    {
        _busy = true;
        try
        {
            if (line.Provider == WhatsAppProvider.Evolution)
            {
                await Connector.DisconnectAsync(line.Id, _actor);
            }
            else
            {
                await LinesSvc.ChangeStatusAsync(line.Id, WhatsAppLineStatus.Disconnected, _actor);
            }
            await Reload();
        }
        finally { _busy = false; }
    }

    private void ResetForm()
    {
        _newName = ""; _newPhone = "";
        _cloudPhoneId = ""; _cloudWabaId = ""; _cloudToken = ""; _cloudVerify = "";
        _ycKey = ""; _ycPhone = ""; _ycWaba = ""; _ycHookSecret = "";
        _checkMsg = ""; _checkOk = false;
    }

    private async Task ChangeStatus(WhatsAppLineDto line, WhatsAppLineStatus status)
    {
        _busy = true;
        try
        {
            await LinesSvc.ChangeStatusAsync(line.Id, status, _actor);
            await Reload();
        }
        finally { _busy = false; }
    }

    private void AskDelete(WhatsAppLineDto line)
    {
        _err = null;
        _deleteLineId = line.Id;
        _deleteLineName = line.InstanceName;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteLineId is not Guid id) { return; }
        _busy = true;
        try
        {
            // Usa Connector.DeleteLineAsync (no LinesSvc.DeleteAsync) para que ademas de borrar
            // la fila cierre la sesion en Evolution y deje auditoria. Best-effort a nivel BSP.
            await Connector.DeleteLineAsync(id, _actor);
            _deleteLineId = null;
            _deleteLineName = null;
            await Reload();
        }
        catch (Exception ex)
        {
            _err = $"No se pudo eliminar la linea: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private void OpenTest(WhatsAppLineDto line)
    {
        _testMsg = null;
        _testLineId = line.Id;
        _testLineName = line.InstanceName;
        _testPhone = string.IsNullOrWhiteSpace(line.PhoneNumber) ? null : line.PhoneNumber;
        _testOpen = true;
    }

    private async Task SendTestAsync()
    {
        _testMsg = null;
        _busy = true;
        try
        {
            var res = await Connector.SendTestAsync(_testLineId, _testPhone ?? "", _testText, _actor);
            _testOk = res.Ok;
            _testMsg = res.Ok ? "Mensaje enviado." : $"No se pudo enviar: {res.Error}";
        }
        finally { _busy = false; }
    }

    public void Dispose() => _pollTimer?.Dispose();

    private static string StatusLabel(WhatsAppLineStatus s) => s switch
    {
        WhatsAppLineStatus.Connected => "Conectada",
        WhatsAppLineStatus.Connecting => "Conectando",
        WhatsAppLineStatus.Disconnected => "Desconectada",
        WhatsAppLineStatus.Failed => "Fallida",
        WhatsAppLineStatus.Disabled => "Deshabilitada",
        _ => "Creada"
    };

    private static string ProviderLabel(WhatsAppProvider p) => p switch
    {
        WhatsAppProvider.YCloud => "YCloud",
        WhatsAppProvider.Cloud => "Meta Cloud",
        _ => "Evolution"
    };

    /// <summary>Normaliza el QR de Evolution: si viene como data URL lo dejamos tal cual;
    /// si viene como base64 puro (sin prefijo) le anadimos "data:image/png;base64,". Sin esto,
    /// concatenar el prefijo ciegamente produce un src duplicado que el navegador rechaza.</summary>
    private static string QrSrc(string qr)
        => qr.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ? qr : $"data:image/png;base64,{qr}";
}
