@page "/lineas-whatsapp"
@attribute [Authorize(Policy = AppPolicies.TenantMember)]
@rendermode InteractiveServer
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@using CubotRedManager.Web.Components
@inject IWhatsAppLineService LinesSvc
@inject IWhatsAppConnectorService Connector
@inject IYCloudApiClient YCloud
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Lineas WhatsApp - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
            </div>
            <span>Comunicacion e IA</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Lineas WhatsApp</h1>
        <p class="page-sub" style="margin-bottom:0;">Lineas WhatsApp de la agencia. Soporta Evolution (QR), Meta Cloud API oficial y YCloud (BSP con coexistencia).</p>
    </div>
    <button class="btn btn-primary" @onclick="() => _showCreate = true">Nueva linea</button>
</div>

@if (_loading)
{
    <p class="text-muted">Cargando...</p>
}
else if (_lines.Count == 0)
{
    <div class="coming-soon">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg>
        </div>
        <h3>Sin lineas todavia</h3>
        <p>Crea la primera linea de WhatsApp para esta agencia. Recomendamos YCloud para evitar bloqueos.</p>
    </div>
}
else
{
    <div class="line-grid">
        @foreach (var l in _lines)
        {
            <div class="line-card">
                <div class="line-top">
                    <div>
                        <span class="line-name">@l.InstanceName</span>
                        <span class="line-provider p-@l.Provider.ToString().ToLowerInvariant()">@ProviderLabel(l.Provider)</span>
                    </div>
                    <span class="line-badge s-@l.Status.ToString().ToLowerInvariant()">@StatusLabel(l.Status)</span>
                </div>
                <div class="line-phone">
                    @if (l.Provider == WhatsAppProvider.YCloud && !string.IsNullOrEmpty(l.YCloudPhoneNumberId))
                    {
                        <span>@l.YCloudPhoneNumberId</span>
                    }
                    else if (l.Provider == WhatsAppProvider.Cloud && !string.IsNullOrEmpty(l.CloudPhoneNumberId))
                    {
                        <span>PhoneNumberId: @l.CloudPhoneNumberId</span>
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(l.PhoneNumber) ? "Sin numero" : l.PhoneNumber)</span>
                    }
                </div>
                @if (l.Provider == WhatsAppProvider.YCloud && !string.IsNullOrEmpty(l.YCloudWabaId))
                {
                    <div class="line-meta">WABA: @l.YCloudWabaId</div>
                }
                <div class="line-actions">
                    @if (l.Status == WhatsAppLineStatus.Connected)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Disconnect(l)">Desconectar</button>
                    }
                    else if (l.Provider == WhatsAppProvider.Evolution)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => ConnectEvolution(l)">Conectar (QR)</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => ChangeStatus(l, WhatsAppLineStatus.Connected)">Marcar conectada</button>
                    }
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(l)">Eliminar</button>
                </div>
            </div>
        }
    </div>
}

@if (_qrLine is not null)
{
    <div class="modal-overlay" @onclick="CloseQrModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Conectar @_qrLine.InstanceName por QR</h3>
                <button class="modal-close" @onclick="CloseQrModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="qr-wrap">
                    @if (_qrLine.Status == WhatsAppLineStatus.Connected)
                    {
                        <div style="font-size:48px;color:var(--success);">OK</div>
                        <div class="qr-hint"><strong>Linea conectada.</strong> Puedes cerrar este modal.</div>
                    }
                    else if (_qrBusy && string.IsNullOrEmpty(_qrBase64))
                    {
                        <div class="qr-hint" style="padding:32px 0;">Preparando la instancia en Evolution...</div>
                    }
                    else if (!string.IsNullOrEmpty(_qrBase64))
                    {
                        <img class="qr-img" src="@QrSrc(_qrBase64)" alt="QR de conexion" />
                        <div class="qr-hint">
                            Abre <strong>WhatsApp</strong> en tu celular &rarr; <strong>Dispositivos vinculados</strong> &rarr;
                            <strong>Vincular un dispositivo</strong> y escanea este codigo. El QR se refresca cada minuto;
                            pulsa <em>Verificar estado</em> luego de escanear.
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_qrError))
                    {
                        <div class="check-msg err">@_qrError</div>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseQrModal">Cerrar</button>
                <button class="btn btn-outline-primary" @onclick="RefreshQrLine" disabled="@_qrBusy">
                    @(_qrBusy ? "Verificando..." : "Verificar estado")
                </button>
                <button class="btn btn-primary" @onclick="() => OpenQrForAsync(_qrLine!)" disabled="@_qrBusy">Regenerar QR</button>
            </div>
        </div>
    </div>
}

@if (_showCreate)
{
    <div class="modal-overlay" @onclick="() => _showCreate = false">
        <div class="modal-dialog wide" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Nueva linea WhatsApp</h3>
                <button class="modal-close" @onclick="() => _showCreate = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Proveedor</label>
                    <div class="provider-choice">
                        <label class="prov-opt @(_newProvider == WhatsAppProvider.YCloud ? "on" : "")">
                            <input type="radio" name="prov" checked="@(_newProvider == WhatsAppProvider.YCloud)" @onchange="() => _newProvider = WhatsAppProvider.YCloud" />
                            <div>
                                <strong>YCloud <span class="badge-reco">recomendado</span></strong>
                                <small>BSP oficial con coexistencia. WhatsApp Business App + API en el mismo numero.</small>
                            </div>
                        </label>
                        <label class="prov-opt @(_newProvider == WhatsAppProvider.Cloud ? "on" : "")">
                            <input type="radio" name="prov" checked="@(_newProvider == WhatsAppProvider.Cloud)" @onchange="() => _newProvider = WhatsAppProvider.Cloud" />
                            <div>
                                <strong>Meta Cloud API</strong>
                                <small>API oficial de Meta (developers.facebook.com). Rompe la app oficial en el celular.</small>
                            </div>
                        </label>
                        <label class="prov-opt @(_newProvider == WhatsAppProvider.Evolution ? "on" : "")">
                            <input type="radio" name="prov" checked="@(_newProvider == WhatsAppProvider.Evolution)" @onchange="() => _newProvider = WhatsAppProvider.Evolution" />
                            <div>
                                <strong>Evolution (QR)</strong>
                                <small>Conexion no oficial via QR. Riesgo de bloqueo por Meta.</small>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="field">
                    <label class="form-label">Nombre de la linea</label>
                    <input class="form-control" @bind="_newName" placeholder="ej. ventas-marca-x" />
                </div>

                @if (_newProvider == WhatsAppProvider.Evolution)
                {
                    <div class="field">
                        <label class="form-label">Numero (opcional)</label>
                        <input class="form-control" @bind="_newPhone" placeholder="ej. +57..." />
                    </div>
                }

                @if (_newProvider == WhatsAppProvider.Cloud)
                {
                    <div class="field">
                        <label class="form-label">Phone Number ID (Meta)</label>
                        <input class="form-control" @bind="_cloudPhoneId" placeholder="ej. 106540...." />
                    </div>
                    <div class="field">
                        <label class="form-label">WhatsApp Business Account ID</label>
                        <input class="form-control" @bind="_cloudWabaId" placeholder="ej. 175201...." />
                    </div>
                    <div class="field">
                        <label class="form-label">Access token</label>
                        <input class="form-control" type="password" @bind="_cloudToken" placeholder="System user o long-lived token" />
                    </div>
                    <div class="field">
                        <label class="form-label">Verify token del webhook</label>
                        <input class="form-control" @bind="_cloudVerify" placeholder="El mismo que registras en developers.facebook.com" />
                    </div>
                }

                @if (_newProvider == WhatsAppProvider.YCloud)
                {
                    <div class="field">
                        <label class="form-label">API Key de YCloud</label>
                        <input class="form-control" type="password" @bind="_ycKey" placeholder="X-API-Key desde tu panel de YCloud" />
                    </div>
                    <div class="field">
                        <label class="form-label">Numero / sender <small>(formato internacional sin +)</small></label>
                        <input class="form-control" @bind="_ycPhone" placeholder="ej. 573001234567" />
                    </div>
                    <div class="field">
                        <label class="form-label">WABA ID <small>(opcional; se detecta al verificar)</small></label>
                        <input class="form-control" @bind="_ycWaba" placeholder="opcional" />
                    </div>
                    <div class="field">
                        <label class="form-label">Secreto del webhook <small>(opcional)</small></label>
                        <input class="form-control" type="password" @bind="_ycHookSecret" />
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="CheckYCloud" disabled="@(_checking || string.IsNullOrWhiteSpace(_ycKey))">
                        @(_checking ? "Verificando..." : "Verificar credenciales")
                    </button>
                    @if (!string.IsNullOrEmpty(_checkMsg))
                    {
                        <div class="check-msg @(_checkOk ? "ok" : "err")" style="margin-top:8px;">@_checkMsg</div>
                    }
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p style="color:var(--destructive);font-size:.85rem;">@_error</p>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="() => _showCreate = false">Cancelar</button>
                <button class="btn btn-primary" @onclick="Create" disabled="@(string.IsNullOrWhiteSpace(_newName))">Crear</button>
            </div>
        </div>
    </div>
}

<style>
    .line-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; max-width: 1080px; }
    .line-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; box-shadow: var(--shadow-soft); }
    .line-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .line-name { font-weight: 700; font-size: 15px; margin-right: 8px; }
    .line-provider { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px; background: var(--muted); color: var(--muted-foreground); text-transform: uppercase; letter-spacing: .03em; }
    .line-provider.p-ycloud { background: oklch(0.72 0.15 285 / 0.15); color: var(--primary); }
    .line-provider.p-cloud { background: oklch(0.55 0.2 245 / 0.15); color: oklch(0.55 0.2 245); }
    .line-phone { font-size: 12.5px; color: var(--muted-foreground); margin-top: 6px; }
    .line-meta { font-size: 11.5px; color: var(--muted-foreground); margin-top: 2px; font-family: ui-monospace, monospace; }
    .line-actions { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
    .line-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; padding: 3px 9px; border-radius: 999px; background: var(--muted); color: var(--muted-foreground); }
    .line-badge.s-connected { background: oklch(0.62 0.16 155 / 0.15); color: var(--success); }
    .line-badge.s-failed, .line-badge.s-disconnected { background: oklch(0.6 0.22 22 / 0.12); color: var(--destructive); }
    .field { margin-bottom: 14px; }
    .modal-dialog.wide { max-width: 620px; }
    .provider-choice { display: flex; flex-direction: column; gap: 8px; }
    .prov-opt { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 10px; cursor: pointer; transition: all .15s; }
    .prov-opt.on { border-color: var(--primary); background: oklch(0.72 0.15 285 / 0.06); }
    .prov-opt input { margin-top: 3px; }
    .prov-opt strong { display: block; font-size: 14px; }
    .prov-opt small { display: block; color: var(--muted-foreground); font-size: 12px; margin-top: 2px; }
    .badge-reco { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 6px; background: var(--primary); color: white; margin-left: 6px; }
    .check-msg.ok { color: var(--success); font-size: 12.5px; }
    .check-msg.err { color: var(--destructive); font-size: 12.5px; }
    .qr-wrap { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 8px 0; }
    .qr-img { width: 260px; height: 260px; border: 1px solid var(--border); border-radius: 10px; padding: 8px; background: #fff; }
    .qr-hint { color: var(--muted-foreground); font-size: 12.5px; text-align: center; max-width: 360px; }
</style>

@code {
    private bool _loading = true;
    private bool _showCreate;
    private string _newName = "";
    private string _newPhone = "";
    private WhatsAppProvider _newProvider = WhatsAppProvider.YCloud;
    // Cloud
    private string _cloudPhoneId = "";
    private string _cloudWabaId = "";
    private string _cloudToken = "";
    private string _cloudVerify = "";
    // YCloud
    private string _ycKey = "";
    private string _ycPhone = "";
    private string _ycWaba = "";
    private string _ycHookSecret = "";
    private bool _checking;
    private bool _checkOk;
    private string _checkMsg = "";
    // General
    private string? _error;
    private Guid _actor;
    private IReadOnlyList<WhatsAppLineDto> _lines = [];

    // Modal de QR (Evolution)
    private WhatsAppLineDto? _qrLine;
    private string? _qrBase64;
    private string? _qrError;
    private bool _qrBusy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _actor);
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _lines = await LinesSvc.ListAsync();
        _loading = false;
    }

    private async Task CheckYCloud()
    {
        _checking = true; _checkMsg = "";
        try
        {
            var res = await YCloud.CheckAsync(_ycKey.Trim(), string.IsNullOrWhiteSpace(_ycPhone) ? null : _ycPhone.Trim(), default);
            _checkOk = res.IsValid;
            if (res.IsValid)
            {
                _checkMsg = $"OK. Numero: {res.VerifiedPhone ?? "(sin numero registrado)"}. WABA: {res.WabaId ?? "(no detectada)"}";
                if (string.IsNullOrWhiteSpace(_ycPhone) && !string.IsNullOrWhiteSpace(res.VerifiedPhone)) { _ycPhone = res.VerifiedPhone!.Replace("+", ""); }
                if (string.IsNullOrWhiteSpace(_ycWaba) && !string.IsNullOrWhiteSpace(res.WabaId)) { _ycWaba = res.WabaId!; }
            }
            else
            {
                _checkMsg = $"Error: {res.Error}";
            }
        }
        finally { _checking = false; }
    }

    private async Task Create()
    {
        _error = null;
        try
        {
            var req = new CreateWhatsAppLineRequest(
                InstanceName: _newName,
                PhoneNumber: string.IsNullOrWhiteSpace(_newPhone) ? null : _newPhone,
                Provider: _newProvider,
                CloudPhoneNumberId: _newProvider == WhatsAppProvider.Cloud ? _cloudPhoneId.NullIfBlank() : null,
                CloudBusinessAccountId: _newProvider == WhatsAppProvider.Cloud ? _cloudWabaId.NullIfBlank() : null,
                CloudAccessToken: _newProvider == WhatsAppProvider.Cloud ? _cloudToken.NullIfBlank() : null,
                CloudWebhookVerifyToken: _newProvider == WhatsAppProvider.Cloud ? _cloudVerify.NullIfBlank() : null,
                YCloudApiKey: _newProvider == WhatsAppProvider.YCloud ? _ycKey.NullIfBlank() : null,
                YCloudPhoneNumberId: _newProvider == WhatsAppProvider.YCloud ? _ycPhone.NullIfBlank() : null,
                YCloudWabaId: _newProvider == WhatsAppProvider.YCloud ? _ycWaba.NullIfBlank() : null,
                YCloudWebhookSecret: _newProvider == WhatsAppProvider.YCloud ? _ycHookSecret.NullIfBlank() : null);
            var dto = await LinesSvc.CreateAsync(req, _actor);
            if (dto is null) { _error = "No hay agencia activa."; return; }
            ResetForm();
            _showCreate = false;
            await Reload();
            // Para Evolution, tras persistir la fila, crear la instancia en el servidor y traer el
            // QR para que el operador lo escanee desde el celular. Sin esto, la linea quedaba
            // "Created" y nunca se conectaba.
            if (dto.Provider == WhatsAppProvider.Evolution)
            {
                await OpenQrForAsync(dto);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ConnectEvolution(WhatsAppLineDto line) => await OpenQrForAsync(line);

    private async Task OpenQrForAsync(WhatsAppLineDto line)
    {
        _qrLine = line;
        _qrError = null;
        _qrBase64 = null;
        _qrBusy = true;
        StateHasChanged();
        try
        {
            var res = await Connector.ConnectLineAsync(line.Id, _actor);
            if (!res.Ok)
            {
                _qrError = res.Error ?? "No se pudo conectar con Evolution.";
            }
            else
            {
                _qrBase64 = res.QrBase64;
                if (string.IsNullOrEmpty(_qrBase64))
                {
                    _qrError = "Evolution acepto la instancia pero no devolvio QR. Espera unos segundos y presiona 'Verificar estado'.";
                }
            }
        }
        catch (Exception ex) { _qrError = ex.Message; }
        finally { _qrBusy = false; }
        await Reload();
    }

    private async Task RefreshQrLine()
    {
        if (_qrLine is null) { return; }
        _qrBusy = true;
        try
        {
            var dto = await Connector.RefreshAsync(_qrLine.Id, _actor);
            if (dto is not null) { _qrLine = dto; }
            if (dto?.Status == WhatsAppLineStatus.Connected)
            {
                _qrError = null;
                _qrBase64 = null;
            }
        }
        finally { _qrBusy = false; }
        await Reload();
    }

    private void CloseQrModal() { _qrLine = null; _qrBase64 = null; _qrError = null; }

    private async Task Disconnect(WhatsAppLineDto line)
    {
        if (line.Provider == WhatsAppProvider.Evolution)
        {
            await Connector.DisconnectAsync(line.Id, _actor);
        }
        else
        {
            await LinesSvc.ChangeStatusAsync(line.Id, WhatsAppLineStatus.Disconnected, _actor);
        }
        await Reload();
    }

    private void ResetForm()
    {
        _newName = ""; _newPhone = "";
        _cloudPhoneId = ""; _cloudWabaId = ""; _cloudToken = ""; _cloudVerify = "";
        _ycKey = ""; _ycPhone = ""; _ycWaba = ""; _ycHookSecret = "";
        _checkMsg = ""; _checkOk = false;
    }

    private async Task ChangeStatus(WhatsAppLineDto line, WhatsAppLineStatus status)
    {
        await LinesSvc.ChangeStatusAsync(line.Id, status, _actor);
        await Reload();
    }

    private async Task Delete(WhatsAppLineDto line)
    {
        await LinesSvc.DeleteAsync(line.Id, _actor);
        await Reload();
    }

    private static string StatusLabel(WhatsAppLineStatus s) => s switch
    {
        WhatsAppLineStatus.Connected => "Conectada",
        WhatsAppLineStatus.Connecting => "Conectando",
        WhatsAppLineStatus.Disconnected => "Desconectada",
        WhatsAppLineStatus.Failed => "Fallida",
        WhatsAppLineStatus.Disabled => "Deshabilitada",
        _ => "Creada"
    };

    private static string ProviderLabel(WhatsAppProvider p) => p switch
    {
        WhatsAppProvider.YCloud => "YCloud",
        WhatsAppProvider.Cloud => "Meta Cloud",
        _ => "Evolution"
    };

    /// <summary>Normaliza el QR de Evolution: si viene como data URL lo dejamos tal cual;
    /// si viene como base64 puro (sin prefijo) le anadimos "data:image/png;base64,". Sin esto,
    /// concatenar el prefijo ciegamente produce un src duplicado que el navegador rechaza.</summary>
    private static string QrSrc(string qr)
        => qr.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ? qr : $"data:image/png;base64,{qr}";
}

