@page "/contenedor-datos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = AppPolicies.TenantMember)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using CubotRedManager.Application.Tenancy
@using CubotRedManager.Domain.Enums
@using CubotRedManager.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IDataContainerService DataSvc
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Contenedor de Datos - CUBOT.redmanager</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
            </div>
            <span>Configuracion</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Contenedor de Datos</h1>
        <p class="page-sub" style="margin-bottom:0;">Crea modelos de datos personalizados y cargalos manualmente o desde Excel.</p>
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
        @if (_selected is null)
        {
            <button class="btn btn-primary" @onclick="OpenCreateContainer">+ Nuevo modelo</button>
        }
        else
        {
            <button class="btn btn-outline-secondary" @onclick="BackToList">Volver a modelos</button>
        }
    </div>
</div>

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else if (_selected is null)
{
    @if (_containers.Count == 0)
    {
        <div class="card" style="padding:32px;text-align:center;">
            <div class="text-muted">Aun no tienes modelos. Crea el primero con "+ Nuevo modelo".</div>
        </div>
    }
    else
    {
        <div class="dc-grid">
            @foreach (var c in _containers)
            {
                <div class="card dc-card">
                    <div class="dc-card-head">
                        <div class="dc-card-name">@c.Name</div>
                        <div class="text-muted" style="font-size:11px;">@c.UpdatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="dc-card-desc">@(string.IsNullOrWhiteSpace(c.Description) ? "(sin descripcion)" : Truncate(c.Description!, 140))</div>
                    <div class="dc-card-meta">@c.ColumnCount columnas &middot; @c.RowCount filas</div>
                    <div class="dc-card-actions">
                        <button class="btn btn-primary btn-sm" @onclick="() => OpenContainerAsync(c.Id)">Abrir</button>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="dc-detail-head">
        <div>
            <h2 style="margin:0 0 4px 0;">@_selected.Name</h2>
            @if (!string.IsNullOrWhiteSpace(_selected.Description))
            {
                <div class="text-muted" style="font-size:0.92rem;">@_selected.Description</div>
            }
        </div>
        <div class="dc-detail-actions">
            <input class="form-control" style="max-width:240px;" placeholder="Buscar en filas..." @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            <button class="btn btn-outline-secondary" @onclick="OpenEditContainer">Editar modelo</button>
            <button class="btn btn-outline-secondary dc-danger" @onclick="DeleteContainerAsync">Eliminar modelo</button>
            <button class="btn btn-primary" @onclick="OpenNewRow">+ Nueva fila</button>
            <button class="btn btn-outline-secondary" @onclick="OpenImport">Importar Excel</button>
        </div>
    </div>

    @if (_selected.Columns.Count == 0)
    {
        <div class="card" style="padding:32px;text-align:center;">
            <div class="text-muted">Este modelo no tiene columnas. Edita el modelo para agregarlas.</div>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <div class="card" style="padding:32px;text-align:center;">
            <div class="text-muted">
                @if (string.IsNullOrWhiteSpace(_search))
                {
                    <span>Este modelo aun no tiene filas. Crea una con "+ Nueva fila" o importa un Excel.</span>
                }
                else
                {
                    <span>Ninguna fila coincide con "@_search".</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card" style="padding:0;overflow:auto;">
            <table class="table dc-table">
                <thead>
                    <tr>
                        @foreach (var col in _selected.Columns)
                        {
                            <th title="@(col.Description ?? col.Type.ToString())">@col.Name</th>
                        }
                        <th style="width:140px;text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            @foreach (var col in _selected.Columns)
                            {
                                <td>@RenderCell(row, col)</td>
                            }
                            <td style="text-align:right;">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditRow(row)">Editar</button>
                                <button class="btn btn-sm btn-outline-secondary dc-danger" @onclick="() => DeleteRowAsync(row.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@* ============== Modal modelo ============== *@
@if (_containerModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:720px;">
            <div class="modal-head">
                <h3>@(_containerEditId is null ? "Nuevo modelo" : "Editar modelo")</h3>
                <button class="modal-close" @onclick="CloseContainerModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="field">
                    <label class="form-label">Nombre del modelo</label>
                    <input class="form-control" @bind="_fcName" placeholder="Ej. Gestion de Productos" maxlength="120" />
                </div>
                <div class="field">
                    <label class="form-label">Descripcion (opcional)</label>
                    <textarea class="form-control" rows="2" @bind="_fcDescription" placeholder="Para que sirve este modelo..."></textarea>
                </div>
                <div class="field">
                    <label class="form-label">Columnas</label>
                    <div class="dc-cols">
                        @for (var i = 0; i < _fcColumns.Count; i++)
                        {
                            var idx = i;
                            var item = _fcColumns[idx];
                            <div class="dc-col-row">
                                <input class="form-control" placeholder="Nombre" @bind="item.Name" />
                                <input class="form-control" placeholder="Descripcion (opcional)" @bind="item.Description" />
                                <select class="form-control" @bind="item.Type">
                                    <option value="Text">Texto</option>
                                    <option value="Number">Numero</option>
                                    <option value="Decimal">Decimal</option>
                                    <option value="Date">Fecha</option>
                                    <option value="Boolean">Booleano</option>
                                </select>
                                <label class="dc-req">
                                    <input type="checkbox" @bind="item.IsRequired" /> Obligatoria
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-secondary dc-danger" @onclick="() => RemoveColumn(idx)" title="Quitar columna">&times;</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddColumn" style="margin-top:6px;">+ Agregar columna</button>
                </div>
                @if (_containerError is not null)
                {
                    <div class="text-danger small">@_containerError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseContainerModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveContainerAsync" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar")</button>
            </div>
        </div>
    </div>
}

@* ============== Modal fila ============== *@
@if (_rowModalOpen && _selected is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:640px;">
            <div class="modal-head">
                <h3>@(_rowEditId is null ? "Nueva fila" : "Editar fila")</h3>
                <button class="modal-close" @onclick="CloseRowModal">&times;</button>
            </div>
            <div class="modal-body">
                @foreach (var col in _selected.Columns)
                {
                    var key = col.Id;
                    <div class="field">
                        <label class="form-label">
                            @col.Name
                            @if (col.IsRequired)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        @switch (col.Type)
                        {
                            case DataColumnType.Number:
                                <input class="form-control" type="number" step="1" placeholder="@(col.Description ?? "")"
                                       value="@(_fRowValues.TryGetValue(key, out var vN) ? vN : "")"
                                       @onchange="@(e => SetRowValue(key, e.Value?.ToString()))" />
                                break;
                            case DataColumnType.Decimal:
                                <input class="form-control" type="number" step="0.01" placeholder="@(col.Description ?? "")"
                                       value="@(_fRowValues.TryGetValue(key, out var vD) ? vD : "")"
                                       @onchange="@(e => SetRowValue(key, e.Value?.ToString()))" />
                                break;
                            case DataColumnType.Date:
                                <input class="form-control" type="date" placeholder="@(col.Description ?? "")"
                                       value="@(_fRowValues.TryGetValue(key, out var vDate) ? vDate : "")"
                                       @onchange="@(e => SetRowValue(key, e.Value?.ToString()))" />
                                break;
                            case DataColumnType.Boolean:
                                <input type="checkbox"
                                       checked="@(_fRowValues.TryGetValue(key, out var vB) && vB == "true")"
                                       @onchange="@(e => SetRowValue(key, (e.Value is bool b && b) ? "true" : "false"))" />
                                break;
                            default:
                                <input class="form-control" type="text" placeholder="@(col.Description ?? "")"
                                       value="@(_fRowValues.TryGetValue(key, out var vT) ? vT : "")"
                                       @onchange="@(e => SetRowValue(key, e.Value?.ToString()))" />
                                break;
                        }
                        @if (!string.IsNullOrWhiteSpace(col.Description))
                        {
                            <div class="text-muted" style="font-size:11px;margin-top:2px;">@col.Description</div>
                        }
                    </div>
                }
                @if (_rowError is not null)
                {
                    <div class="text-danger small">@_rowError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseRowModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="SaveRowAsync" disabled="@_busy">@(_busy ? "Guardando..." : "Guardar")</button>
            </div>
        </div>
    </div>
}

@* ============== Modal import ============== *@
@if (_importModalOpen && _selected is not null)
{
    <div class="modal-overlay">
        <div class="modal-dialog" style="max-width:560px;">
            <div class="modal-head">
                <h3>Importar Excel</h3>
                <button class="modal-close" @onclick="CloseImportModal">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-muted" style="font-size:0.92rem;">
                    La primera fila del Excel debe contener los nombres de las columnas, identicos
                    (sin importar mayusculas/tildes) a los del modelo.
                </p>
                <div class="field">
                    <InputFile OnChange="OnImportFileSelected" accept=".xlsx" class="form-control" />
                    @if (_importFile is not null)
                    {
                        <div class="text-muted" style="font-size:11px;margin-top:6px;">Archivo seleccionado: @_importFile.Name (@(_importFile.Size) bytes)</div>
                    }
                </div>
                @if (_importResult is not null)
                {
                    <div style="margin-top:10px;">
                        <div><strong>@_importResult.RowsImported filas importadas</strong>, @_importResult.RowsFailed fallidas</div>
                        @if (_importResult.Errors.Count > 0)
                        {
                            <ul class="dc-errors">
                                @foreach (var e in _importResult.Errors)
                                {
                                    <li>@e</li>
                                }
                            </ul>
                        }
                    </div>
                }
                @if (_importError is not null)
                {
                    <div class="text-danger small">@_importError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="btn btn-outline-secondary" @onclick="CloseImportModal">Cerrar</button>
                <button class="btn btn-primary" @onclick="ImportAsync" disabled="@(_busy || _importFile is null)">@(_busy ? "Importando..." : "Importar")</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private Guid _actor;
    private List<DataContainerDto> _containers = new();
    private DataContainerDetailDto? _selected;
    private List<DataContainerRowDto> _rows = new();
    private string _search = "";

    // Modal: modelo
    private bool _containerModalOpen;
    private Guid? _containerEditId;
    private string _fcName = "";
    private string _fcDescription = "";
    private List<ColumnDraft> _fcColumns = new();
    private string? _containerError;

    // Modal: fila
    private bool _rowModalOpen;
    private Guid? _rowEditId;
    private Dictionary<Guid, string?> _fRowValues = new();
    private string? _rowError;

    // Modal: import
    private bool _importModalOpen;
    private IBrowserFile? _importFile;
    private string? _importError;
    private DataImportResult? _importResult;

    private sealed class ColumnDraft
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public DataColumnType Type { get; set; } = DataColumnType.Text;
        public int SortOrder { get; set; }
        public bool IsRequired { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _actor = Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
        await ReloadListAsync();
    }

    private async Task ReloadListAsync()
    {
        _loading = true;
        _containers = (await DataSvc.ListAsync()).ToList();
        _loading = false;
    }

    private async Task OpenContainerAsync(Guid id)
    {
        _selected = await DataSvc.GetAsync(id);
        if (_selected is null) { return; }
        _search = "";
        await ReloadRowsAsync();
    }

    private async Task ReloadRowsAsync()
    {
        if (_selected is null) { _rows = new(); return; }
        _rows = (await DataSvc.ListRowsAsync(_selected.Id, string.IsNullOrWhiteSpace(_search) ? null : _search)).ToList();
    }

    private async Task BackToList()
    {
        _selected = null;
        _rows = new();
        _search = "";
        await ReloadListAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs _)
    {
        await ReloadRowsAsync();
    }

    // ---------- Container modal ----------
    private void OpenCreateContainer()
    {
        _containerEditId = null;
        _fcName = "";
        _fcDescription = "";
        _fcColumns = new List<ColumnDraft>
        {
            new ColumnDraft { Name = "", Type = DataColumnType.Text, SortOrder = 0 }
        };
        _containerError = null;
        _containerModalOpen = true;
    }

    private void OpenEditContainer()
    {
        if (_selected is null) { return; }
        _containerEditId = _selected.Id;
        _fcName = _selected.Name;
        _fcDescription = _selected.Description ?? "";
        _fcColumns = _selected.Columns
            .OrderBy(c => c.SortOrder)
            .Select(c => new ColumnDraft
            {
                Id = c.Id,
                Name = c.Name,
                Description = c.Description,
                Type = c.Type,
                SortOrder = c.SortOrder,
                IsRequired = c.IsRequired
            }).ToList();
        if (_fcColumns.Count == 0)
        {
            _fcColumns.Add(new ColumnDraft { Name = "", Type = DataColumnType.Text, SortOrder = 0 });
        }
        _containerError = null;
        _containerModalOpen = true;
    }

    private void CloseContainerModal() => _containerModalOpen = false;

    private void AddColumn()
    {
        _fcColumns.Add(new ColumnDraft { Name = "", Type = DataColumnType.Text, SortOrder = _fcColumns.Count });
    }

    private void RemoveColumn(int idx)
    {
        if (idx >= 0 && idx < _fcColumns.Count) { _fcColumns.RemoveAt(idx); }
    }

    private async Task SaveContainerAsync()
    {
        _containerError = null;
        if (string.IsNullOrWhiteSpace(_fcName))
        {
            _containerError = "El nombre es obligatorio.";
            return;
        }
        var cols = _fcColumns
            .Where(c => !string.IsNullOrWhiteSpace(c.Name))
            .Select((c, i) => new SaveDataColumnInput(c.Id, c.Name.Trim(), c.Description, c.Type, i, c.IsRequired))
            .ToList();
        if (cols.Count == 0)
        {
            _containerError = "Debes definir al menos una columna.";
            return;
        }
        _busy = true;
        try
        {
            var req = new SaveDataContainerRequest(
                _containerEditId,
                _fcName.Trim(),
                string.IsNullOrWhiteSpace(_fcDescription) ? null : _fcDescription.Trim(),
                cols);
            var saved = await DataSvc.SaveAsync(req, _actor);
            if (saved is null)
            {
                _containerError = "No se pudo guardar el modelo. Verifica el nombre y las columnas.";
                return;
            }
            _containerModalOpen = false;
            if (_selected is not null)
            {
                _selected = saved;
                await ReloadRowsAsync();
            }
            else
            {
                await ReloadListAsync();
            }
        }
        catch (InvalidOperationException ex)
        {
            _containerError = ex.Message;
        }
        catch (Exception ex)
        {
            _containerError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteContainerAsync()
    {
        if (_selected is null) { return; }
        var confirm = await JS.InvokeAsync<bool>("confirm", $"Eliminar el modelo '{_selected.Name}' y todos sus datos?");
        if (!confirm) { return; }
        _busy = true;
        try
        {
            await DataSvc.DeleteAsync(_selected.Id, _actor);
            _selected = null;
            _rows = new();
            await ReloadListAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // ---------- Row modal ----------
    private void OpenNewRow()
    {
        if (_selected is null) { return; }
        _rowEditId = null;
        _fRowValues = _selected.Columns.ToDictionary(c => c.Id, _ => (string?)null);
        _rowError = null;
        _rowModalOpen = true;
    }

    private void OpenEditRow(DataContainerRowDto row)
    {
        if (_selected is null) { return; }
        _rowEditId = row.Id;
        _fRowValues = _selected.Columns.ToDictionary(
            c => c.Id,
            c => row.ValuesByColumnId.TryGetValue(c.Id, out var v) ? v : null);
        _rowError = null;
        _rowModalOpen = true;
    }

    private void CloseRowModal() => _rowModalOpen = false;

    private void SetRowValue(Guid columnId, string? value)
    {
        _fRowValues[columnId] = value;
    }

    private async Task SaveRowAsync()
    {
        if (_selected is null) { return; }
        _rowError = null;
        _busy = true;
        try
        {
            // Validate required.
            foreach (var col in _selected.Columns)
            {
                if (col.IsRequired)
                {
                    _fRowValues.TryGetValue(col.Id, out var v);
                    if (string.IsNullOrWhiteSpace(v))
                    {
                        _rowError = $"La columna '{col.Name}' es obligatoria.";
                        return;
                    }
                }
            }
            var req = new SaveDataRowRequest(_selected.Id, _rowEditId, _fRowValues);
            var saved = await DataSvc.SaveRowAsync(req, _actor);
            if (saved is null)
            {
                _rowError = "No se pudo guardar la fila.";
                return;
            }
            _rowModalOpen = false;
            await ReloadRowsAsync();
        }
        catch (Exception ex)
        {
            _rowError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteRowAsync(Guid rowId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Eliminar esta fila?");
        if (!confirm) { return; }
        _busy = true;
        try
        {
            await DataSvc.DeleteRowAsync(rowId, _actor);
            await ReloadRowsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // ---------- Import modal ----------
    private void OpenImport()
    {
        _importFile = null;
        _importError = null;
        _importResult = null;
        _importModalOpen = true;
    }

    private void CloseImportModal() => _importModalOpen = false;

    private void OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _importFile = e.File;
        _importError = null;
        _importResult = null;
    }

    private async Task ImportAsync()
    {
        if (_selected is null || _importFile is null) { return; }
        _importError = null;
        _importResult = null;
        _busy = true;
        try
        {
            // Limite de 30MB para xlsx.
            await using var stream = _importFile.OpenReadStream(30 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            memory.Position = 0;
            _importResult = await DataSvc.ImportFromExcelAsync(_selected.Id, memory, _actor);
            if (_importResult.RowsImported > 0)
            {
                await ReloadRowsAsync();
                // Refresh container counts.
                _selected = await DataSvc.GetAsync(_selected.Id) ?? _selected;
            }
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ---------- Render helpers ----------
    private static string RenderCell(DataContainerRowDto row, DataContainerColumnDto col)
    {
        if (!row.ValuesByColumnId.TryGetValue(col.Id, out var raw) || raw is null) { return ""; }
        switch (col.Type)
        {
            case DataColumnType.Boolean:
                return string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) ? "Si" : "No";
            default:
                return raw;
        }
    }

    private static string Truncate(string text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) { return ""; }
        text = text.Trim();
        return text.Length <= max ? text : text[..max] + "...";
    }
}

<style>
    .dc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 14px;
    }
    .dc-card {
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 160px;
    }
    .dc-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
    }
    .dc-card-name {
        font-weight: 700;
        font-size: 1.0rem;
        line-height: 1.25;
    }
    .dc-card-desc {
        color: var(--muted-foreground);
        font-size: 0.85rem;
        line-height: 1.45;
        flex: 1;
    }
    .dc-card-meta {
        font-size: 0.78rem;
        color: var(--muted-foreground);
    }
    .dc-card-actions {
        display: flex;
        gap: 6px;
        margin-top: auto;
    }
    .dc-detail-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }
    .dc-detail-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .dc-table {
        margin: 0;
        font-size: 0.88rem;
    }
    .dc-table th {
        white-space: nowrap;
    }
    .dc-cols {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .dc-col-row {
        display: grid;
        grid-template-columns: 1.2fr 1.4fr 0.9fr auto auto;
        gap: 6px;
        align-items: center;
    }
