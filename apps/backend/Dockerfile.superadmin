# CUBOT.redmanager - imagen de produccion de la consola del dueno SaaS (SuperAdmin).
# Patron portado de CUBOT.travels, subido a .NET 10. Comparte base de datos y ApplicationName
# de DataProtection con el Web para validar la cookie compartida.
# Contexto de build esperado: raiz del repo (Railway Root Directory = /).

# --- build ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY apps/backend/ ./
RUN dotnet publish src/CubotRedManager.SuperAdmin/CubotRedManager.SuperAdmin.csproj \
    -c Release -o /app/publish /p:UseAppHost=false

# --- runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./
# Railway inyecta PORT; definir en Railway ASPNETCORE_HTTP_PORTS=${{PORT}}.
# Este valor es solo fallback local.
ENV ASPNETCORE_HTTP_PORTS=8080
ENV TZ=America/Bogota
EXPOSE 8080
# Usuario no-root incluido en la imagen aspnet:10.0.
USER app
ENTRYPOINT ["dotnet", "CubotRedManager.SuperAdmin.dll"]
