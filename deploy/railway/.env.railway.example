# ============================================================================
# CUBOT.redmanager - Variables de entorno para Railway (piloto)
# ============================================================================
# Pegar estas variables en CADA servicio Railway (web y superadmin) con valores
# reales. NO commitear valores reales: este archivo es solo plantilla.
#
# Notas Railway:
# - ${{PORT}} y ${{Postgres.DATABASE_URL}} son referencias que Railway resuelve
#   en runtime. Para usar ${{Postgres.DATABASE_URL}} hay que agregar el addon
#   Postgres como "Reference variable" en el dashboard del servicio.
# - DATABASE_URL llega en formato URI (postgres://user:pass@host:port/db).
#   La app la convierte sola a formato Npgsql al arranque (DependencyInjection.
#   NormalizeConnectionString); no hay que transformarla a mano.
# ============================================================================

# --- Base (ambos servicios) ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=${{PORT}}
TZ=America/Bogota

# --- BD (ambos servicios; Railway inyecta desde el addon Postgres) ---
ConnectionStrings__Default=${{Postgres.DATABASE_URL}}

# --- JWT (ambos servicios; genera con: openssl rand -base64 64) ---
Jwt__SigningKey=<CHANGE-ME>

# --- Bootstrap primer SuperAdmin (solo servicio web; se crea en el primer
#     arranque si la BD no tiene usuarios. Retirar las variables despues.) ---
Bootstrap__AdminEmail=<CHANGE-ME>
Bootstrap__AdminPassword=<CHANGE-ME>

# --- Deployment cross-service (ambos servicios) ---
Deployment__SuperAdminUrl=https://admin.red.cubot.com.co
Deployment__WebUrl=https://red.cubot.com.co

# --- OAuth Meta (servicio web; pendiente hasta activar el conector Meta) ---
Meta__ClientId=<CHANGE-ME>
Meta__ClientSecret=<CHANGE-ME>
Meta__RedirectUri=https://red.cubot.com.co/api/oauth/meta/callback
Meta__WebhookVerifyToken=<CHANGE-ME>

# --- OAuth TikTok (servicio web) ---
TikTok__ClientKey=<CHANGE-ME>
TikTok__ClientSecret=<CHANGE-ME>
TikTok__RedirectUri=https://red.cubot.com.co/api/oauth/tiktok/callback

# --- OAuth Google / YouTube + Google Sign-In (servicio web) ---
Google__ClientId=<CHANGE-ME>
Google__ClientSecret=<CHANGE-ME>
Google__RedirectUri=https://red.cubot.com.co/api/oauth/youtube/callback

# --- YCloud (WhatsApp BSP) ---
# La API key de YCloud se guarda CIFRADA por linea de WhatsApp (columna *Encrypted),
# no en variables globales. Solo el verify secret del webhook global si aplica:
YCloud__WebhookVerifySecret=<CHANGE-ME>

# --- Wompi (cobro SaaS; pendiente hasta activar cobro real) ---
Wompi__Environment=production
Wompi__PublicKey=<CHANGE-ME>
Wompi__PrivateKey=<CHANGE-ME>

# --- Logging ---
Serilog__MinimumLevel=Information
