# Copiar a .env y ajustar. El archivo .env NO se versiona (ver .gitignore).
# Puertos host dedicados para CUBOT.redmanager (evitan choque con otros stacks).

# PostgreSQL
POSTGRES_DB=cubot_redmanager_dev
POSTGRES_USER=cubotrm
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5436

# Redis
REDIS_PASSWORD=cambia_esta_clave_redis
REDIS_PORT=6383

# RabbitMQ
RABBITMQ_DEFAULT_USER=cubotrm
RABBITMQ_DEFAULT_PASS=cambia_esta_clave_rabbit
RABBITMQ_PORT=5675
RABBITMQ_MGMT_PORT=15675

# pgAdmin
PGADMIN_EMAIL=admin@cubotrm.local
PGADMIN_PASSWORD=cambia_esta_clave_pgadmin
PGADMIN_PORT=5052
